<Project>
  <!-- S92.2-K4: paquetes base del estandar unico xUnit v3, inyectados a todo proyecto *.Tests.
       NO declarar xunit.v3 / xunit.runner.visualstudio / Microsoft.NET.Test.Sdk / coverlet.collector
       en los .csproj. Librerias permitidas solo cuando se necesitan: bunit (UI Blazor), Moq (unico
       mock), Microsoft.AspNetCore.Mvc.Testing (HTTP), RichardSzalay.MockHttp, EF segun capa. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
