@implements IDisposable
@implements IAsyncDisposable
@inherits LayoutComponentBase
@using System.Reflection
@inject AuthService Auth
@inject MenuService Menu
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IWebAssemblyHostEnvironment HostEnv
@using PassPlat.Web.Styles
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

<MudThemeProvider Theme="AppTheme.Theme" @ref="_themeProvider" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Class="appbar" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@((e) => DrawerToggle())" aria-label="Abrir o cerrar el menu lateral" aria-expanded="@(_drawerOpen ? "true" : "false")" />
        <span class="appbar-brand">
            <span class="appbar-brand-dot"></span>
            <span class="appbar-brand-text d-none d-sm-inline">AccessPlat</span>
        </span>
        <span class="appbar-brand-divider d-none d-sm-inline"></span>
        <div class="appbar-title-area">
            <MudText Typo="Typo.h6" Class="appbar-title">@_pageTitle</MudText>
            <MudText Typo="Typo.caption" Class="appbar-subtitle d-none d-lg-flex">@_pageSubtitle</MudText>
        </div>
        <MudSpacer />
        @if (Auth.IsAuthenticated)
        {
            <RelojBarra />
            <MudDivider Vertical="true" Class="appbar-divider mx-3 d-none d-md-flex" />
        }
        @if (Auth.IsAuthenticated)
        {
            <div class="d-flex align-center appbar-actions">
                <MudTooltip Text="Buscar (Ctrl+K)">
                    <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" OnClick="@ToggleSearch" Class="appbar-action-icon" aria-label="Buscar" />
                </MudTooltip>
                <MudTooltip Text='@(_isDarkMode ? "Modo claro" : "Modo oscuro")'>
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit" OnClick="@ToggleDarkMode" Class="appbar-action-icon dark-mode-toggle" aria-label="@(_isDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")" />
                </MudTooltip>
                <MudTooltip Text="Pantalla completa">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Inherit" OnClick="@ToggleFullScreen" Class="appbar-action-icon" aria-label="Pantalla completa" />
                </MudTooltip>
                <CampanaNotificaciones Abierto="_notifMenuOpen" OnAlternar="ToggleNotifMenu" OnVerTodas="@(() => { CloseAllMenus(); GoToNotificaciones(); })" />
                <MudDivider Vertical="true" Class="appbar-divider mx-3" />
                <div class="appbar-menu">
                    <div class="d-flex align-center appbar-user" @onclick="@ToggleUserMenu" @onclick:stopPropagation="true">
                        <span class="appbar-avatar-wrap">
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="appbar-avatar">
                                <MudText Typo="Typo.button">@_userInitials</MudText>
                            </MudAvatar>
                            <span class="appbar-online-dot"></span>
                        </span>
                        <MudText Typo="Typo.body2" Class="ml-2 mr-1 d-none d-sm-flex appbar-username">@Auth.NomUsuario</MudText>
                        @* S96 · D4 — el clic del selector no abre el menú de usuario *@
                        <span class="d-flex align-center" @onclick:stopPropagation="true"><TenantSwitcher /></span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="appbar-chevron d-none d-sm-flex" />
                    </div>
                    @if (_userMenuOpen)
                    {
                        <div class="appbar-menu-dropdown">
                            <div class="pa-3 pb-2">
                                <div class="d-flex align-center mb-2">
                                    <MudAvatar Size="Size.Medium" Color="Color.Primary" Class="mr-3">
                                        <MudText Typo="Typo.body1">@_userInitials</MudText>
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Auth.NomUsuario</MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary">
                                            @Ambito
                                        </MudText>
                                    </div>
                                </div>
                            </div>
                            <MudDivider Class="my-1" />
                            <button type="button" class="appbar-menu-item" @onclick="@(() => { CloseAllMenus(); GoToMiPerfil(); })">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" />
                                <MudText Typo="Typo.body2">Mi Perfil</MudText>
                            </button>
                            <MudDivider Class="my-1" />
                            <button type="button" class="appbar-menu-item appbar-menu-logout" @onclick="@(async () => { CloseAllMenus(); await Logout(); })">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-2" Color="Color.Error" />
                                <MudText Typo="Typo.body2" Color="Color.Error">Cerrar sesión</MudText>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </MudAppBar>

    @if (_searchOpen)
    {
        <div class="search-overlay" @onclick="@CloseSearch">
            <div class="search-overlay-container" @onclick:stopPropagation="true">
                <div class="search-overlay-input-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-overlay-icon" />
                    <input @ref="_searchInput" type="text" class="search-overlay-input" placeholder="Buscar en AccessPlat..." @bind="_searchQuery" @oninput="@OnSearchInput" @onkeydown="@HandleSearchKeydown" />
                    <MudTooltip Text="Cerrar (Esc)">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="@CloseSearch" Class="search-overlay-close" aria-label="Cerrar la busqueda" />
                    </MudTooltip>
                </div>
                @if (_searchResults.Count > 0)
                {
                    <div class="search-results">
                        @for (var i = 0; i < _searchResults.Count; i++)
                        {
                            var result = _searchResults[i];
                            var idx = i;
                            <div class="search-result-item @(idx == _searchSelectedIndex ? "selected" : "")"
                                 @onclick="@(() => NavigateToSearchResult(result))"
                                 @onmouseenter="@(() => _searchSelectedIndex = idx)">
                                <MudIcon Icon="@result.Icon" Size="Size.Small" Class="mr-3" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@result.Title</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary">@result.Subtitle</MudText>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="ml-auto" />
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_searchQuery) && _searchQuery.Length >= 2)
                {
                    <div class="search-results">
                        <div class="search-result-empty">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.body2" Class="text-secondary">Sin resultados para "@_searchQuery"</MudText>
                        </div>
                    </div>
                }
                <div class="search-overlay-hints d-none d-md-flex">
                    <span class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> Navegar</span>
                    <span class="search-hint"><kbd>↵</kbd> Abrir</span>
                    <span class="search-hint"><kbd>Esc</kbd> Cerrar</span>
                </div>
            </div>
        </div>
    }

    <MudDrawer @bind-Open="_drawerOpen" Variant="@DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <div class="drawer-user-card">
            <MudAvatar Size="Size.Medium" Color="Color.Primary" Class="drawer-user-avatar">
                <MudText Typo="Typo.body2">@_userInitials</MudText>
            </MudAvatar>
            <div class="drawer-user-info">
                <MudText Typo="Typo.subtitle2" Class="drawer-user-name">@Auth.NomUsuario</MudText>
                <MudText Typo="Typo.caption" Class="drawer-user-role">@Ambito</MudText>
            </div>
        </div>
        <MudDivider Class="drawer-divider" />
        <NavMenu />
        <div class="drawer-footer">
            <MudDivider Class="drawer-divider" />
            <MudText Typo="Typo.caption" Class="drawer-footer-text">AccessPlat v@(_version)</MudText>
        </div>
    </MudDrawer>

    <MudMainContent Class="px-6 pb-4" Style="min-height: calc(100vh - 64px); display: flex; flex-direction: column; padding-top: 64px !important;">
        <Microsoft.AspNetCore.Components.Web.ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @* S58.2 · D1 — sin clave de recreacion: recrear la pagina duplicaba sus
                   llamadas a la API. El reinicio del ErrorBoundary se hace con Recover(). *@
                <div class="page-content" style="flex: 1;">
                    @Body
                </div>
            </ChildContent>
            <ErrorContent>
                <div class="error-boundary-wrapper">
                    <MudPaper Class="error-boundary-card pa-6" Elevation="0" Outlined="true">
                        <div class="d-flex flex-column align-center text-center">
                            <MudAvatar Size="Size.Large" Color="Color.Error" Variant="Variant.Filled" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
                            </MudAvatar>
                            <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Algo salió mal</MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary mb-4" Style="max-width:420px;">
                                Ha ocurrido un error inesperado. Puede intentar recargar la página o volver al dashboard.
                            </MudText>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                    OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))"
                                    StartIcon="@Icons.Material.Filled.Refresh">
                                    Recargar
                                </MudButton>
                                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.Home">
                                    Dashboard
                                </MudButton>
                            </div>
                        </div>
                    </MudPaper>
                </div>
            </ErrorContent>
        </Microsoft.AspNetCore.Components.Web.ErrorBoundary>
        <div class="footer-area d-flex align-center justify-space-between mt-4 pt-3">
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.caption" Class="footer-copy">
                    &copy; @DateTime.Now.Year Plataforma de Acceso
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="footer-env">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-1" />
                    @HostEnv.Environment
                </MudChip>
            </div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.caption" Class="footer-version">
                    v@(_version)
                </MudText>
            </div>
        </div>
    </MudMainContent>

    @if (_userMenuOpen || _notifMenuOpen)
    {
        <div class="dropdown-backdrop" @onclick="@CloseAllMenus"></div>
    }
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    // S58.2 · D1 — referencia al ErrorBoundary para reiniciarlo al navegar (sin clave).
    private Microsoft.AspNetCore.Components.Web.ErrorBoundary? _errorBoundary;
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _seguirSistema;
    private string _pageTitle = "";
    private string _pageSubtitle = "";
    private string _pageIcon = Icons.Material.Filled.Circle;
    private string _userInitials = "";
    private bool _searchOpen;
    private string _searchQuery = "";
    private List<SearchResult> _searchResults = [];
    private int _searchSelectedIndex = -1;
    private ElementReference _searchInput;
    private bool _focusPending;
    private bool _userMenuOpen;
    private bool _notifMenuOpen;

    // S84 · D3 — ambito de la sesion (el token no trae roles); lo usan el cajon y el menu de usuario.
    private string Ambito => Auth.EsPlatform ? "Plataforma" : Auth.NombreTenant ?? "Sin tenant";

    // S84 · D4 — la version sale del ensamblado de la Web, no de un literal.
    private static readonly string _version = LeerVersion();

    private static string LeerVersion()
    {
        var ensamblado = typeof(MainLayout).Assembly;
        var informativa = ensamblado.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        return informativa is not null
            ? informativa.Split('+')[0]
            : ensamblado.GetName().Version?.ToString(3) ?? "0.0.0";
    }

    // S83 · D8 / S89 · D3 — modulo JS perezoso del layout (Ctrl+K, ancho, pantalla completa); se importa una sola vez.
    private Task<IJSObjectReference?>? _layoutJs;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // S58 · D4 — el titulo y la ruta se fijan ANTES del primer render: si el titulo
        // llegara despues, la clave de la pagina cambiaria y Blazor recrearia el
        // componente de la pagina, con lo que sus llamadas se duplicaban.
        UpdatePageInfo(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;

        // S83 · D7 — el titulo y el buscador salen del menu de la app; la carga no bloquea el primer render.
        Menu.Cambio += OnMenuChanged;
        _ = Menu.AsegurarCargaAsync();

        // S89 · D3 — localStorage por interop directo, sin eval (como NavMenu, S88).
        try
        {
            var guardado = await JS.InvokeAsync<string?>("localStorage.getItem", "dark_mode");
            _isDarkMode = guardado == "true";
            // S118 · D6 (P54) — sin preferencia guardada, el render siguiente toma el modo del sistema operativo.
            _seguirSistema = guardado is null;
        }
        catch { _isDarkMode = false; }

        UpdateUserInitials();
    }

    // S89 · D2 — sin async void ni espera fija: el manejador lanza una tarea en el dispatcher.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = AlNavegarAsync(e.Location);

    private Task AlNavegarAsync(string ubicacion) => InvokeAsync(async () =>
    {
        UpdatePageInfo(ubicacion);

        // S58.2 · D1 — la clave de recreacion que reiniciaba la pagina tambien reiniciaba
        // el ErrorBoundary. Sin recrear la pagina, el reinicio se pide explicitamente.
        _errorBoundary?.Recover();

        // En celular, navegar cierra el menu lateral.
        if (_drawerOpen && await EsMovilAsync())
            _drawerOpen = false;

        StateHasChanged();
    });

    // S83 · D7 — titulo, subtitulo e icono desde el catalogo de la app; nunca la ruta cruda (S58 · D3).
    private void UpdatePageInfo(string uri) =>
        (_pageTitle, _pageSubtitle, _pageIcon) = Menu.Catalogo.TituloDe(uri);

    private void OnMenuChanged() => InvokeAsync(() =>
    {
        UpdatePageInfo(Nav.Uri);
        StateHasChanged();
    });

    private void UpdateUserInitials()
    {
        _userInitials = !string.IsNullOrEmpty(Auth.NomUsuario)
            ? (Auth.NomUsuario.Length >= 2
                ? Auth.NomUsuario[..2].ToUpper()
                : Auth.NomUsuario.ToUpper())
            : "?";
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "dark_mode", _isDarkMode ? "true" : "false"); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RegistrarAtajoBuscarAsync();

        // S118 · D6 — prefers-color-scheme solo si el usuario nunca eligió con el botón (que guarda dark_mode).
        // No va atado a firstRender: la lectura de localStorage de OnInitializedAsync puede terminar después del primer render.
        if (_seguirSistema)
        {
            _seguirSistema = false;
            try
            {
                var oscuro = await _themeProvider.GetSystemDarkModeAsync();
                if (oscuro != _isDarkMode) { _isDarkMode = oscuro; StateHasChanged(); }
            }
            catch { /* sin JS del tema: queda el modo claro */ }
        }

        if (_focusPending)
        {
            _focusPending = false;
            await _searchInput.FocusAsync();
        }

        // S55.1 · K4 (D4) — en el primer render el menu lateral arranca cerrado en celular.
        if (firstRender && await EsMovilAsync() && _drawerOpen)
        {
            _drawerOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// S55.1 · K4 (D4) — una sola comprobacion de ancho para el menu lateral.
    /// S89 · D3 — la hace el modulo del layout, sin eval.
    /// </summary>
    private async Task<bool> EsMovilAsync()
    {
        var modulo = await ModuloLayoutAsync();
        if (modulo is null) return false;
        try { return await modulo.InvokeAsync<bool>("esMovil"); }
        catch (JSException) { return false; }
    }

    private Task<IJSObjectReference?> ModuloLayoutAsync() => _layoutJs ??= ImportarModuloLayoutAsync();

    private async Task<IJSObjectReference?> ImportarModuloLayoutAsync()
    {
        try { return await JS.InvokeAsync<IJSObjectReference?>("import", "./js/layout.js"); }
        catch (JSException) { return null; }
    }

    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        if (_searchOpen)
        {
            _searchQuery = "";
            _searchResults = [];
            _searchSelectedIndex = -1;
            _focusPending = true;
        }
    }

    /// <summary>S83 · D8 — Ctrl+K (o Cmd+K) fuera del editor Monaco abre el buscador con el foco puesto.</summary>
    [JSInvokable]
    public void AbrirBuscador()
    {
        if (_searchOpen) return;
        ToggleSearch();
        StateHasChanged();
    }

    private async Task RegistrarAtajoBuscarAsync()
    {
        var modulo = await ModuloLayoutAsync();
        if (modulo is null) return;
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await modulo.InvokeVoidAsync("registrarAtajoBuscar", _dotNetRef);
        }
        catch (JSException) { }
    }

    private void CloseSearch()
    {
        _searchOpen = false;
        _searchQuery = "";
        _searchResults = [];
        _searchSelectedIndex = -1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        _searchSelectedIndex = -1;
        // S83 · D4 — solo lo que el usuario puede ver: el catalogo ya viene filtrado por el servidor.
        _searchResults = Menu.Catalogo.Buscar(_searchQuery)
            .Select(m => new SearchResult(m.Ruta!, m.Nombre, m.Descripcion ?? "", CBP.Blazor.Mud.IconosMud.PorNombre(m.Icono)))
            .ToList();
    }

    private void HandleSearchKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseSearch();
        else if (e.Key == "ArrowDown")
        {
            if (_searchResults.Count > 0)
                _searchSelectedIndex = Math.Min(_searchSelectedIndex + 1, _searchResults.Count - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _searchSelectedIndex = Math.Max(_searchSelectedIndex - 1, -1);
        }
        else if (e.Key == "Enter")
        {
            if (_searchSelectedIndex >= 0 && _searchSelectedIndex < _searchResults.Count)
                NavigateToSearchResult(_searchResults[_searchSelectedIndex]);
            else if (_searchResults.Count > 0)
                NavigateToSearchResult(_searchResults[0]);
        }
    }

    private void NavigateToSearchResult(SearchResult result)
    {
        Nav.NavigateTo(result.Route);
        CloseSearch();
    }

    private sealed record SearchResult(string Route, string Title, string Subtitle, string Icon);

    private async Task ToggleFullScreen()
    {
        var modulo = await ModuloLayoutAsync();
        if (modulo is null) return;
        try { await modulo.InvokeVoidAsync("alternarPantallaCompleta"); }
        catch (JSException) { }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;
    private void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
        if (_userMenuOpen) _notifMenuOpen = false;
    }
    private void ToggleNotifMenu()
    {
        _notifMenuOpen = !_notifMenuOpen;
        if (_notifMenuOpen) _userMenuOpen = false;
    }
    private void CloseAllMenus()
    {
        _userMenuOpen = false;
        _notifMenuOpen = false;
    }
    private void GoToMiPerfil()
    {
        if (Auth.IdUsuario.HasValue)
            Nav.NavigateTo($"/usuario/{Auth.IdUsuario.Value}");
    }
    private void GoToNotificaciones() => Nav.NavigateTo("/notificaciones");
    private async Task Logout() => await Auth.LogoutAsync();

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Menu.Cambio -= OnMenuChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_layoutJs is not null && await _layoutJs is { } modulo)
        {
            try
            {
                await modulo.InvokeVoidAsync("quitarAtajoBuscar");
                await modulo.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            _layoutJs = null;
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
