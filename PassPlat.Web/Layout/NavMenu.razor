@using System.Text.Json
@using CBP.Blazor.Mud
@implements IDisposable
@inject MenuService Menu
@inject NavigationManager Nav
@inject IJSRuntime JS

@* S83 · D6 — el menu sale de los modulos de la app (api/modulos/menu), ya filtrados por permisos en el servidor. *@
<MudNavMenu>
    @if (Menu.Fallo)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="ma-2">
            No se pudo cargar el menú
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@Menu.RecargarAsync">Reintentar</MudButton>
        </MudAlert>
    }
    @foreach (var (raiz, enlaces) in Menu.Catalogo.Grupos)
    {
        if (enlaces.Count == 0)
        {
            <MudNavLink Href="@raiz.Ruta" Match="@(raiz.Ruta == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@IconosMud.PorNombre(raiz.Icono)">@raiz.Nombre</MudNavLink>
        }
        else
        {
            <MudNavGroup Title="@raiz.Nombre" Icon="@IconosMud.PorNombre(raiz.Icono)" Expanded="@EstaAbierto(raiz.Codigo)" ExpandedChanged="@((bool abierto) => AlternarGrupoAsync(raiz.Codigo, abierto))">
                @foreach (var enlace in enlaces)
                {
                    <MudNavLink Href="@enlace.Ruta" Icon="@IconosMud.PorNombre(enlace.Icono)">@enlace.Nombre</MudNavLink>
                }
            </MudNavGroup>
        }
    }
</MudNavMenu>

@code {
    // S88 · D2 — grupos abiertos por Codigo de la raíz. Lo que el usuario abre o cierra se guarda en localStorage
    // (sin eval) y el grupo de la página activa se abre solo al cargar y al navegar.
    private const string ClaveGrupos = "menu_grupos";
    private Dictionary<string, bool> _grupos = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Menu.Cambio += AlCambiarMenu;
        Nav.LocationChanged += AlNavegar;
        await LeerGruposAsync();
        await Menu.AsegurarCargaAsync();
        AbrirGrupoActivo();
    }

    private bool EstaAbierto(string codigo) => _grupos.GetValueOrDefault(codigo);

    private async Task AlternarGrupoAsync(string codigo, bool abierto)
    {
        _grupos[codigo] = abierto;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ClaveGrupos, JsonSerializer.Serialize(_grupos));
        }
        catch (JSException)
        {
            // Sin almacenamiento, el estado vale mientras la app siga abierta.
        }
    }

    private async Task LeerGruposAsync()
    {
        try
        {
            var guardado = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveGrupos);
            if (string.IsNullOrWhiteSpace(guardado)) return;
            var leidos = JsonSerializer.Deserialize<Dictionary<string, bool>>(guardado);
            if (leidos is not null) _grupos = new Dictionary<string, bool>(leidos, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            // Valor ilegible o sin almacenamiento: se empieza con los grupos cerrados.
        }
    }

    /// <summary>Abre el grupo de la raíz a la que pertenece la página actual (S86 · <c>RastroDe</c>).</summary>
    private void AbrirGrupoActivo()
    {
        var rastro = Menu.Catalogo.RastroDe(Nav.ToBaseRelativePath(Nav.Uri));
        if (rastro.Count > 0) _grupos[rastro[0].Codigo] = true;
    }

    private void AlCambiarMenu() => InvokeAsync(() =>
    {
        AbrirGrupoActivo();
        StateHasChanged();
    });

    private void AlNavegar(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        AbrirGrupoActivo();
        StateHasChanged();
    });

    public void Dispose()
    {
        Menu.Cambio -= AlCambiarMenu;
        Nav.LocationChanged -= AlNavegar;
    }
}
