@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* S54 · D1 — Dialogo de asignacion de acceso.
   - Tenant de solo lectura: el servidor reemplaza el tenant del cuerpo por el de la sesion (H4).
   - Roles: solo activos, globales o del tenant de la sesion (H6).
   - "Asignar" deshabilitado hasta tener usuario, app y rol elegidos de la lista (H3).
   - Aviso de reemplazo cuando el usuario ya tiene acceso a esa app (H5) + confirmacion.
   - Errores con el mensaje del servidor (PostWithErrorAsync, H7).
   S54.1 · D5/D6/D7 — aviso exacto, español correcto y validacion visible.
   S73 · D3 — patrón único de editor (TituloDialogo, dialogo-campos, BotonGuardarDialogo). *@

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Link" Texto="Asignar Acceso" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <div class="dialogo-campos">
            <SelectorCatalogo T="UsuarioDto"
                Items="_usuarios"
                SearchTextSelector="@(u => $"{u.NomUsuario} {u.Nombre} {u.Apellido} {u.Email}")"
                ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
                @bind-Value="_usuarioSelected"
                @bind-Value:after="@OnUsuarioChangedAsync"
                Label="Usuario" Variant="Variant.Outlined"
                Required="true" RequiredError="El usuario es requerido" />

            <MudTextField Value="@_tenantSesionTexto" Label="Tenant" Variant="Variant.Outlined"
                          ReadOnly="true" Disabled="true"
                          HelperText="El acceso se crea en el tenant de tu sesión" />

            <SelectorCatalogo T="AppDto"
                Items="_apps"
                SearchTextSelector="@(a => $"{a.Nombre} {a.Codigo}")"
                ToStringFunc="@(a => a is null ? "" : $"{a.Nombre} ({a.Codigo})")"
                @bind-Value="_appSelected"
                @bind-Value:after="@OnAppChanged"
                Label="App" Variant="Variant.Outlined"
                Required="true" RequiredError="La app es requerida" />

            <SelectorCatalogo T="RolDto"
                Items="_rolesPermitidos"
                SearchTextSelector="@(r => $"{r.Nombre} {r.Codigo}")"
                ToStringFunc="@(r => r is null ? "" : $"{r.Nombre} ({r.Codigo})")"
                @bind-Value="_rolSelected"
                @bind-Value:after="@OnRolChanged"
                Label="Rol" Variant="Variant.Outlined"
                Required="true" RequiredError="El rol es requerido"
                HelperText="@_ayudaRoles" />

            @if (!string.IsNullOrWhiteSpace(_textoReemplazo))
            {
                <MudAlert Severity="@_severidadReemplazo" Dense="true" data-testid="acceso-reemplazo">@_textoReemplazo</MudAlert>
            }

            <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="acceso-aviso-correo">
                PassPlat notificará al usuario por correo cuando se asigne el rol.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Asignar" Guardando="@_saving" Deshabilitado="@(!_puedeAsignar || _sinCambios)" OnClick="@Save"
                             data-testid="acceso-asignar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public int? UsuarioIdPreseleccionado { get; set; }
    [Parameter] public int? AppIdPreseleccionado { get; set; }

    private List<UsuarioDto> _usuarios = [];
    private List<TenantDto> _tenants = [];
    private List<AppDto> _apps = [];
    private List<RolDto> _rolesTodos = [];
    private IReadOnlyList<RolDto> _rolesPermitidos = [];
    private List<AccesoDto> _accesosUsuario = [];

    private UsuarioDto? _usuarioSelected;
    private AppDto? _appSelected;
    private RolDto? _rolSelected;
    private TenantDto? _tenantSesion;
    private string? _textoReemplazo;
    private bool _saving;

    private int _idTenantSesion => Auth.IdTenant ?? 0;
    private string _tenantSesionTexto => _tenantSesion is null ? "(sin tenant en la sesión)" : $"{_tenantSesion.Nombre} ({_tenantSesion.Codigo})";
    private string _ayudaRoles => $"Solo roles activos del tenant de tu sesión o globales ({_rolesPermitidos.Count} disponibles)";
    private bool _puedeAsignar => ReglasAsignacionAcceso.PuedeAsignar(_usuarioSelected, _appSelected, _rolSelected);

    /// <summary>D5 — el acceso resultante seria identico al que ya existe: no hay nada que guardar.</summary>
    private bool _sinCambios => _accesoExistente is not null
        && ReglasAsignacionAcceso.EsMismoAcceso(_accesoExistente, _rolSelected, _idTenantSesion);

    private Severity _severidadReemplazo => _sinCambios ? Severity.Info : Severity.Warning;

    private AccesoDto? _accesoExistente;

    protected override async Task OnInitializedAsync()
    {
        var tUsuarios = Api.GetAsync<List<UsuarioDto>>("api/usuarios");
        // S113 · D4 — sin TENANTS_VER/APPS_VER: el tenant de la sesión y las apps de sus Accesos
        var tTenants = TenantsObjetivo.CargarAsync(Api, Auth);
        var tApps = AppsObjetivo.CatalogoOAccesosAsync(Api, Auth);
        var tRoles = Api.GetAsync<List<RolDto>>("api/roles");

        await Task.WhenAll(tUsuarios, tTenants, tApps, tRoles);

        _usuarios = tUsuarios.Result ?? [];
        _tenants = tTenants.Result ?? [];
        _apps = tApps.Result ?? [];
        _rolesTodos = tRoles.Result ?? [];
        _rolesPermitidos = ReglasAsignacionAcceso.RolesPermitidos(_rolesTodos, _idTenantSesion);
        _tenantSesion = _tenants.FirstOrDefault(t => t.Id == _idTenantSesion);

        if (UsuarioIdPreseleccionado.HasValue)
            _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == UsuarioIdPreseleccionado.Value);
        if (AppIdPreseleccionado.HasValue)
            _appSelected = _apps.FirstOrDefault(a => a.Id == AppIdPreseleccionado.Value);

        if (_usuarioSelected is not null)
            await CargarAccesosUsuarioAsync();
    }

    private async Task OnUsuarioChangedAsync()
    {
        await CargarAccesosUsuarioAsync();
    }

    private async Task CargarAccesosUsuarioAsync()
    {
        _accesosUsuario = [];
        if (_usuarioSelected is not null)
            _accesosUsuario = await Api.GetAsync<List<AccesoDto>>($"api/accesos/usuario/{_usuarioSelected.Id}") ?? [];
        RecalcularReemplazo();
        // La carga es asincrona: sin esto el aviso de reemplazo no se redibuja.
        await InvokeAsync(StateHasChanged);
    }

    private void OnAppChanged()
    {
        RecalcularReemplazo();
    }

    private void OnRolChanged()
    {
        RecalcularReemplazo();
    }

    private void RecalcularReemplazo()
    {
        _accesoExistente = _appSelected is null ? null : ReglasAsignacionAcceso.BuscarAccesoExistente(_accesosUsuario, _appSelected.Id);
        _textoReemplazo = ReglasAsignacionAcceso.TextoReemplazo(_accesoExistente, _rolSelected, _idTenantSesion, _tenantSesion?.Nombre);
    }

    private async Task Save()
    {
        // S115 — los errores del servidor se muestran en el AlertaErrorDialogo; las validaciones locales, en el Snackbar
        if (!_puedeAsignar)
        {
            Snackbar.Add("Elige usuario, app y rol de las listas antes de asignar.", Severity.Warning);
            return;
        }

        if (_accesoExistente is not null)
        {
            var confirmacion = await DialogService.ShowAsync<ConfirmDialog>("", new DialogParameters
            {
                ["Title"] = "Confirmar reemplazo",
                ["Message"] = _textoReemplazo ?? "El acceso será reemplazado.",
                ["ConfirmText"] = "Sí, reemplazar",
                ["CancelText"] = "Cancelar",
                ["ConfirmColor"] = Color.Warning
            });
            var resultado = await confirmacion.Result;
            if (resultado is null || resultado.Canceled) return;
        }

        _saving = true;
        try
        {
            var (resultado, error) = await Api.PostWithErrorAsync<AccesoDto>("api/accesos/asignar", new
            {
                idUsuario = _usuarioSelected!.Id,
                idTenant = _idTenantSesion,
                idApp = _appSelected!.Id,
                idRol = _rolSelected!.Id
            });

            if (resultado is not null)
            {
                Snackbar.Add("Acceso asignado", Severity.Success);
                MudDialog.Close(DialogResult.Ok(_usuarioSelected!.Id));
            }
            else
            {
                _errorServidor = error ?? "Error al asignar acceso";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
