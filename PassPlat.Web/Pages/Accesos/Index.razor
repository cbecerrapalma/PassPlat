@page "/accesos"
@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("ACCESOS_VER"))
{
    <SinPermiso PermisoRequerido="ACCESOS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Accesos</h1>
                <p class="page-subtitle">Administra los accesos efectivos asignados a los usuarios.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AbrirCrearAcceso())" StartIcon="@Icons.Material.Filled.Add">
                    Asignar Acceso
                </MudButton>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_items.Count.ToString()" Label="Total Accesos" Icon="@Icons.Material.Filled.Assignment" ColorClass="primary" />
        <IamKpiCard Valor="@_items.Count(a => a.Activo).ToString()" Label="Activos" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_items.Select(a => a.IdRol).Distinct().Count().ToString()" Label="Roles Asignados" Icon="@Icons.Material.Filled.Security" ColorClass="warning" />
        <IamKpiCard Valor="@_items.Select(a => a.AppNombre).Distinct().Count().ToString()" Label="Apps Integradas" Icon="@Icons.Material.Filled.Apps" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowCreate="false"
                OnRefresh="@RefrescarTodo"
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged">
                <Filtros>
                    <MudSelect T="int" Value="_idUsuario" ValueChanged="@OnUsuarioFiltroChanged"
                               Label="Usuario" Variant="Variant.Outlined" Dense="true" Class="lista-filtro"
                               data-testid="accesos-filtro-usuario">
                        @foreach (var u in _usuarios)
                        {
                            <MudSelectItem Value="@u.Id">@u.NomUsuario (@u.Nombre @u.Apellido)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="_appFiltro" ValueChanged="@OnAppFiltroChanged" Label="App"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        @foreach (var app in _appsFiltro)
                        {
                            <MudSelectItem Value="@app">@app</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="_rolFiltro" ValueChanged="@OnRolFiltroChanged" Label="Rol"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        @foreach (var rol in _rolesFiltro)
                        {
                            <MudSelectItem Value="@rol">@rol</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="bool?" Value="_estadoFiltro" ValueChanged="@OnEstadoFiltroChanged" Label="Estado"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Activos</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Inactivos</MudSelectItem>
                    </MudSelect>
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
                <MudTable T="AccesoDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm"
                    RowStyle="cursor: pointer;" OnRowClick="@((TableRowClickEventArgs<AccesoDto> e) => VerDetalle(e.Item))">
                    <ColGroup>
                        <col style="width:80px;" /><col /><col /><col /><col style="width:100px;" /><col style="width:100px;" /><col style="width:90px;" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Usuario</MudTh><MudTh>Tenant</MudTh><MudTh>App</MudTh><MudTh>Rol</MudTh><MudTh>Inicio</MudTh><MudTh>Fin</MudTh><MudTh>Estado</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Usuario"><MudText Typo="Typo.body2" Class="font-weight-medium">@context.UsuarioNombre</MudText></MudTd>
                        <MudTd DataLabel="Tenant"><span class="badge badge-default">@context.TenantNombre</span></MudTd>
                        <MudTd DataLabel="App"><span class="col-name">@context.AppNombre</span></MudTd>
                        <MudTd DataLabel="Rol"><span class="assign-chip sys">@context.RolNombre</span></MudTd>
                        <MudTd DataLabel="Inicio" style="color:var(--text-muted);font-size:11px;">@context.FecAsignacion.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Fin" style="color:var(--text-muted);font-size:11px;">—</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="badge @(context.Activo ? "badge-active" : "badge-inactive")">
                                <span class="badge-dot"></span>@(context.Activo ? "Activo" : "Inactivo")
                            </span>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10,25,50}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="py-6">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                            No hay registros
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    /// <summary>S69.3 · D5 — /accesos?usuario=N preselecciona el filtro (vuelta desde el detalle).</summary>
    [SupplyParameterFromQuery(Name = "usuario")] public int? UsuarioQuery { get; set; }

    private List<AccesoDto> _items = [];

    /// <summary>S55 · U8 / S85 · D4 — buscador, app, rol y estado filtran de verdad la tabla, en memoria.</summary>
    private List<AccesoDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var q = _searchString.Trim();
                filtrados = filtrados.Where(a =>
                    (a.UsuarioNombre ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (a.TenantNombre ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (a.AppNombre ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (a.RolNombre ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(_appFiltro))
                filtrados = filtrados.Where(a => a.AppNombre == _appFiltro).ToList();
            if (!string.IsNullOrWhiteSpace(_rolFiltro))
                filtrados = filtrados.Where(a => a.RolNombre == _rolFiltro).ToList();
            if (_estadoFiltro is bool estado)
                filtrados = filtrados.Where(a => a.Activo == estado).ToList();
            return filtrados;
        }
    }

    private List<string> _appsFiltro
        => _items.Select(a => a.AppNombre ?? string.Empty).Where(n => n.Length > 0).Distinct().OrderBy(n => n).ToList();

    private List<string> _rolesFiltro
        => _items.Select(a => a.RolNombre ?? string.Empty).Where(n => n.Length > 0).Distinct().OrderBy(n => n).ToList();

    private string? _appFiltro;
    private string? _rolFiltro;
    private bool? _estadoFiltro;
    private bool _loading;
    private int _idUsuario;
    private List<UsuarioDto> _usuarios = [];
    private UsuarioDto? _usuarioSelected;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("ACCESOS_VER")) return;
        _usuarios = await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? [];
        _idUsuario = UsuarioQuery is int idQuery && _usuarios.Any(u => u.Id == idQuery)
            ? idQuery
            : Auth.IdUsuario ?? 0;
        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == _idUsuario);
        await RefrescarTodo();
    }

    private void OnSearchChanged(string value)
    {
        _searchString = value;
        StateHasChanged();
    }

    private void OnAppFiltroChanged(string? app)
    {
        _appFiltro = app;
        StateHasChanged();
    }

    private void OnRolFiltroChanged(string? rol)
    {
        _rolFiltro = rol;
        StateHasChanged();
    }

    private void OnEstadoFiltroChanged(bool? estado)
    {
        _estadoFiltro = estado;
        StateHasChanged();
    }

    private async Task RefrescarTodo()
    {
        _loading = true;
        try
        {
            _idUsuario = _usuarioSelected?.Id ?? 0;
            if (_idUsuario <= 0)
            {
                _items = [];
                return;
            }
            var data = await Api.GetAsync<List<AccesoDto>>($"api/accesos/usuario/{_idUsuario}");
            _items = data ?? [];
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnUsuarioFiltroChanged(int idUsuario)
    {
        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == idUsuario);
        await RefrescarTodo();
    }

    private void VerDetalle(AccesoDto? acceso)
    {
        if (acceso is null) return;
        Navigation.NavigateTo($"/acceso/{acceso.IdUsuario}/{acceso.Id}");
    }

    private async Task AbrirCrearAcceso(int? usuarioId = null, int? appId = null)
    {
        var parametros = new DialogParameters<AccesoDialog>
        {
            { x => x.UsuarioIdPreseleccionado, usuarioId },
            { x => x.AppIdPreseleccionado, appId }
        };
        var dialog = await Dialog.ShowAsync<AccesoDialog>("Asignar Acceso", parametros, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;

        // Tras asignar, la lista muestra al usuario asignado (H8).
        if (result.Data is int idUsuarioAsignado)
            _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == idUsuarioAsignado) ?? _usuarioSelected;
        await RefrescarTodo();
    }
}
