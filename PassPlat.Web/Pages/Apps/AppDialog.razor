@inject ApiClient Api
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(IsEdit ? "Editar App" : "Nueva App")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Disabled="@IsEdit" Required="true"
                          RequiredError="El código es requerido" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" Required="true"
                          RequiredError="El nombre es requerido" />
            <MudTextField @bind-Value="_urlBase" Label="URL Base" Variant="Variant.Outlined" />
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public AppDto? App { get; set; }

    private string _codigo = "";
    private string _nombre = "";
    private string _urlBase = "";
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        if (IsEdit && App is not null)
        {
            _codigo = App.Codigo;
            _nombre = App.Nombre;
            _urlBase = App.UrlBase ?? "";
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await Api.PutAsync<AppDto>($"api/apps/{App!.Id}",
                    new { id = App.Id, codigo = _codigo, nombre = _nombre, urlBase = _urlBase });
                if (ok is not null)
                {
                    Snackbar.Add("App actualizada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar";
            }
            else
            {
                var result = await Api.PostAsync<AppDto>("api/apps",
                    new { codigo = _codigo, nombre = _nombre, urlBase = _urlBase });
                if (result is not null)
                {
                    Snackbar.Add("App creada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
