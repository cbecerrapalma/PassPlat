@page "/apps"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("APPS_VER"))
{
    <SinPermiso PermisoRequerido="APPS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Aplicaciones</h1>
                <p class="page-subtitle">Administra las aplicaciones registradas en la plataforma y sus configuraciones.</p>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                Nueva App
            </MudButton>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCount.ToString()" Label="Total Apps" Icon="@Icons.Material.Filled.Apps" ColorClass="primary" />
        <IamKpiCard Valor="@_activasCount.ToString()" Label="Activas" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_inactivasCount.ToString()" Label="Inactivas" Subtexto="Deshabilitadas" Icon="@Icons.Material.Filled.Cancel" ColorClass="warning" />
        <IamKpiCard Valor="@_totalDesdeApi.ToString()" Label="Total Conteo" Subtexto="Desde API" Icon="@Icons.Material.Filled.BarChart" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true"
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@Refrescar" ShowCreate="false">
                <Filtros>
                    <MudSelect T="bool?" Value="_estadoFiltro" ValueChanged="@OnEstadoChanged" Label="Estado"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Activas</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Inactivas</MudSelectItem>
                    </MudSelect>
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
                <MudTable T="AppDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm">
                    <ColGroup>
                        <col /><col style="width:100px;" /><col /><col style="width:100px;" /><col style="width:110px;" /><col style="width:140px;" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Nombre</MudTh><MudTh>Codigo</MudTh><MudTh>URL Base</MudTh><MudTh>Estado</MudTh><MudTh>Creado</MudTh><MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nombre">
                            <div class="col-name">@context.Nombre</div>
                            <div style="font-size:10px;color:var(--text-muted);">@context.Codigo</div>
                        </MudTd>
                        <MudTd DataLabel="Codigo" style="font-family:'JetBrains Mono',monospace;font-size:11px;">@context.Codigo</MudTd>
                        <MudTd DataLabel="URL Base">@context.UrlBase</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="badge @(context.Activa ? "badge-active" : "badge-inactive")">
                                <span class="badge-dot"></span>@(context.Activa ? "Activo" : "Inactivo")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Creado" Style="color:var(--text-muted);">@context.FecCrea.ToString("dd MMM yyyy")</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" aria-label="Editar" />
                            </MudTooltip>
                            <MudTooltip Text="Desactivar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDeactivate(context))" aria-label="Desactivar" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="py-6">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                            No hay registros
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>
</div>
}

@code {
    private List<AppDto> _items = [];
    private string _searchString = "";
    private bool? _estadoFiltro;
    private string _totalCount = "0";
    private int _totalDesdeApi;
    private int _activasCount;
    private int _inactivasCount;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("APPS_VER")) return;
        await CargarApps();
    }

    // S85 · D4 — buscador y estado se aplican en memoria sobre la lista completa
    private List<AppDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                filtrados = filtrados.Where(a =>
                    a.Codigo.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    a.Nombre.Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (_estadoFiltro is bool estado)
                filtrados = filtrados.Where(a => a.Activa == estado).ToList();
            return filtrados;
        }
    }

    private async Task CargarApps()
    {
        try
        {
            _items = await Api.GetAsync<List<AppDto>>("api/apps") ?? [];
            _totalDesdeApi = _items.Count;
            _totalCount = _totalDesdeApi.ToString();
            _activasCount = _items.Count(i => i.Activa);
            _inactivasCount = _items.Count(i => !i.Activa);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _searchString = value;
        StateHasChanged();
    }

    private void OnEstadoChanged(bool? estado)
    {
        _estadoFiltro = estado;
        StateHasChanged();
    }

    private async Task Refrescar()
    {
        await CargarApps();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<AppDialog>("Nueva App", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await Refrescar(); Snackbar.Add("App creada", Severity.Success); }
    }

    private async Task OpenEditDialog(AppDto item)
    {
        var parameters = new DialogParameters { ["IsEdit"] = true, ["App"] = item };
        var dialog = await Dialog.ShowAsync<AppDialog>("Editar App", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await Refrescar(); Snackbar.Add("App actualizada", Severity.Success); }
    }

    private async Task ConfirmDeactivate(AppDto item)
    {
        var parameters = new DialogParameters { ["Title"] = "Confirmar", ["Message"] = $"Desactivar app {item.Nombre}?", ["ConfirmText"] = "Si", ["CancelText"] = "Cancelar" };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.PostVoidAsync($"api/apps/{item.Id}/desactivar");
            if (ok) { Snackbar.Add("App desactivada", Severity.Success); await Refrescar(); }
            else Snackbar.Add(Api.LastError ?? "Error al desactivar", Severity.Error);
        }
    }
}
