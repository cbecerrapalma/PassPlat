@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Add" Texto="Nuevo Bloqueo" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <SelectorCatalogo T="UsuarioDto" Items="_usuarios" @bind-Value="_usuarioSelected"
                SearchTextSelector="@(u => $"{u.NomUsuario} {u.Nombre} {u.Apellido} {u.Email}")"
                ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
                Label="Usuario" Variant="Variant.Outlined"
                Required="true" RequiredError="El usuario es requerido" />
            <SelectorCatalogo T="TenantDto" Items="_tenants" @bind-Value="_tenantSelected"
                SearchTextSelector="@(t => $"{t.Nombre} {t.Codigo}")"
                ToStringFunc="@(t => t is null ? "" : $"{t.Nombre} ({t.Codigo})")"
                Label="Tenant" Variant="Variant.Outlined"
                Required="true" RequiredError="El tenant es requerido" />
            <MudSelect T="int" @bind-Value="_idTipoBloqueo" Label="Tipo Bloqueo" Variant="Variant.Outlined" Required="true">
                @foreach (var tipo in _tiposBloqueo)
                {
                    <MudSelectItem Value="@tipo.Id">@tipo.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_motivo" Label="Motivo" Variant="Variant.Outlined" Required="true"
                          RequiredError="El motivo es requerido" />
            <MudTextField @bind-Value="_duracionMinutos" Label="Duración (minutos)" Variant="Variant.Outlined" HelperText="Deja vacío para bloqueo permanente" />
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Crear" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    private List<UsuarioDto> _usuarios = [];
    private List<TenantDto> _tenants = [];
    private List<TipoBloqueoDto> _tiposBloqueo = [];
    private UsuarioDto? _usuarioSelected;
    private TenantDto? _tenantSelected;
    private int _idTipoBloqueo = 1;
    private string _motivo = "";
    private int? _duracionMinutos;
    private bool _saving;
    private MudForm _form = null!;

    protected override async Task OnInitializedAsync()
    {
        var tUsuarios = Api.GetAsync<List<UsuarioDto>>("api/usuarios");
        var tTenants = TenantsObjetivo.CargarAsync(Api, Auth); // S113 · D4
        var tTipos = Api.GetAsync<List<TipoBloqueoDto>>("api/TiposBloqueo");

        await Task.WhenAll(tUsuarios, tTenants, tTipos);

        _usuarios = tUsuarios.Result ?? [];
        _tenants = tTenants.Result ?? [];
        _tiposBloqueo = tTipos.Result ?? [];

        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == (Auth.IdUsuario ?? 0));
        _tenantSelected = _tenants.FirstOrDefault(t => t.Id == (Auth.IdTenant ?? 0));
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            var idUsuario = _usuarioSelected?.Id ?? 0;
            var idTenant = _tenantSelected?.Id ?? 0;
            var result = await Api.PostAsync<BloqueoDto>("api/bloqueos",
                new { idUsuario, idTenant, idTipoBloqueo = _idTipoBloqueo, motivo = _motivo, duracionMinutos = _duracionMinutos });
            if (result is not null)
            {
                Snackbar.Add("Bloqueo creado", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al crear bloqueo";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
