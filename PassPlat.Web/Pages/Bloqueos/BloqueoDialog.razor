@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Nuevo Bloqueo</MudText>
    </TitleContent>
    <DialogContent>
        <MudAutocomplete T="UsuarioDto" @bind-Value="_usuarioSelected"
            SearchFunc="@SearchUsuarios" ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
            Label="Usuario" Variant="Variant.Outlined" Class="mb-3"
            Error="@(_submitted && _usuarioSelected is null)" ErrorText="El usuario es requerido" />
        <MudAutocomplete T="TenantDto" @bind-Value="_tenantSelected"
            SearchFunc="@SearchTenants" ToStringFunc="@(t => t is null ? "" : $"{t.Nombre} ({t.Codigo})")"
            Label="Tenant" Variant="Variant.Outlined" Class="mb-3"
            Error="@(_submitted && _tenantSelected is null)" ErrorText="El tenant es requerido" />
        <MudSelect T="int" @bind-Value="_idTipoBloqueo" Label="Tipo Bloqueo" Variant="Variant.Outlined" Class="mb-3" Required="true">
            @foreach (var tipo in _tiposBloqueo)
            {
                <MudSelectItem Value="@tipo.Id">@tipo.Nombre</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_motivo" Label="Motivo" Variant="Variant.Outlined" Class="mb-3" Required="true"
                      Error="@(_submitted && string.IsNullOrWhiteSpace(_motivo))" ErrorText="El motivo es requerido" />
        <MudTextField @bind-Value="_duracionMinutos" Label="Duración (minutos)" Variant="Variant.Outlined" Class="mb-3" HelperText="Dejar vacío para bloqueo permanente" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@(!CanSave() || _saving)">Crear</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private List<UsuarioDto> _usuarios = [];
    private List<TenantDto> _tenants = [];
    private List<TipoBloqueoDto> _tiposBloqueo = [];
    private UsuarioDto? _usuarioSelected;
    private TenantDto? _tenantSelected;
    private int _idTipoBloqueo = 1;
    private string _motivo = "";
    private int? _duracionMinutos;
    private bool _saving;
    private bool _submitted;

    protected override async Task OnInitializedAsync()
    {
        var tUsuarios = Api.GetAsync<List<UsuarioDto>>("api/usuarios");
        var tTenants = Api.GetAsync<List<TenantDto>>("api/tenants");
        var tTipos = Api.GetAsync<List<TipoBloqueoDto>>("api/tipos-bloqueo");

        await Task.WhenAll(tUsuarios, tTenants, tTipos);

        _usuarios = tUsuarios.Result ?? [];
        _tenants = tTenants.Result ?? [];
        _tiposBloqueo = tTipos.Result ?? [];

        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == (Auth.IdUsuario ?? 0));
        _tenantSelected = _tenants.FirstOrDefault(t => t.Id == (Auth.IdTenant ?? 0));
    }

    private Task<IEnumerable<UsuarioDto>> SearchUsuarios(string value, CancellationToken _)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(_usuarios.Take(20));
        return Task.FromResult(_usuarios.Where(u =>
            u.NomUsuario.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            u.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20));
    }

    private Task<IEnumerable<TenantDto>> SearchTenants(string value, CancellationToken _)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(_tenants.Take(20));
        return Task.FromResult(_tenants.Where(t =>
            t.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            t.Codigo.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20));
    }

    private bool CanSave() => _usuarioSelected is not null && _tenantSelected is not null && !string.IsNullOrWhiteSpace(_motivo);

    private async Task Save()
    {
        _submitted = true;
        if (!CanSave()) return;
        _saving = true;
        try
        {
            var idUsuario = _usuarioSelected?.Id ?? 0;
            var idTenant = _tenantSelected?.Id ?? 0;
            var result = await Api.PostAsync<BloqueoDto>("api/bloqueos",
                new { idUsuario, idTenant, idTipoBloqueo = _idTipoBloqueo, motivo = _motivo, duracionMinutos = _duracionMinutos });
            if (result is not null)
            {
                Snackbar.Add("Bloqueo creado", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al crear bloqueo", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
