@page "/bloqueos"
@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("BLOQUEOS_VER"))
{
    <SinPermiso PermisoRequerido="BLOQUEOS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Bloqueos</h1>
                <p class="page-subtitle">Bloqueos de cuenta vigentes e históricos por usuario.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog"
                    StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">
                    Nuevo Bloqueo
                </MudButton>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_items.Count.ToString()" Label="Bloqueos" Subtexto="Registros en sistema" Icon="@Icons.Material.Filled.Block" ColorClass="primary" />
        <IamKpiCard Valor="@_items.Count(b => b.Activo).ToString()" Label="Activos" Subtexto="Vigentes" Icon="@Icons.Material.Filled.GppBad" ColorClass="error" />
        <IamKpiCard Valor="@_items.Count(b => !b.Activo).ToString()" Label="Inactivos" Subtexto="Desactivados" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_items.Select(b => b.TipoBloqueoNombre).Distinct().Count().ToString()" Label="Tipos" Subtexto="Distintos" Icon="@Icons.Material.Filled.Category" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <SelectorCatalogo T="UsuarioDto" Class="lista-filtro" Items="_usuarios" @bind-Value="_usuarioSelected" @bind-Value:after="@LoadData"
                    SearchTextSelector="@(u => $"{u.NomUsuario} {u.Nombre} {u.Apellido} {u.Email}")"
                    ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
                    Label="Usuario" Variant="Variant.Outlined" Clearable="true" />
                <MudSelect T="string" Label="Estado" @bind-Value="_filtroEstado" Variant="Variant.Outlined" Dense="true" Class="lista-filtro" Clearable="true">
                    <MudSelectItem Value="@("todos")">Todos</MudSelectItem>
                    <MudSelectItem Value="@("activos")">Activos</MudSelectItem>
                    <MudSelectItem Value="@("inactivos")">Inactivos</MudSelectItem>
                </MudSelect>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium"
                    OnClick="@RefreshAll" Class="mr-2" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable T="BloqueoDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm">
        <ColGroup>
            <col style="width:80px;" /><col style="width:120px;" /><col /><col style="width:160px;" /><col style="width:160px;" /><col style="width:100px;" /><col style="width:120px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh><MudTh>Tipo</MudTh><MudTh>Motivo</MudTh><MudTh>Fec. Bloqueo</MudTh><MudTh>Fec. Vencimiento</MudTh><MudTh>Activo</MudTh><MudTh>Código</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Tipo">
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@context.TipoBloqueoNombre</MudChip>
            </MudTd>
            <MudTd DataLabel="Motivo">@context.Motivo</MudTd>
            <MudTd DataLabel="Fec. Bloqueo">@context.FecInicio.ToString("g")</MudTd>
            <MudTd DataLabel="Fec. Vencimiento">@context.FecFin?.ToString("g")</MudTd>
            <MudTd DataLabel="Activo">
                <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Error : Color.Success)">
                    @(context.Activo ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Código">@(string.IsNullOrEmpty(context.CodDesbloqueo) ? "—" : context.CodDesbloqueo)</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<BloqueoDto> _items = [];
    private bool _loading;
    private List<UsuarioDto> _usuarios = [];
    private UsuarioDto? _usuarioSelected;
    private string _filtroEstado = "todos";

    private List<BloqueoDto> _itemsFiltrados
    {
        get
        {
            if (_filtroEstado == "todos") return _items;
            var activo = _filtroEstado == "activos";
            return _items.Where(b => b.Activo == activo).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("BLOQUEOS_VER")) return;
        // S68.2 · D3 — el tenant lo fija el JWT (ITenantContext): la página ya no pide api/tenants.
        _usuarios = await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? [];
        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == (Auth.IdUsuario ?? 0));
        await LoadData();
    }

    private async Task LoadData()
    {
        if (_usuarioSelected is null)
        {
            _items = [];
            return;
        }
        _loading = true;
        try
        {
            var data = await Api.GetAsync<List<BloqueoDto>>($"api/bloqueos/usuario/{_usuarioSelected.Id}");
            _items = data ?? [];
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task RefreshAll()
    {
        await LoadData();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await Dialog.ShowAsync<BloqueoDialog>("Nuevo Bloqueo", OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }
}
