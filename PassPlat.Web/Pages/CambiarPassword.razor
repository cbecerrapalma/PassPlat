@page "/cambiar-password"
@layout LoginLayout
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-wrapper">
    <MudPaper Elevation="0" Class="login-card px-8 py-10" Style="width: 100%; max-width: 420px; border-radius: 16px;">
        <div class="d-flex flex-column align-center mb-6">
            <div class="login-logo mb-3">
                <div class="login-logo-ring" />
                <div class="login-logo-inner">
                    <span class="login-logo-icon">&#x1F512;</span>
                </div>
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold text-white">Actualizar Contraseña</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray">Es necesario cambiar tu contraseña para acceder</MudText>
        </div>

        @if (!_exito)
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_currentPassword"
                               Label="Contraseña actual"
                               Variant="Variant.Outlined"
                               InputType="InputType.Password"
                               Margin="Margin.Dense"
                               Class="mb-4"
                               Disabled="_loading" />

                <MudTextField @bind-Value="_newPassword"
                               Label="Nueva contraseña"
                               Variant="Variant.Outlined"
                               InputType="InputType.Password"
                               Margin="Margin.Dense"
                               Class="mb-2"
                               Disabled="_loading"
                               Validation="@(new Func<string?, string?>(ValidarPassword))" />
                
                <PasswordStrength Password="_newPassword" NomUsuario="_nomUsuario" />

                <MudTextField @bind-Value="_confirmPassword"
                               Label="Confirmar nueva contraseña"
                               Variant="Variant.Outlined"
                               InputType="InputType.Password"
                               Margin="Margin.Dense"
                               Class="mb-4"
                               Disabled="_loading"
                               Validation="@(new Func<string?, string?>(v => v != _newPassword ? "Las contraseñas no coinciden" : null))" />
            </MudForm>
        }

        @if (_showError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        @if (_exito)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                Contraseña actualizada correctamente.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="@IrAlDashboard" Disabled="_loading" Size="Size.Large" Class="mb-6">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Class="mr-2" Color="Color.Inherit" Indeterminate="true" />
                    <span>Redirigiendo...</span>
                }
                else
                {
                    <MudText Typo="Typo.button">Ingresar al Sistema</MudText>
                }
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="@DoChange" Disabled="_loading || string.IsNullOrWhiteSpace(_newPassword) || !_passwordValid"
                       Size="Size.Large" Class="mb-6">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Class="mr-2" Color="Color.Inherit" Indeterminate="true" />
                    <span>Actualizando...</span>
                }
                else
                {
                    <MudText Typo="Typo.button">Actualizar contraseña</MudText>
                }
            </MudButton>
        }

        <MudText Typo="Typo.caption" Align="Align.Center" Class="text-gray mt-4">
            Plataforma de Acceso &mdash; v1.0
        </MudText>
    </MudPaper>
</div>

@code {
    private bool _loading;
    private bool _showError;
    private bool _exito;
    private bool _passwordValid;
    private string _nomUsuario = "";
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _errorMessage = "";
    private MudForm? _form;

    protected override async Task OnInitializedAsync()
    {
        _nomUsuario = Auth.NomUsuario ?? "";
    }

    private string? ValidarPassword(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "La contraseña es obligatoria";
        if (value.Length < 6) return "Debe tener al menos 6 caracteres";
        return null;
    }

    private void OnStrengthChanged(PasswordStrengthInfoDto? strength)
    {
        _passwordValid = strength?.IsValid == true;
    }

    private async Task DoChange()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword) || !_passwordValid) return;

        _loading = true;
        _showError = false;

        try
        {
            var hash = await Auth.CalcularHashAsync(_newPassword);
            if (string.IsNullOrEmpty(hash))
            {
                _errorMessage = "Error al procesar la contraseña";
                _showError = true;
                return;
            }

            var result = await Auth.CambiarPasswordAsync(_currentPassword, hash);
            if (result.Success)
            {
                _exito = true;
            }
            else
            {
                _errorMessage = MapErrorCode(result.ErrorCode, result.ErrorMessage ?? "Error al cambiar la contraseña");
                _showError = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error de conexión: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void IrAlDashboard()
    {
        Nav.NavigateTo("/");
    }

    private string MapErrorCode(string? errorCode, string defaultMessage)
    {
        return errorCode switch
        {
            "PASSWORD_REUSE" => "No puedes reutilizar una contraseña reciente",
            "PASSWORD_TOO_SHORT" => "La contraseña es demasiado corta",
            "PASSWORD_WEAK" => "La contraseña no cumple los requisitos de seguridad",
            "PASSWORD_COMMON" => "La contraseña es demasiado común",
            "PASSWORD_SEQUENTIAL" => "La contraseña contiene secuencias no permitidas",
            "PASSWORD_REPEATING" => "La contraseña contiene repeticiones no permitidas",
            "PASSWORD_USER_INFO" => "La contraseña no puede contener datos personales",
            "CURRENT_PASSWORD_INVALID" => "La contraseña actual es incorrecta",
            "USER_NOT_FOUND" => "Usuario no encontrado",
            _ => defaultMessage
        };
    }
}
