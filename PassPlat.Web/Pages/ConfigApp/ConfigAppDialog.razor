@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(IsEdit ? "Editar Configuración" : "Nueva Configuración")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <div class="dialogo-fila">
                <MudTextField @bind-Value="_grupo" Label="Grupo" Variant="Variant.Outlined" Disabled="@IsEdit" Required="true"
                              RequiredError="El grupo es requerido" />
                <MudTextField @bind-Value="_clave" Label="Clave" Variant="Variant.Outlined" Disabled="@IsEdit" Required="true"
                              RequiredError="La clave es requerida" />
            </div>
            <MudTextField @bind-Value="_valor" Label="Valor" Variant="Variant.Outlined" Required="true"
                          RequiredError="El valor es requerido"
                          Adornment="@(_esEncriptado ? Adornment.Start : Adornment.None)"
                          AdornmentIcon="@(_esEncriptado ? Icons.Material.Filled.Lock : null)"
                          AdornmentColor="Color.Warning" />
            @if (_esEncriptado)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock" Dense="true">
                    <MudText Typo="Typo.body2">
                        El valor se cifrará con <strong>AES-256 (CBP.Security.Cryptography)</strong> antes de almacenar.
                        @if (IsEdit && _originalEsEncriptado)
                        {
                            <span>Vuelve a ingresar el valor en texto plano para reemplazarlo, o deja el actual.</span>
                        }
                    </MudText>
                </MudAlert>
            }
            <MudSelect T="string" Value="@_tipo" ValueChanged="@((string v) => OnTipoChanged(v))" Label="Tipo" Variant="Variant.Outlined" Required="true"
                       RequiredError="Selecciona un tipo">
                <MudSelectItem Value="@("string")">String</MudSelectItem>
                <MudSelectItem Value="@("int")">Entero</MudSelectItem>
                <MudSelectItem Value="@("bool")">Booleano</MudSelectItem>
                <MudSelectItem Value="@("json")">JSON</MudSelectItem>
                <MudSelectItem Value="@("encrypted")">Encriptado</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" />
            <MudSwitch T="bool" Value="@_esEncriptado" ValueChanged="@(v => OnEncriptadoChanged(v))" Label="Valor Encriptado" Color="Color.Primary" />
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ConfigAppDto? ConfigApp { get; set; }

    private string _grupo = "";
    private string _clave = "";
    private string _valor = "";
    private string _tipo = "string";
    private string _descripcion = "";
    private bool _esEncriptado;
    private bool _originalEsEncriptado;
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        if (IsEdit && ConfigApp is not null)
        {
            _grupo = ConfigApp.Grupo;
            _clave = ConfigApp.Clave;
            _valor = ConfigApp.Valor;
            _tipo = ConfigApp.Tipo;
            _descripcion = ConfigApp.Descripcion ?? "";
            _esEncriptado = ConfigApp.EsEncriptado;
            _originalEsEncriptado = ConfigApp.EsEncriptado;
        }
    }

    private void OnTipoChanged(string nuevoTipo)
    {
        _tipo = nuevoTipo;
        _esEncriptado = nuevoTipo == "encrypted";
        Console.WriteLine($"[ConfigAppDialog] OnTipoChanged -> tipo='{_tipo}', esEncriptado={_esEncriptado}");
        StateHasChanged();
    }

    private void OnEncriptadoChanged(bool value)
    {
        _esEncriptado = value;
        if (value && _tipo != "encrypted")
            _tipo = "encrypted";
        else if (!value && _tipo == "encrypted")
            _tipo = "string";
        Console.WriteLine($"[ConfigAppDialog] OnEncriptadoChanged -> esEncriptado={_esEncriptado}, tipo='{_tipo}'");
        StateHasChanged();
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await Api.PutVoidAsync($"api/configapp/{ConfigApp!.Id}",
                    new { valor = _valor, descripcion = string.IsNullOrEmpty(_descripcion) ? null : _descripcion, activo = true, esEncriptado = _esEncriptado });
                if (ok)
                {
                    Snackbar.Add("Configuración actualizada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar";
            }
            else
            {
                var result = await Api.PostAsync<ConfigAppDto>("api/configapp",
                    new { grupo = _grupo, clave = _clave, valor = _valor, tipo = _tipo, descripcion = string.IsNullOrEmpty(_descripcion) ? null : _descripcion, esEncriptado = _esEncriptado });
                if (result is not null)
                {
                    Snackbar.Add("Configuración creada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
