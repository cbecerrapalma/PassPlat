@page "/config-app"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("CONFIGAPP_VER"))
{
    <SinPermiso PermisoRequerido="CONFIGAPP_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Config App</h1>
                <p class="page-subtitle">Parámetros de configuración de cada aplicación.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog"
                    StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">
                    Nueva Configuración
                </MudButton>
            </div>
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <MudTextField Value="@_searchString" ValueChanged="@(EventCallback.Factory.Create<string>(this, async (string value) => { _searchString = value; if (_table is not null) await _table.ReloadServerData(); }))" Class="lista-filtro" Label="Buscar..." Variant="Variant.Outlined"
                    Immediate="true" Clearable="true" />
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium"
                    OnClick="@(async () => { if (_table is not null) await _table.ReloadServerData(); })" Class="mr-2" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable @ref="_table" T="ConfigAppDto" ServerData="@_serverReload" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
        <ColGroup>
            <col style="width: 80px;" />
            <col />
            <col />
            <col />
            <col />
            <col />
            <col style="width: 120px;" />
            <col style="width: 100px;" />
            <col style="width: 140px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Grupo</MudTh>
            <MudTh>Clave</MudTh>
            <MudTh>Valor</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Encriptado</MudTh>
            <MudTh>Activo</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Grupo">@context.Grupo</MudTd>
            <MudTd DataLabel="Clave">@context.Clave</MudTd>
            <MudTd DataLabel="Valor">
                @if (context.EsEncriptado)
                {
                    <span class="d-inline-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                        <code>••••••••</code>
                    </span>
                }
                else
                {
                    @context.Valor
                }
            </MudTd>
            <MudTd DataLabel="Tipo">
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Tipo</MudChip>
            </MudTd>
            <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
            <MudTd DataLabel="Encriptado">
                <MudChip T="string" Size="Size.Small" Color="@(context.EsEncriptado ? Color.Warning : Color.Default)">
                    @(context.EsEncriptado ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Activo">
                <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Error)">
                    @(context.Activo ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" aria-label="Editar" />
                </MudTooltip>
                <MudTooltip Text="Eliminar">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDeactivate(context))" aria-label="Eliminar" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private MudTable<ConfigAppDto>? _table;
    private IEnumerable<ConfigAppDto> _items = [];
    private bool _loading;
    private string _searchString = "";

    private async Task<TableData<ConfigAppDto>> _serverReload(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var searchParam = string.IsNullOrEmpty(_searchString) ? "" : _searchString;
            var idTenant = Auth.IdTenant ?? 0;
            var tenantParam = idTenant > 0 ? $"&idTenant={idTenant}" : "";
            var response = await Api.GetAsync<PagedResponse<ConfigAppDto>>(
                $"api/configapp/page?pageNumber={state.Page + 1}&pageSize={state.PageSize}&search={Uri.EscapeDataString(searchParam)}{tenantParam}");
            if (response != null)
            {
                _items = response.Items;
                return new TableData<ConfigAppDto> { Items = response.Items, TotalItems = response.TotalCount };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
        return new TableData<ConfigAppDto> { Items = [], TotalItems = 0 };
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<ConfigAppDialog>("Nueva Configuración", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false } && _table != null)
            await _table.ReloadServerData();
    }

    private async Task OpenEditDialog(ConfigAppDto item)
    {
        var parameters = new DialogParameters
        {
            ["IsEdit"] = true,
            ["ConfigApp"] = item
        };
        var dialog = await Dialog.ShowAsync<ConfigAppDialog>("Editar Configuración", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false } && _table != null)
            await _table.ReloadServerData();
    }

    private async Task ConfirmDeactivate(ConfigAppDto item)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Confirmar",
            ["Message"] = $"¿Desactivar configuración '{item.Clave}'?",
            ["ConfirmText"] = "Sí",
            ["CancelText"] = "Cancelar"
        };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.DeleteAsync($"api/configapp/{item.Id}");
            if (ok)
            {
                Snackbar.Add("Configuración desactivada", Severity.Success);
                if (_table != null)
                    await _table.ReloadServerData();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al desactivar", Severity.Error);
        }
    }
}