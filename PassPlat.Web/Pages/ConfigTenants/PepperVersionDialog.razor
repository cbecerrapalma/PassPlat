@inject ApiClient Api
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Edit" Texto="Actualizar Versión de Pepper" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <div class="dialogo-campos">
            <div class="readonly-grid">
                <div class="readonly-item"><div class="field-label">Configuración</div><div class="field-value">ID @ConfigTenant.Id (Tenant: @ConfigTenant.TenantNombre)</div></div>
                <div class="readonly-item"><div class="field-label">Versión actual</div><div class="field-value">@ConfigTenant.PepperVersionActual</div></div>
            </div>
            <MudTextField @bind-Value="_nuevaVersion" Label="Nueva Versión Pepper" Variant="Variant.Outlined"
                InputType="InputType.Number" HelperText="Incrementar para regenerar hashes de contraseñas" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Guardar" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public ConfigTenantDto ConfigTenant { get; set; } = null!;

    private byte _nuevaVersion;
    private bool _saving;

    protected override void OnInitialized()
    {
        _nuevaVersion = (byte)(ConfigTenant.PepperVersionActual + 1);
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var ok = await Api.PostVoidAsync($"api/ConfigTenants/{ConfigTenant.Id}/pepper-version", new { pepperVersion = _nuevaVersion });
            if (ok)
            {
                Snackbar.Add("Versión de pepper actualizada", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al actualizar";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}