@page "/"
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using PassPlat.Aplicacion.Dtos.Core

@* S77 · D4 — una sola peticion (GET api/inicio) alimenta las tres vistas:
   Mi cuenta (todos), Mi tenant (con tenant) y Plataforma (sin tenant, totales globales).
   La federacion de identidades ya no vive aqui: sigue en los paneles /admin/*. *@
<div class="iam-page dash-page">
    @if (Auth.EsPlatform)
    {
        <AvisoSinTenant Que="las vistas de tenant" />
    }
    @* ── Cabecera compacta (una sola linea) ─────────────────────── *@
    <div class="dash-head">
        <div class="dash-head-text">
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-0">Bienvenido, @(Auth.NomUsuario ?? "Usuario")</MudText>
            <div class="dash-head-meta">
                <span>@DateTime.Now.ToString("dddd dd 'de' MMMM 'de' yyyy")</span>
                <span class="dash-head-dot">•</span>
                <span>@(Auth.NombreTenant ?? (Auth.IdTenant.HasValue ? $"Tenant {Auth.IdTenant}" : "Sin tenant"))</span>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
            StartIcon="@Icons.Material.Filled.Refresh" OnClick="@Refrescar" Disabled="@_cargando"
            aria-label="Actualizar los datos del panel">
            Actualizar
        </MudButton>
    </div>

    @if (_cargando && !_cargado)
    {
        @* ── Esqueleto de carga ─────────────────────────────── *@
        <div class="kpi-row">
            @for (int i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="88px" />
            }
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" Class="mt-4" />
    }
    else if (_inicio is null)
    {
        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
            <div class="dash-empty">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No se pudieron cargar los datos del inicio</MudText>
            </div>
        </MudPaper>
    }
    else
    {
        @* ── Mi cuenta: siempre ──────────────────────────────── *@
        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
            <div class="dash-block-head">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Mi cuenta</MudText>
                <MudButton Href="/cambiar-password" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                    StartIcon="@Icons.Material.Filled.Lock">
                    Cambiar contraseña
                </MudButton>
            </div>
            <div class="pa-4 pt-0">
                <div class="dash-mini-row">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0" Color="Color.Primary">@VencimientoPwd()</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Vencimiento de la contraseña</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0" Color="Color.Success">@_inicio.Cuenta.MetodosMfaActivos</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Métodos MFA activos</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0" Color="Color.Info">@_inicio.Cuenta.SesionesActivas</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sesiones activas</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0" Color="Color.Secondary">@_inicio.Cuenta.DispositivosConfiables</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Dispositivos confiables</MudText>
                    </div>
                </div>
            </div>
        </MudPaper>

        @* ── Mi tenant: solo con tenant y con los valores que el actor puede ver ── *@
        @if (Auth.EsTenant && _inicio.Tenant is InicioTenantDto miTenant)
        {
            <MudText Typo="Typo.h6" Class="font-weight-bold mt-4 mb-2">Mi tenant</MudText>

            <div class="kpi-row">
                @if (miTenant.Usuarios is int usuariosTenant)
                {
                    <IamKpiCard Valor="@usuariosTenant.ToString("N0")" Label="Usuarios" Icon="@Icons.Material.Filled.People" ColorClass="primary" Href="/usuarios" />
                }
                @if (miTenant.SesionesActivas is int sesionesTenant)
                {
                    <IamKpiCard Valor="@sesionesTenant.ToString("N0")" Label="Sesiones activas" Icon="@Icons.Material.Filled.DevicesOther" ColorClass="success" Href="/sesiones" />
                }
            </div>

            <div class="dash-columns">
                <div class="dash-col">
                    @* Actividad reciente del tenant *@
                    @if (miTenant.Actividad is not null)
                    {
                        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
                            <div class="dash-block-head">
                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Color="Color.Info" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Actividad reciente</MudText>
                                @if (Auth.TienePermiso("AUDITORIA_VER"))
                                {
                                    <MudButton Href="/auditoria" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                                        Ver todo
                                    </MudButton>
                                }
                            </div>
                            @if (miTenant.Actividad.Count > 0)
                            {
                                <ul class="dash-activity">
                                    @foreach (var act in miTenant.Actividad)
                                    {
                                        <li class="dash-activity-item">
                                            <span class="dash-activity-icon dash-activity-icon-@RiesgoCss(act.NivelRiesgo)">
                                                <MudIcon Icon="@IconoActividad(act)" Size="Size.Small" />
                                            </span>
                                            <div class="dash-activity-text">
                                                <MudText Typo="Typo.body2" Class="font-weight-medium">@(act.Detalles ?? act.TipoAccionNombre ?? "Sin descripción")</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(act.UsuarioNombre ?? "Sistema") · @TiempoRelativo(act.FecAccion)
                                                </MudText>
                                            </div>
                                            @if (act.NivelRiesgo is not null && act.NivelRiesgo >= 7)
                                            {
                                                <MudChip T="int" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@act.NivelRiesgo</MudChip>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="dash-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No hay actividad reciente</MudText>
                                </div>
                            }
                        </MudPaper>
                    }
                </div>

                <div class="dash-col">
                    @* Estado de seguridad (semáforo) *@
                    @if (miTenant.ConIntentosExcedidos is not null || miTenant.ConPasswordExpirada is not null)
                    {
                        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
                            <div class="dash-block-head">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Warning" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Estado de seguridad</MudText>
                                <span class="dash-status-pill dash-status-@EstadoSeguridad(miTenant)">
                                    <span class="dash-status-dot"></span>@TextoEstadoSeguridad(miTenant)
                                </span>
                            </div>
                            <div class="pa-4 pt-0">
                                <div class="dash-status-row">
                                    <span class="dash-status-icon dash-status-icon-@(miTenant.ConIntentosExcedidos > 0 ? "warning" : "success")">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                    </span>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@(miTenant.ConIntentosExcedidos ?? 0) usuarios</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Con intentos de acceso excedidos</MudText>
                                    </div>
                                    <MudButton Href="/intentos-acceso" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">Detalle</MudButton>
                                </div>
                                <div class="dash-status-row">
                                    <span class="dash-status-icon dash-status-icon-@(miTenant.ConPasswordExpirada > 0 ? "error" : "success")">
                                        <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Small" />
                                    </span>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@(miTenant.ConPasswordExpirada ?? 0) usuarios</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Con contraseña expirada</MudText>
                                    </div>
                                    <MudButton Href="/historial-pwd" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">Detalle</MudButton>
                                </div>
                                <MudButton Href="/admin/roles" Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                                    StartIcon="@Icons.Material.Filled.Settings" Class="mt-2">
                                    Ir a configuración de seguridad
                                </MudButton>
                            </div>
                        </MudPaper>
                    }

                    @* Dispositivos del tenant *@
                    @if (miTenant.DispConfiables is not null || miTenant.DispNoConfiables is not null)
                    {
                        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
                            <div class="dash-block-head">
                                <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Dispositivos</MudText>
                            </div>
                            <div class="pa-4 pt-0">
                                <div class="dash-mini-row">
                                    <div>
                                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-0" Color="Color.Success">@(miTenant.DispConfiables ?? 0)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Confiables</MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-0" Color="Color.Warning">@(miTenant.DispNoConfiables ?? 0)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No confiables</MudText>
                                    </div>
                                </div>
                                <MudButton Href="/dispositivos" Variant="Variant.Text" Color="Color.Success" StartIcon="@Icons.Material.Filled.Visibility" Class="mt-2">
                                    Ver dispositivos
                                </MudButton>
                            </div>
                        </MudPaper>
                    }
                </div>
            </div>
        }

        @* ── Plataforma: sin tenant, totales globales ────────────────────── *@
        @if (Auth.EsPlatform && _inicio.Plataforma is InicioPlataformaDto plataforma)
        {
            <MudText Typo="Typo.h6" Class="font-weight-bold mt-4 mb-2">Plataforma</MudText>

            <div class="kpi-row">
                @if (plataforma.TenantsActivos is int tenantsActivos)
                {
                    <IamKpiCard Valor="@tenantsActivos.ToString("N0")" Label="Inquilinos activos" Icon="@Icons.Material.Filled.Business" ColorClass="secondary" Href="/tenants" />
                }
                @if (plataforma.Apps is int apps)
                {
                    <IamKpiCard Valor="@apps.ToString("N0")" Label="Aplicaciones" Icon="@Icons.Material.Filled.Apps" ColorClass="info" Href="/apps" />
                }
                @if (plataforma.Usuarios is int usuariosPlataforma)
                {
                    <IamKpiCard Valor="@usuariosPlataforma.ToString("N0")" Label="Usuarios" Icon="@Icons.Material.Filled.People" ColorClass="primary" Href="/usuarios" />
                }
            </div>

            @if (plataforma.Servicios is not null)
            {
                <MudPaper Class="dash-block" Elevation="0" Outlined="true">
                    <div class="dash-block-head">
                        <MudIcon Icon="@Icons.Material.Filled.SettingsSuggest" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Servicios en segundo plano</MudText>
                        @if (Auth.TienePermiso("USUARIOS_VER"))
                        {
                            <MudButton Href="/admin/panel" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                                Panel completo
                            </MudButton>
                        }
                    </div>
                    @if (plataforma.Servicios.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Outlined="true">
                            <thead>
                                <tr>
                                    <th>Servicio</th>
                                    <th>Estado</th>
                                    <th>Última ejecución</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in plataforma.Servicios)
                                {
                                    <tr>
                                        <td>@job.Nombre</td>
                                        <td>@job.Estado</td>
                                        <td>@(job.UltimaEjecucion?.ToString("g") ?? "Sin registro")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <div class="dash-empty">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No hay servicios registrados</MudText>
                        </div>
                    }
                </MudPaper>
            }
        }

        @* ── Accesos rápidos ─────────────────────────────────────────────── *@
        <MudPaper Class="dash-block" Elevation="0" Outlined="true">
            <div class="dash-block-head">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-0">Accesos rápidos</MudText>
            </div>
            <div class="dash-quick">
                @if (Auth.TienePermiso("USUARIOS_VER"))
                {
                    <MudButton Href="/usuarios" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.People" Class="dash-quick-item">Usuarios</MudButton>
                }
                @if (Auth.TienePermiso("ACCESOS_VER"))
                {
                    <MudButton Href="/accesos" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" Class="dash-quick-item">Accesos</MudButton>
                }
                @if (Auth.TienePermiso("ROLES_VER") || Auth.TienePermiso("ROLES_DETALLE_VER"))
                {
                    <MudButton Href="/admin/roles" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AdminPanelSettings" Class="dash-quick-item">Roles y permisos</MudButton>
                }
                @if (Auth.TienePermiso("MATRIZ_PERMISOS_VER"))
                {
                    <MudButton Href="/admin/matriz-permisos" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableChart" Class="dash-quick-item">Matriz de permisos</MudButton>
                }
                @if (Auth.TienePermiso("SESIONES_VER"))
                {
                    <MudButton Href="/sesiones" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DevicesOther" Class="dash-quick-item">Sesiones</MudButton>
                }
                @if (Auth.TienePermiso("AUDITORIA_VER"))
                {
                    <MudButton Href="/auditoria" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History" Class="dash-quick-item">Auditoría</MudButton>
                }
            </div>
        </MudPaper>
    }
</div>

@code {
    private InicioDto? _inicio;
    private bool _initialized;
    private bool _cargando;
    private bool _cargado;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (_initialized) return;
        _initialized = true;

        await CargarInicioAsync();
    }

    /// <summary>S77 · D4 — el boton «Actualizar» repite la unica peticion del inicio.</summary>
    private async Task Refrescar()
    {
        await CargarInicioAsync();
    }

    private async Task CargarInicioAsync()
    {
        _cargando = true;
        try
        {
            _inicio = await Api.GetAsync<InicioDto>("api/inicio");
        }
        catch (TaskCanceledException)
        {
            // sin respuesta a tiempo: la pagina se queda como esta
        }
        catch (Exception ex)
        {
            _inicio = null;
            Snackbar.Add(Api.LastError ?? $"Error al cargar el inicio: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
            _cargado = true;
        }
    }

    private string VencimientoPwd() =>
        _inicio?.Cuenta.FecExpiraPwd is DateTime expira ? expira.ToString("dd/MM/yyyy") : "Sin vencimiento";

    /// <summary>S58 · K5 (D6) — semaforo del estado de seguridad del tenant.</summary>
    private static string EstadoSeguridad(InicioTenantDto tenant)
    {
        if (tenant.ConIntentosExcedidos > 0) return "error";
        if (tenant.ConPasswordExpirada > 0) return "warning";
        return "success";
    }

    private static string TextoEstadoSeguridad(InicioTenantDto tenant) => EstadoSeguridad(tenant) switch
    {
        "error" => "Incidencias criticas",
        "warning" => "Revisar passwords",
        _ => "Sin incidencias"
    };

    /// <summary>S58 · K5 (D6) — icono por tipo de actividad.</summary>
    private static string IconoActividad(AuditoriaPwdDto act)
    {
        var tipo = (act.TipoAccionNombre ?? "").ToUpperInvariant();
        if (tipo.Contains("LOGIN")) return Icons.Material.Filled.Login;
        if (tipo.Contains("PASSWORD") || tipo.Contains("PWD")) return Icons.Material.Filled.Password;
        if (tipo.Contains("TOKEN")) return Icons.Material.Filled.Token;
        if (tipo.Contains("ROL")) return Icons.Material.Filled.AdminPanelSettings;
        if (tipo.Contains("SESION") || tipo.Contains("SESIÓN")) return Icons.Material.Filled.DevicesOther;
        if (tipo.Contains("ELIMIN")) return Icons.Material.Filled.Delete;
        if (tipo.Contains("CREA") || tipo.Contains("ALTA")) return Icons.Material.Filled.PersonAdd;
        return Icons.Material.Filled.Bolt;
    }

    /// <summary>S58 · K5 (D6) — hora relativa de la actividad.</summary>
    private static string TiempoRelativo(DateTime? fecha)
    {
        if (fecha is null) return "sin fecha";
        var delta = DateTime.Now - fecha.Value;
        if (delta.TotalMinutes < 1) return "hace un momento";
        if (delta.TotalMinutes < 60) return $"hace {delta.TotalMinutes:N0} min";
        if (delta.TotalHours < 24) return $"hace {delta.TotalHours:N0} h";
        if (delta.TotalDays < 30) return $"hace {delta.TotalDays:N0} d";
        return fecha.Value.ToString("dd/MM/yyyy");
    }

    private static string RiesgoCss(int? nivel) => nivel switch
    {
        >= 7 => "error",
        >= 4 => "warning",
        _ => "info"
    };
}
