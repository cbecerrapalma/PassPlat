@page "/dispositivos"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth

<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Gestión de Dispositivos</h1>
                <p class="page-subtitle">Dispositivos registrados; seleccione uno para ver su detalle.</p>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <div>
            <IamKpiCard Icon="@Icons.Material.Filled.Devices" Valor="@_totalDisp.ToString()" Label="Total Dispositivos" ColorClass="primary" />
        </div>
        <div>
            <IamKpiCard Icon="@Icons.Material.Filled.Shield" Valor="@_totalConf.ToString()" Label="Confiables" ColorClass="success" />
        </div>
        <div>
            <IamKpiCard Icon="@Icons.Material.Filled.Block" Valor="@_totalNoConf.ToString()" Label="No Confiables" ColorClass="warning" />
        </div>
        <div>
            <IamKpiCard Icon="@Icons.Material.Filled.Person" Valor="@_totalUsuarios.ToString()" Label="Usuarios" ColorClass="info" />
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <MudTextField @bind-Value="_search" Label="Buscar dispositivo..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Class="lista-filtro" />
                <MudSelect T="string" Value="_tipoFiltro" ValueChanged="@OnTipoChanged" Label="Tipo" Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                    @foreach (var tipo in _tiposFiltro)
                    {
                        <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="bool?" Value="_confiableFiltro" ValueChanged="@OnConfiableChanged" Label="Confiable" Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                    <MudSelectItem T="bool?" Value="@((bool?)true)">Sí</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@((bool?)false)">No</MudSelectItem>
                </MudSelect>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium" OnClick="@LoadData" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable T="DispConfiableDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm"
        OnRowClick="@((TableRowClickEventArgs<DispConfiableDto> e) => VerDetalle(e.Item))" RowStyle="cursor: pointer;"
        Loading="@_loading" Class="mt-2">
        <ColGroup>
            <col style="width:60px;" />
            <col />
            <col />
            <col />
            <col style="width:120px;" />
            <col style="width:80px;" />
            <col style="width:80px;" />
            <col style="width:100px;" />
            <col style="width:140px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Dispositivo</MudTh>
            <MudTh>Usuario</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>IP / País</MudTh>
            <MudTh>Navegador</MudTh>
            <MudTh>SO</MudTh>
            <MudTh>Confianza</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Dispositivo">
                <div class="d-flex flex-column">
                    <span>@context.DispModelo</span>
                    <span class="text-caption">@context.DispFabricante</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Usuario">@context.UsuarioNombre</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="IP / País">
                <div class="d-flex flex-column">
                    <span class="mono">@(!string.IsNullOrEmpty(context.IP) ? context.IP : "—")</span>
                    <span class="text-caption">@(!string.IsNullOrEmpty(context.Pais) ? context.Pais : "")</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Navegador">@context.Navegador</MudTd>
            <MudTd DataLabel="SO">@context.SO</MudTd>
            <MudTd DataLabel="Confianza">
                <MudChip T="string" Size="Size.Small" Color="@(context.Confiable ? Color.Success : Color.Error)">
                    @(context.Confiable ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <div @onclick:stopPropagation="true" class="table-actions">
                    <MudTooltip Text="Marcar confiable">
                        <MudIconButton Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Success"
                            Disabled="@context.Confiable"
                            OnClick="@(() => MarcarConfiable(context))" aria-label="Seguridad" />
                    </MudTooltip>
                    <MudTooltip Text="Revocar confianza">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Warning"
                            Disabled="@(!context.Confiable)"
                            OnClick="@(() => RevocarConfianza(context))" aria-label="Bloquear" />
                    </MudTooltip>
                    <MudTooltip Text="Bloquear dispositivo">
                        <MudIconButton Icon="@Icons.Material.Filled.Dangerous" Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => Bloquear(context))" aria-label="Acción peligrosa" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar dispositivo">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => Eliminar(context))" aria-label="Eliminar definitivamente" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay dispositivos registrados
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DispConfiableDto> _items = [];
    private bool _loading;
    private int _totalDisp;
    private int _totalConf;
    private int _totalNoConf;
    private int _totalUsuarios;
    private string? _search;
    private string? _tipoFiltro;
    private bool? _confiableFiltro;
    private List<string> _tiposFiltro = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // S85 · D4 — buscador (UsuarioNombre/Nombre/IP/DispModelo), tipo y confianza se aplican en memoria
    private List<DispConfiableDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                filtrados = filtrados.Where(d =>
                    (d.UsuarioNombre ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (d.Nombre ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (d.IP ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (d.DispModelo ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(_tipoFiltro))
                filtrados = filtrados.Where(d => d.DispTipo == _tipoFiltro).ToList();
            if (_confiableFiltro is bool confiable)
                filtrados = filtrados.Where(d => d.Confiable == confiable).ToList();
            return filtrados;
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _items = await Api.GetAsync<List<DispConfiableDto>>("api/DispConfiables") ?? [];
            _totalDisp = _items.Count;
            _totalConf = _items.Count(d => d.Confiable);
            _totalNoConf = _items.Count(d => !d.Confiable);
            _totalUsuarios = _items.Select(d => d.IdUsuario).Distinct().Count();

            // S85 · D4 — opciones del filtro Tipo a partir de la lista cargada
            _tiposFiltro = _items.Select(d => d.DispTipo ?? string.Empty)
                .Where(n => n.Length > 0).Distinct().OrderBy(n => n).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void VerDetalle(DispConfiableDto? item)
    {
        if (item is not null) Navigation.NavigateTo($"/dispositivos/{item.Id}");
    }

    private async Task MarcarConfiable(DispConfiableDto item)
    {
        try
        {
            var ok = await Api.PostVoidAsync($"api/DispConfiables/marcar-confiable/{item.IdUsuario}/{item.IdDisp}");
            if (ok)
            {
                Snackbar.Add("Dispositivo marcado como confiable", Severity.Success);
                await LoadData();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al marcar como confiable", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RevocarConfianza(DispConfiableDto item)
    {
        try
        {
            var ok = await Api.PostVoidAsync($"api/DispConfiables/revocar-confianza/{item.IdUsuario}/{item.IdDisp}");
            if (ok)
            {
                Snackbar.Add("Confianza revocada", Severity.Success);
                await LoadData();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al revocar confianza", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task Bloquear(DispConfiableDto item)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Bloquear dispositivo",
            ["Message"] = $"¿Bloquear el dispositivo '{item.DispModelo}' de '{item.UsuarioNombre}'? Se revocará la confianza.",
            ["ConfirmText"] = "Bloquear",
            ["CancelText"] = "Cancelar"
        };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is null or { Canceled: true }) return;

        try
        {
            var ok = await Api.PostVoidAsync($"api/DispConfiables/bloquear/{item.Id}");
            if (ok)
            {
                Snackbar.Add("Dispositivo bloqueado", Severity.Success);
                await LoadData();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al bloquear dispositivo", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task Eliminar(DispConfiableDto item)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Eliminar dispositivo",
            ["Message"] = $"¿Eliminar permanentemente el dispositivo '{item.DispModelo}' de '{item.UsuarioNombre}'? Esta acción no se puede deshacer.",
            ["ConfirmText"] = "Eliminar",
            ["CancelText"] = "Cancelar",
            ["ConfirmColor"] = Color.Error
        };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is null or { Canceled: true }) return;

        try
        {
            var ok = await Api.DeleteAsync($"api/DispConfiables/{item.Id}");
            if (ok)
            {
                Snackbar.Add("Dispositivo eliminado", Severity.Success);
                await LoadData();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al eliminar dispositivo", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnTipoChanged(string? tipo)
    {
        _tipoFiltro = tipo;
    }

    private void OnConfiableChanged(bool? confiable)
    {
        _confiableFiltro = confiable;
        StateHasChanged();
    }
}
