@page "/dominios-tenant"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("TENANTS_VER"))
{
    <SinPermiso PermisoRequerido="TENANTS_VER" />
}
else
{
<div class="iam-page">
    @if (!Auth.EsTenant)
    {
        <AvisoSinTenant Que="sus dominios" />
    }
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Dominios por Tenant</h1>
                <p class="page-subtitle">Dominios de correo asociados a cada tenant.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog"
                    StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">
                    Agregar Dominio
                </MudButton>
            </div>
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <MudTextField @bind-Value="_search" Label="Buscar dominio..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Class="lista-filtro" />
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium"
                    OnClick="@LoadData" Class="mr-2" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable T="DominioTenantDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
        <ColGroup>
            <col style="width: 80px;" />
            <col style="width: 120px;" />
            <col />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Tenant</MudTh>
            <MudTh>Dominio</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Tenant">@context.TenantNombre</MudTd>
            <MudTd DataLabel="Dominio">@context.Dominio</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<DominioTenantDto> _items = [];
    private bool _loading;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("TENANTS_VER")) return;
        await LoadData();
    }

    // S85 · D4 — buscador (Dominio / TenantNombre) se aplica en memoria sobre la lista cargada
    private List<DominioTenantDto> _itemsFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return _items;
            var s = _search.Trim();
            return _items.Where(d =>
                (d.Dominio ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (d.TenantNombre ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private async Task LoadData()
    {
        if (Auth.IdTenant is not int tenantId || tenantId <= 0)
        {
            _items = [];
            return;
        }

        _loading = true;
        try
        {
            var data = await Api.GetAsync<List<DominioTenantDto>>($"api/DominiosTenant/tenant/{tenantId}");
            _items = data ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await Dialog.ShowAsync<DominioTenantDialog>("Agregar Dominio", OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadData();
    }
}