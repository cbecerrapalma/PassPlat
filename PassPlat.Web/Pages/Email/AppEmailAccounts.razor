@page "/email/app-accounts"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@using PassPlat.Web.Shared
@using PassPlat.Aplicacion.Dtos.Core
@using PassPlat.Aplicacion.Dtos.Catalogos

<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Cuentas por Aplicación</h1>
                <p class="page-subtitle">Cuentas de correo asignadas a cada aplicación.</p>
            </div>
            @* S101 · D4 — asignar cuentas a apps es del sistema (la API exige SystemOnly) *@
            @if (Auth.EsSistema)
            {
                <div class="page-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium"
                        Disabled="@(_idApp is null)" OnClick="@AbrirAsignar">
                        Asignar Cuenta
                    </MudButton>
                </div>
            }
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <MudSelect T="int?" Value="@_idApp" ValueChanged="@OnAppChanged" Label="Aplicación *" Variant="Variant.Outlined"
                    Class="lista-filtro" FullWidth="true" data-testid="app-accounts-app">
                    @foreach (var app in _apps)
                    {
                        <MudSelectItem T="int?" Value="@((int?)app.Id)">@app.Nombre</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_search" Class="lista-filtro" Label="Buscar..." Variant="Variant.Outlined" Immediate="true" Clearable="true" FullWidth="true" />
                <MudSelect T="bool?" @bind-Value="_activoFiltro" Class="lista-filtro" Label="Estado" Variant="Variant.Outlined" Clearable="true" FullWidth="true">
                    <MudSelectItem T="bool?" Value="@((bool?)true)">Activo</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@((bool?)false)">Inactivo</MudSelectItem>
                </MudSelect>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium" Class="mr-2" OnClick="@ReCargar" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    @if (_idApp is null)
    {
        <MudText Align="Align.Center" Class="py-6 mud-text-secondary">Selecciona una aplicación para ver sus cuentas.</MudText>
    }
    else
    {
        <MudTable T="AppEmailAccountDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_cargando">
            <ColGroup>
                <col />
                <col style="width: 140px;" />
                <col style="width: 110px;" />
                <col style="width: 100px;" />
                <col style="width: 80px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Cuenta de Correo</MudTh>
                <MudTh>Proveedor</MudTh>
                <MudTh>Predeterminada</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Cuenta"><MudText Typo="Typo.body2" Class="font-weight-medium">@NombreCuenta(context)</MudText></MudTd>
                <MudTd DataLabel="Proveedor"><MudChip T="string" Size="Size.Small" Color="Color.Info">@ProveedorDe(context.IdEmailAccount)</MudChip></MudTd>
                <MudTd DataLabel="Predeterminada">
                    <MudIcon Icon="@(context.EsPredeterminada ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                        Color="@(context.EsPredeterminada ? Color.Warning : Color.Default)" Size="Size.Small" />
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Default)">
                        @(context.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="">
                    @if (Auth.EsSistema)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Quitar"
                            OnClick="@(() => Quitar(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-6">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                    La aplicación no tiene cuentas asignadas
                </MudText>
            </NoRecordsContent>
        </MudTable>
    }
            </div>
        </div>
    </div>
</div>

@code {
    private List<AppDto> _apps = [];
    private List<EmailAccountDto> _cuentas = [];
    private List<EmailProviderDto> _providers = [];
    private List<AppEmailAccountDto> _items = [];
    private int? _idApp;
    private string _search = "";
    private bool? _activoFiltro;
    private bool _cargando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _apps = await Api.GetAsync<List<AppDto>>("api/apps") ?? [];
            _cuentas = await Api.GetAsync<List<EmailAccountDto>>("api/emailaccounts") ?? [];
            _providers = await Api.GetAsync<List<EmailProviderDto>>("api/emailproviders") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar catálogos: {ex.Message}", Severity.Error);
        }
    }

    private string NombreCuenta(AppEmailAccountDto fila) =>
        fila.EmailAccountNombre ?? _cuentas.FirstOrDefault(c => c.Id == fila.IdEmailAccount)?.Nombre ?? $"Cuenta {fila.IdEmailAccount}";

    // la lista de cuentas no trae ProviderNombre: se cruza por IdProvider con el catálogo de providers
    private string ProveedorDe(int idEmailAccount) =>
        _cuentas.FirstOrDefault(c => c.Id == idEmailAccount) is { } cuenta
            ? cuenta.ProviderNombre ?? _providers.FirstOrDefault(p => p.Id == cuenta.IdProvider)?.Nombre ?? "—"
            : "—";

    private List<AppEmailAccountDto> _itemsFiltrados
    {
        get
        {
            IEnumerable<AppEmailAccountDto> filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                filtrados = filtrados.Where(a => NombreCuenta(a).Contains(s, StringComparison.OrdinalIgnoreCase)
                    || ProveedorDe(a.IdEmailAccount).Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            if (_activoFiltro is bool activo)
                filtrados = filtrados.Where(a => a.Activo == activo);
            return filtrados.ToList();
        }
    }

    private async Task OnAppChanged(int? idApp)
    {
        _idApp = idApp;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _items = [];
        if (_idApp is null) return;
        _cargando = true;
        try
        {
            _items = await Api.GetAsync<List<AppEmailAccountDto>>($"api/appemailaccounts/app/{_idApp}") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar asignaciones: {ex.Message}", Severity.Error);
        }
        finally { _cargando = false; }
    }

    private async Task ReCargar()
    {
        await CargarDatos();
        Snackbar.Add("Asignaciones recargadas", Severity.Info);
    }

    private async Task AbrirAsignar()
    {
        if (_idApp is not int idApp) return;
        var parameters = new DialogParameters { ["IdApp"] = idApp };
        var dialog = await Dialog.ShowAsync<AssignAppDialog>("Asignar Cuenta a Aplicación", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await CargarDatos();
    }

    private async Task Quitar(AppEmailAccountDto fila)
    {
        var confirmar = await Dialog.ShowAsync<ConfirmDialog>("Quitar cuenta", new DialogParameters
        {
            ["Title"] = "Quitar cuenta",
            ["Message"] = $"¿Quitar la cuenta «{NombreCuenta(fila)}» de la aplicación?",
            ["ConfirmText"] = "Quitar",
            ["CancelText"] = "Cancelar"
        });
        if (await confirmar.Result is not { Canceled: false }) return;
        if (await Api.DeleteAsync($"api/appemailaccounts/{fila.Id}"))
        {
            Snackbar.Add("Cuenta quitada", Severity.Success);
            await CargarDatos();
        }
        else
            Snackbar.Add(Api.LastError ?? "Error al quitar la cuenta", Severity.Error);
    }
}
