@inject ApiClient Api
@inject ISnackbar Snackbar
@using PassPlat.Aplicacion.Dtos.Core

<MudDialog Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Link" Texto="Asignar a Tenant" />
    </TitleContent>

    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Cuenta de correo que usará el tenant seleccionado.</MudText>

            <MudSelect T="int" Label="Cuenta de correo *" Variant="Variant.Outlined" @bind-Value="_idCuenta" FullWidth="true" Required="true"
                RequiredError="Selecciona una cuenta"
                Validation="@(new Func<int, string?>(v => v == 0 ? "Selecciona una cuenta" : null))">
                @foreach (var c in _cuentas)
                {
                    <MudSelectItem Value="c.Id">@c.Nombre - @c.FromAddress</MudSelectItem>
                }
            </MudSelect>

            <div>
                <MudSwitch @bind-Value="_esPredet" Color="Color.Primary">Predeterminada para este tenant</MudSwitch>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Si no se marca, el tenant usará la cuenta predeterminada del sistema.</MudText>
            </div>
        </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Asignar" Guardando="@_guardando" OnClick="@Guardar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    /// <summary>Tenant elegido en la página (o el de la sesión); el diálogo no lo cambia.</summary>
    [Parameter] public int IdTenant { get; set; }

    private MudForm _form = null!;
    private List<EmailAccountDto> _cuentas = [];
    private int _idCuenta;
    private bool _esPredet;
    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cuentas = await Api.GetAsync<List<EmailAccountDto>>("api/emailaccounts/activos") ?? [];
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error al cargar cuentas: {ex.Message}";
        }
    }

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _guardando = true;
        try
        {
            var result = await Api.PostAsync<TenantEmailAccountDto>("api/tenantemailaccounts",
                new CrearTenantEmailAccountDto { IdTenant = IdTenant, IdEmailAccount = _idCuenta, EsPredeterminada = _esPredet });
            if (result is not null)
            {
                Snackbar.Add("Cuenta asignada al tenant", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al asignar la cuenta";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally { _guardando = false; }
    }
}
