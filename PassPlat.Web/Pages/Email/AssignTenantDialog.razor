@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Asignar a Tenant</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Vincula esta cuenta con un tenant especifico.</MudText>
    </TitleContent>

    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 d-flex align-center gap-3">
            <MudAvatar Color="Color.Primary" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.body2" Class="font-weight-medium">@AccountNombre</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Cuenta de correo</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mud-text-secondary mx-2" />
            <MudAvatar Color="Color.Secondary" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.body2" Class="font-weight-medium">@_selectedTenant</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tenant</MudText>
            </div>
        </MudPaper>

        <MudSelect T="string" Label="Tenant" Variant="Variant.Outlined" Value="@_selectedTenant"
            ValueChanged="@(EventCallback.Factory.Create<string>(this, (v) => _selectedTenant = v))" FullWidth="true" Class="mb-4">
            <MudSelectItem Value="@("Plataforma")">Plataforma (Sistema)</MudSelectItem>
            <MudSelectItem Value="@("Corp")">Corp</MudSelectItem>
            <MudSelectItem Value="@("Dev")">Dev</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="Cuenta de correo" Variant="Variant.Outlined" Value="@_selectedAccount" FullWidth="true" Class="mb-4">
            <MudSelectItem Value="@("SMTP Global")">SMTP Global - cbpnotificaciones@gmail.com</MudSelectItem>
            <MudSelectItem Value="@("SendGrid Transaccional")">SendGrid Transaccional - noreply@passplat.io</MudSelectItem>
            <MudSelectItem Value="@("Amazon SES Prod")">Amazon SES Prod - alerts@passplat.io</MudSelectItem>
            <MudSelectItem Value="@("MS Graph Corp")">MS Graph Corp - no-reply@corp.passplat.io</MudSelectItem>
            <MudSelectItem Value="@("Mailgun Marketing")">Mailgun Marketing - marketing@passplat.io</MudSelectItem>
        </MudSelect>

        <MudSwitch @bind-Value="_esPredet" Color="Color.Primary">Predeterminada para este tenant</MudSwitch>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Solo puede existir una cuenta predeterminada por tenant. La anterior sera reemplazada.</MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="@Submit">Asignar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string AccountNombre { get; set; } = "SMTP Global";

    private string _selectedTenant = "Corp";
    private string _selectedAccount = "SMTP Global";
    private bool _esPredet;

    private void Submit()
    {
        Snackbar.Add("Cuenta asignada a tenant visualmente", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
