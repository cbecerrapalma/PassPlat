@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.MailOutline)" Texto="@(IsEdit ? "Editar Cuenta de Correo" : "Nueva Cuenta de Correo")" />
    </TitleContent>

    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <div class="dialogo-seccion">Provider y datos generales</div>
            <div class="dialogo-fila">
                <MudSelect T="byte" Label="Provider *" Variant="Variant.Outlined" @bind-Value="_idProvider" FullWidth="true" Required="true"
                    RequiredError="Selecciona un provider"
                    Validation="@(new Func<byte, string?>(v => v == 0 ? "Selecciona un provider" : null))">
                    @foreach (var p in _providers)
                    {
                        <MudSelectItem Value="p.Id">@p.Nombre</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_nombre" Label="Nombre de la Cuenta" Variant="Variant.Outlined" FullWidth="true" Required="true"
                    RequiredError="El nombre es requerido"
                    HelperText="Ej: SMTP Gmail Principal" />
                <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" FullWidth="true" Class="dialogo-ancho"
                    HelperText="Opcional - propósito de la cuenta" />
            </div>

            <div class="dialogo-seccion">Configuración SMTP</div>
            <div class="dialogo-fila">
                <MudTextField @bind-Value="_host" Label="Host / Servidor" Variant="Variant.Outlined" FullWidth="true" Required="true"
                    RequiredError="El host es requerido"
                    HelperText="Ej: smtp.gmail.com" />
                <MudTextField @bind-Value="_puerto" Label="Puerto" Variant="Variant.Outlined" InputType="InputType.Number" FullWidth="true"
                    HelperText="Común: 25, 465 (SSL), 587 (TLS)" />
                <MudTextField @bind-Value="_usuario" Label="Usuario / Username" Variant="Variant.Outlined" autocomplete="off" FullWidth="true" Required="true" Class="dialogo-ancho"
                    RequiredError="El usuario es requerido" />
                <MudTextField @bind-Value="_password" Label="Contraseña / App Password" Variant="Variant.Outlined" autocomplete="new-password" InputType="InputType.Password" FullWidth="true" Class="dialogo-ancho"
                    Required="@(!IsEdit)"
                    RequiredError="La contraseña es requerida"
                    HelperText="@(IsEdit ? "Deja en blanco para mantener la existente" : "Se almacena encriptada con AES-256")" />
            </div>

            <div class="dialogo-seccion">Información del remitente</div>
            <div class="dialogo-fila">
                <MudTextField @bind-Value="_fromAddress" Label="From Address" Variant="Variant.Outlined" FullWidth="true" Required="true"
                    RequiredError="El remitente es requerido"
                    HelperText="Dirección que verán los destinatarios." />
                <MudTextField @bind-Value="_fromName" Label="From Name" Variant="Variant.Outlined" FullWidth="true"
                    HelperText="Nombre visible del remitente." />
            </div>

            <div class="dialogo-seccion">Seguridad y cifrado</div>
            <div class="dialogo-fila">
                <MudSwitch @bind-Value="_usaSSL" Color="Color.Primary">Usar SSL (puerto 465)</MudSwitch>
                <MudSwitch @bind-Value="_usaTLS" Color="Color.Primary">Usar TLS (STARTTLS, puerto 587)</MudSwitch>
                <MudSwitch @bind-Value="_esPredet" Color="Color.Primary" Class="dialogo-ancho">Marcar como cuenta predeterminada para el provider</MudSwitch>
            </div>
        </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_guardando" OnClick="@Guardar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public EmailAccountDto? Account { get; set; }

    private List<EmailProviderDto> _providers = [];
    private byte _idProvider;
    private string _nombre = "";
    private string _descripcion = "";
    private string _host = "";
    private int _puerto = 587;
    private string _usuario = "";
    private string _password = "";
    private string _fromAddress = "";
    private string _fromName = "";
    private bool _usaSSL;
    private bool _usaTLS = true;
    private bool _esPredet;
    private bool _guardando;
    private MudForm _form = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await Api.GetAsync<List<EmailProviderDto>>("api/emailproviders") ?? [];
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error al cargar providers: {ex.Message}";
        }

        if (IsEdit && Account is not null)
        {
            _idProvider = Account.IdProvider;
            _nombre = Account.Nombre;
            _descripcion = Account.Descripcion ?? "";
            _host = Account.Host;
            _puerto = Account.Puerto;
            _usuario = Account.SmtpUsuario;
            _fromAddress = Account.FromAddress;
            _fromName = Account.FromName ?? "";
            _usaSSL = Account.UsaSSL;
            _usaTLS = Account.UsaTLS;
            _esPredet = Account.EsPredeterminada;
        }
    }

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _guardando = true;
        try
        {
            if (IsEdit && Account is not null)
            {
                var dto = new ActualizarEmailAccountDto
                {
                    Nombre = _nombre,
                    Descripcion = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion,
                    Host = _host,
                    Puerto = _puerto,
                    SmtpUsuario = _usuario,
                    Password = string.IsNullOrWhiteSpace(_password) ? null : _password,
                    FromAddress = _fromAddress,
                    FromName = string.IsNullOrWhiteSpace(_fromName) ? null : _fromName,
                    UsaSSL = _usaSSL,
                    UsaTLS = _usaTLS,
                    EsPredeterminada = _esPredet,
                    Activo = true
                };
                var result = await Api.PutAsync<EmailAccountDto>($"api/emailaccounts/{Account.Id}", dto);
                if (result is not null)
                {
                    Snackbar.Add("Cuenta actualizada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar cuenta";
            }
            else
            {
                var dto = new CrearEmailAccountDto
                {
                    IdProvider = _idProvider,
                    Nombre = _nombre,
                    Descripcion = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion,
                    Host = _host,
                    Puerto = _puerto,
                    SmtpUsuario = _usuario,
                    Password = _password,
                    FromAddress = _fromAddress,
                    FromName = string.IsNullOrWhiteSpace(_fromName) ? null : _fromName,
                    UsaSSL = _usaSSL,
                    UsaTLS = _usaTLS,
                    EsPredeterminada = _esPredet
                };
                var result = await Api.PostAsync<EmailAccountDto>("api/emailaccounts", dto);
                if (result is not null)
                {
                    Snackbar.Add("Cuenta creada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear cuenta";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally { _guardando = false; }
    }
}
