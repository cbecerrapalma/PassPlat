@inject ApiClient Api
@inject ISnackbar Snackbar
@using PassPlat.Aplicacion.Dtos.Catalogos

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="provider-dialog dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(EsEdicion ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(EsEdicion ? "Editar Provider" : "Nuevo Provider")" />
    </TitleContent>

    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Tipo de proveedor de correo disponible en la plataforma.</MudText>

            <div class="dialogo-fila">
                @if (EsEdicion)
                {
                    <MudTextField Value="@Provider!.Codigo" Label="Código" Variant="Variant.Outlined" FullWidth="true" ReadOnly="true"
                                  HelperText="El código no se modifica." />
                }
                else
                {
                    <MudTextField @bind-Value="_codigo" Label="Código *" Variant="Variant.Outlined" FullWidth="true" MaxLength="20"
                                  Required="true" RequiredError="El código es requerido"
                                  HelperText="Identificador único; se guarda en mayúsculas." />
                }
                <MudTextField @bind-Value="_nombre" Label="Nombre *" Variant="Variant.Outlined" FullWidth="true" MaxLength="100"
                              Required="true" RequiredError="El nombre es requerido" />
                <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" FullWidth="true" Class="dialogo-ancho" MaxLength="200"
                              HelperText="Opcional." />
                @if (EsEdicion)
                {
                    <MudSwitch @bind-Value="_activo" Color="Color.Primary">Provider activo</MudSwitch>
                }
            </div>
        </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(EsEdicion ? "Guardar" : "Crear")" Guardando="@_guardando" OnClick="@Guardar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    /// <summary>Con valor, edita ese provider; sin él, da de alta uno nuevo.</summary>
    [Parameter] public EmailProviderDto? Provider { get; set; }

    private bool EsEdicion => Provider is not null;

    private MudForm _form = null!;
    private string _codigo = "";
    private string _nombre = "";
    private string _descripcion = "";
    private bool _activo = true;
    private bool _guardando;

    protected override void OnInitialized()
    {
        if (Provider is null) return;
        _nombre = Provider.Nombre;
        _descripcion = Provider.Descripcion ?? "";
        _activo = Provider.Activo;
    }

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _guardando = true;
        try
        {
            var descripcion = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim();
            var result = EsEdicion
                ? await Api.PutAsync<EmailProviderDto>($"api/emailproviders/{Provider!.Id}",
                    new ActualizarEmailProviderDto { Nombre = _nombre.Trim(), Descripcion = descripcion, Activo = _activo })
                : await Api.PostAsync<EmailProviderDto>("api/emailproviders",
                    new CrearEmailProviderDto { Codigo = _codigo.Trim(), Nombre = _nombre.Trim(), Descripcion = descripcion });
            if (result is not null)
            {
                Snackbar.Add(EsEdicion ? "Provider actualizado" : "Provider creado", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al guardar el provider";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally { _guardando = false; }
    }
}
