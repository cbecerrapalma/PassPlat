@page "/email/providers"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@using PassPlat.Web.Shared
@using PassPlat.Aplicacion.Dtos.Core
@using PassPlat.Aplicacion.Dtos.Catalogos

<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Providers de Correo</h1>
                <p class="page-subtitle">Proveedores de envío disponibles en la plataforma.</p>
            </div>
            @* S101 · D4 — el catálogo global solo lo escribe el sistema (la API exige SystemOnly) *@
            @if (Auth.EsSistema)
            {
                <div class="page-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium"
                        OnClick="@AbrirCrear" data-testid="providers-nuevo">
                        Nuevo Provider
                    </MudButton>
                </div>
            }
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium" Class="mr-2" OnClick="@ReCargar" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    @if (_cargando)
    {
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
    }
    else
    {
        <MudTable T="EmailProviderDto" Items="@_providers" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col style="width: 200px;" />
                <col />
                <col style="width: 100px;" />
                <col style="width: 100px;" />
                <col style="width: 80px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Provider</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh>Cuentas</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Provider">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Nombre</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Codigo</MudText>
                </MudTd>
                <MudTd DataLabel="Descripción"><MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Descripcion</MudText></MudTd>
                <MudTd DataLabel="Cuentas"><MudText Typo="Typo.body2" data-testid="provider-cuentas">@CuentasDe(context.Id)</MudText></MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Default)">
                        @(context.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="">
                    @if (Auth.EsSistema)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => AbrirEditar(context))" aria-label="Editar" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4 mud-text-secondary">Sin providers configurados</MudText>
            </NoRecordsContent>
        </MudTable>
    }
            </div>
        </div>
    </div>
</div>

@code {
    private List<EmailProviderDto> _providers = [];
    private Dictionary<byte, int> _cuentasPorProvider = [];
    private bool _cargando;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private int CuentasDe(byte idProvider) => _cuentasPorProvider.GetValueOrDefault(idProvider);

    private async Task CargarDatos()
    {
        _cargando = true;
        try
        {
            _providers = await Api.GetAsync<List<EmailProviderDto>>("api/emailproviders") ?? [];
            if (Auth.TienePermiso("EMAIL_ACCOUNTS_VER"))
            {
                var cuentas = await Api.GetAsync<List<EmailAccountDto>>("api/emailaccounts") ?? [];
                _cuentasPorProvider = cuentas.GroupBy(c => c.IdProvider).ToDictionary(g => g.Key, g => g.Count());
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar providers: {ex.Message}", Severity.Error);
        }
        finally { _cargando = false; }
    }

    private async Task ReCargar()
    {
        await CargarDatos();
        Snackbar.Add("Providers recargados", Severity.Info);
    }

    private async Task AbrirCrear()
    {
        var dialog = await Dialog.ShowAsync<ProviderDialog>("Nuevo Provider", OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await CargarDatos();
    }

    private async Task AbrirEditar(EmailProviderDto provider)
    {
        var parameters = new DialogParameters { ["Provider"] = provider };
        var dialog = await Dialog.ShowAsync<ProviderDialog>("Editar Provider", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await CargarDatos();
    }
}
