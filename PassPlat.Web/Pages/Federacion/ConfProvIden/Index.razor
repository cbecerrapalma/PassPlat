@page "/federacion/confproviden"
@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation

@if (!Auth.TienePermiso("FED_CONFPROVIDEN_VER"))
{
    <SinPermiso PermisoRequerido="FED_CONFPROVIDEN_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Configuración de Proveedores</h1>
                <p class="page-subtitle">Configura las credenciales y opciones por tenant para cada proveedor externo.</p>
            </div>
            @if (Auth.TienePermiso("FED_CONFPROVIDEN_EDITAR"))
            {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                Nueva Configuración
            </MudButton>
            }
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCount.ToString()" Label="Total Configs" Icon="@Icons.Material.Filled.Settings" ColorClass="primary" />
        <IamKpiCard Valor="@_activosCount.ToString()" Label="Activas" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_pendientesCount.ToString()" Label="Pendientes" Subtexto="Estado 0" Icon="@Icons.Material.Filled.HourglassEmpty" ColorClass="warning" />
        <IamKpiCard Valor="@_revocadosCount.ToString()" Label="Revocados" Subtexto="Estado 2" Icon="@Icons.Material.Filled.Block" ColorClass="error" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true"
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@Refrescar" ShowCreate="false" />
            <div class="table-wrap">
                <MudTable @ref="_table" T="ConfProvIdenDto" ServerData="@_serverReload" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm"
                    OnRowClick="@((TableRowClickEventArgs<ConfProvIdenDto> e) => VerDetalle(e.Item))" RowStyle="cursor: pointer;">
                    <ColGroup>
                        <col /><col /><col style="width:160px;" /><col style="width:100px;" /><col style="width:200px;" /><col style="width:140px;" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Tenant</MudTh><MudTh>Proveedor</MudTh><MudTh>Client ID</MudTh><MudTh>Estado</MudTh><MudTh>Login</MudTh><MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tenant">@(context.TenantNombre ?? $"#{context.IdTenant}")</MudTd>
                        <MudTd DataLabel="Proveedor">
                            <div class="col-name">@(context.ProvIdenNombre ?? $"#{context.IdProvIden}")</div>
                        </MudTd>
                        <MudTd DataLabel="Client ID" style="font-family:'JetBrains Mono',monospace;font-size:11px;">@context.ClientId</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="badge @_estadoClass(context.Activo ? context.Estado : (byte)0)">@_estadoNombre(context.Activo ? context.Estado : (byte)0)</span>
                        </MudTd>
                        <MudTd DataLabel="Login">
                            @if (context.MotivoNoDisponible is null)
                            {
                                <span class="badge @_estadoClass(1)">Visible en el login</span>
                            }
                            else
                            {
                                <span class="badge @_estadoClass(0)">@context.MotivoNoDisponible</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Acciones">
                            <div @onclick:stopPropagation="true" class="table-actions">
                                @if (Auth.TienePermiso("FED_CONFPROVIDEN_EDITAR"))
                                {
                                <MudTooltip Text="Editar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" aria-label="Editar" />
                                </MudTooltip>
                                @if (!context.Activo || context.Estado != 1)
                                {
                                <MudTooltip Text="Activar">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Success" OnClick="@(() => Activar(context))" aria-label="Activar" />
                                </MudTooltip>
                                }
                                else
                                {
                                <MudTooltip Text="Desactivar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDeactivate(context))" aria-label="Eliminar" />
                                </MudTooltip>
                                }
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="py-6">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                            No hay registros
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private MudTable<ConfProvIdenDto>? _table;
    private IEnumerable<ConfProvIdenDto> _items = [];
    private bool _loading;
    private string _searchString = "";
    private string _totalCount = "0";
    private int _activosCount;
    private int _pendientesCount;
    private int _revocadosCount;

    private async Task<TableData<ConfProvIdenDto>> _serverReload(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var response = await Api.GetAsync<PagedResponse<ConfProvIdenDto>>(
                $"api/confproviden/page?pageNumber={state.Page + 1}&pageSize={state.PageSize}&search={Uri.EscapeDataString(_searchString)}");
            if (response != null)
            {
                _items = response.Items;
                _totalCount = response.TotalCount.ToString();
                _activosCount = response.Items.Count(i => i.Estado == 1);
                _pendientesCount = response.Items.Count(i => i.Estado == 0);
                _revocadosCount = response.Items.Count(i => i.Estado == 2);
                return new TableData<ConfProvIdenDto> { Items = response.Items, TotalItems = response.TotalCount };
            }
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
        return new TableData<ConfProvIdenDto> { Items = [], TotalItems = 0 };
    }

    private async Task OnSearchChanged(string value)
    {
        _searchString = value;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task Refrescar()
    {
        if (_table is not null) await _table.ReloadServerData();
    }

    private void VerDetalle(ConfProvIdenDto? item)
    {
        if (item is not null) Navigation.NavigateTo($"/federacion/confproviden/{item.IdTenant}/{item.Id}");
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<ConfProvIdenDialog>("Nueva Configuración", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Amplio));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await Refrescar(); Snackbar.Add("Configuración creada", Severity.Success); }
    }

    private async Task OpenEditDialog(ConfProvIdenDto item)
    {
        var parameters = new DialogParameters { ["IsEdit"] = true, ["ConfProvIden"] = item };
        var dialog = await Dialog.ShowAsync<ConfProvIdenDialog>("Editar Configuración", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Amplio));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await Refrescar(); Snackbar.Add("Configuración actualizada", Severity.Success); }
    }

    private async Task ConfirmDeactivate(ConfProvIdenDto item)
    {
        var parameters = new DialogParameters { ["Title"] = "Confirmar", ["Message"] = $"Desactivar configuración para {item.ProvIdenNombre ?? $"#{item.IdProvIden}"}?", ["ConfirmText"] = "Si", ["CancelText"] = "Cancelar" };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.PostVoidAsync($"api/confproviden/{item.Id}/desactivar");
            if (ok) { Snackbar.Add("Configuración desactivada", Severity.Success); await Refrescar(); }
            else Snackbar.Add(Api.LastError ?? "Error al desactivar", Severity.Error);
        }
    }

    // S122 · D4 — reactiva una configuración desactivada
    private async Task Activar(ConfProvIdenDto item)
    {
        var ok = await Api.PostVoidAsync($"api/confproviden/{item.Id}/activar");
        if (ok) { Snackbar.Add("Configuración activada", Severity.Success); await Refrescar(); }
        else Snackbar.Add(Api.LastError ?? "Error al activar", Severity.Error);
    }

    private static string _estadoNombre(byte estado) => estado switch
    {
        0 => "Inactivo",
        1 => "Activo",
        2 => "Revocado",
        _ => "Desconocido"
    };

    private static string _estadoClass(byte estado) => estado switch
    {
        0 => "badge-warning",
        1 => "badge-active",
        2 => "badge-inactive",
        _ => "badge-inactive"
    };
}
