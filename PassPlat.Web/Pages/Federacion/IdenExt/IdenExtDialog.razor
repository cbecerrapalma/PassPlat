@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Link" Texto="Vincular Identidad Externa" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <div class="dialogo-fila">
                <MudSelect @bind-Value="_idTenant" Label="Tenant" Variant="Variant.Outlined" Required="true"
                            RequiredError="El tenant es requerido"
                            Validation="@(new Func<int, string?>(v => v == 0 ? "El tenant es requerido" : null))">
                    @foreach (var t in _tenants)
                    {
                        <MudSelectItem Value="t.Id">@t.Nombre (@t.Codigo)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="_idProvIden" Label="Proveedor" Variant="Variant.Outlined" Required="true"
                            RequiredError="El proveedor es requerido"
                            Validation="@(new Func<int, string?>(v => v == 0 ? "El proveedor es requerido" : null))">
                    @foreach (var p in _providers)
                    {
                        <MudSelectItem Value="p.Id">@p.Nombre (@p.Codigo)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudSelect @bind-Value="_idUsuario" Label="Usuario" Variant="Variant.Outlined" Required="true"
                        RequiredError="El usuario es requerido"
                        Validation="@(new Func<int, string?>(v => v == 0 ? "El usuario es requerido" : null))">
                @foreach (var u in _usuarios)
                {
                    <MudSelectItem Value="u.Id">@u.NomUsuario @(!string.IsNullOrEmpty(u.Email) ? $"({u.Email})" : "")</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_subExterno" Label="Sub (ID Externo)" Variant="Variant.Outlined" Required="true"
                          RequiredError="El ID externo es requerido" HelperText="Identificador único del usuario en el proveedor" />
            <div class="dialogo-fila">
                <MudTextField @bind-Value="_providerUserName" Label="Provider UserName" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_emailExterno" Label="Email Externo" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_nombreExterno" Label="Nombre Externo" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_avatar" Label="Avatar URL" Variant="Variant.Outlined" />
            </div>
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Asignar" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }

    private List<TenantDto> _tenants = [];
    private List<ProvIdenDto> _providers = [];
    private List<UsuarioDto> _usuarios = [];
    private int _idTenant = 1;
    private int _idUsuario;
    private int _idProvIden;
    private string _subExterno = "";
    private string? _providerUserName;
    private string? _emailExterno;
    private string? _nombreExterno;
    private string? _avatar;
    private bool _saving;
    private MudForm _form = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenants = (await Api.GetAsync<List<TenantDto>>("api/tenants")) ?? [];
            _providers = (await Api.GetAsync<List<ProvIdenDto>>("api/providen/activos")) ?? [];
            _usuarios = (await Api.GetAsync<List<UsuarioDto>>("api/usuarios")) ?? [];
        }
        catch { }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            var result = await Api.PostAsync<IdenExtDto>("api/iden-ext",
                new { idTenant = _idTenant, idUsuario = _idUsuario, idProvIden = _idProvIden,
                    subExterno = _subExterno, providerUserName = _providerUserName,
                    emailExterno = _emailExterno, nombreExterno = _nombreExterno, avatar = _avatar });
            if (result is not null)
            {
                Snackbar.Add("Identidad vinculada", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al vincular";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
