@page "/federacion/iden-ext"
@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation

@if (!Auth.TienePermiso("FED_IDENEXT_VER"))
{
    <SinPermiso PermisoRequerido="FED_IDENEXT_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Identidades Externas</h1>
                <p class="page-subtitle">Vinculación de usuarios locales con cuentas de proveedores de identidad externa.</p>
            </div>
            @if (Auth.TienePermiso("FED_IDENEXT_DESVINCULAR"))
            {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                Vincular Identidad
            </MudButton>
            }
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCount.ToString()" Label="Total Vínculos" Icon="@Icons.Material.Filled.Link" ColorClass="primary" />
        <IamKpiCard Valor="@_activosCount.ToString()" Label="Activos" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_inactivosCount.ToString()" Label="Inactivos" Subtexto="Desvinculados" Icon="@Icons.Material.Filled.LinkOff" ColorClass="warning" />
        <IamKpiCard Valor="@_conMFA.ToString()" Label="Con MFA" Subtexto="Tienen MFA activo" Icon="@Icons.Material.Filled.Fingerprint" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true" SearchLabel="Buscar identidad externa..."
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@Refrescar" ShowCreate="false">
                <Filtros>
                    <MudSelect T="int?" Value="_idProveedor" ValueChanged="@OnProveedorChanged" Label="Proveedor"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        @foreach (var p in _proveedores)
                        {
                            <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
                <MudTable @ref="_table" T="IdenExtDto" ServerData="@_serverReload" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm"
                    OnRowClick="@((TableRowClickEventArgs<IdenExtDto> e) => VerDetalle(e.Item))" RowStyle="cursor: pointer;">
                    <ColGroup>
                        <col /><col /><col /><col style="width:120px;" /><col style="width:140px;" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Usuario</MudTh><MudTh>Proveedor</MudTh><MudTh>Email Externo</MudTh><MudTh>Estado</MudTh><MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Usuario">
                            <div class="col-name">@(context.UsuarioNombre ?? $"#{context.IdUsuario}")</div>
                            <div style="font-size:10px;color:var(--text-muted);">@context.ProviderUserName</div>
                        </MudTd>
                        <MudTd DataLabel="Proveedor">
                            <div>@(context.ProvIdenNombre ?? $"#{context.IdProvIden}")</div>
                            <div style="font-size:10px;color:var(--text-muted);">@context.SubExterno</div>
                        </MudTd>
                        <MudTd DataLabel="Email Externo">@(context.EmailExterno ?? "—")</MudTd>
                        <MudTd DataLabel="Estado">
                            @if (!string.IsNullOrEmpty(context.EstadoNombre))
                            {
                                <span class="badge badge-active" style="background: @(context.EstadoColor ?? "var(--dat-verde)")22;color: @(context.EstadoColor ?? "var(--dat-verde)");border:1px solid @(context.EstadoColor ?? "var(--dat-verde)")44;">
                                    <span class="badge-dot" style="background:@(context.EstadoColor ?? "var(--dat-verde)");"></span>@context.EstadoNombre
                                </span>
                            }
                            else
                            {
                                <span class="badge @(context.Activo ? "badge-active" : "badge-inactive")">
                                    <span class="badge-dot"></span>@(context.Activo ? "Activo" : "Inactivo")
                                </span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Acciones">
                            <div @onclick:stopPropagation="true" class="table-actions">
                                @if (Auth.TienePermiso("FED_IDENEXT_DESVINCULAR"))
                                {
                                <MudTooltip Text="Desvincular">
                                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmUnlink(context))" aria-label="Desvincular" />
                                </MudTooltip>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="py-6">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                            No hay identidades externas vinculadas
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private MudTable<IdenExtDto>? _table;
    private IEnumerable<IdenExtDto> _items = [];
    private bool _loading;
    private string _searchString = "";
    private string _totalCount = "0";
    private int _totalDesdeApi;
    private int _activosCount;
    private int _inactivosCount;
    private int _conMFA;
    private int? _idProveedor;
    private List<(int Id, string Nombre)> _proveedores = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("FED_IDENEXT_VER")) return; // S114 · D3
        try
        {
            var response = await Api.GetAsync<PagedResponse<IdenExtDto>>("api/iden-ext/page?pageNumber=1&pageSize=200");
            _totalDesdeApi = response?.TotalCount ?? 0;
            _totalCount = _totalDesdeApi.ToString();
            if (response != null)
            {
                _activosCount = response.Items.Count(i => i.Activo);
                _inactivosCount = response.Items.Count(i => !i.Activo);
                _conMFA = 0;
                // S85 · D4 — proveedores para el filtro, a partir de la carga de KPIs
                _proveedores = response.Items
                    .Where(i => !string.IsNullOrWhiteSpace(i.ProvIdenNombre))
                    .GroupBy(i => i.IdProvIden)
                    .Select(g => (Id: g.Key, Nombre: g.First().ProvIdenNombre!))
                    .OrderBy(p => p.Nombre)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar total: {ex.Message}", Severity.Error);
        }
    }

    private async Task<TableData<IdenExtDto>> _serverReload(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            // S85 · D4 — la API ya aplica TextoLibre e IdProveedor (antes la página no los mandaba)
            var textoParam = string.IsNullOrWhiteSpace(_searchString) ? "" : $"&TextoLibre={Uri.EscapeDataString(_searchString.Trim())}";
            var proveedorParam = _idProveedor is int idProv ? $"&IdProveedor={idProv}" : "";
            var response = await Api.GetAsync<PagedResponse<IdenExtDto>>(
                $"api/iden-ext/page?pageNumber={state.Page + 1}&pageSize={state.PageSize}{textoParam}{proveedorParam}");
            if (response != null)
            {
                _items = response.Items;
                _activosCount = response.Items.Count(i => i.Activo);
                _inactivosCount = response.Items.Count(i => !i.Activo);
                _totalCount = response.TotalCount.ToString();
                return new TableData<IdenExtDto> { Items = response.Items, TotalItems = response.TotalCount };
            }
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
        return new TableData<IdenExtDto> { Items = [], TotalItems = 0 };
    }

    private async Task OnSearchChanged(string value)
    {
        _searchString = value;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task OnProveedorChanged(int? idProveedor)
    {
        _idProveedor = idProveedor;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task Refrescar()
    {
        if (_table is not null) await _table.ReloadServerData();
        try
        {
            var response = await Api.GetAsync<PagedResponse<IdenExtDto>>("api/iden-ext/page?pageNumber=1&pageSize=200");
            _totalDesdeApi = response?.TotalCount ?? 0;
            _totalCount = _totalDesdeApi.ToString();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar total: {ex.Message}", Severity.Error);
        }
    }

    private void VerDetalle(IdenExtDto? item)
    {
        if (item is not null) Navigation.NavigateTo($"/federacion/iden-ext/{item.IdUsuario}/{item.Id}");
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<IdenExtDialog>("Vincular Identidad", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await Refrescar(); Snackbar.Add("Identidad vinculada", Severity.Success); }
    }

    private async Task ConfirmUnlink(IdenExtDto item)
    {
        var parameters = new DialogParameters { ["Title"] = "Confirmar", ["Message"] = $"Desvincular identidad de {item.ProvIdenNombre ?? $"#{item.IdProvIden}"} para {item.UsuarioNombre ?? $"#{item.IdUsuario}"}?", ["ConfirmText"] = "Si", ["CancelText"] = "Cancelar" };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.PostVoidAsync($"api/iden-ext/{item.Id}/desvincular");
            if (ok) { Snackbar.Add("Identidad desvinculada", Severity.Success); await Refrescar(); }
            else Snackbar.Add(Api.LastError ?? "Error al desvincular", Severity.Error);
        }
    }
}
