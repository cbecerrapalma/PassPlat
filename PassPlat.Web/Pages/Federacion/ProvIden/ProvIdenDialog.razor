@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Amplio)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Visibility" Texto="Detalle del Proveedor" />
    </TitleContent>
    <DialogContent>
        @if (_cargado)
        {
            <div class="dialogo-campos">
                <div class="readonly-grid">
                    <div class="readonly-item"><div class="field-label">Código</div><div class="field-value mono">@_provIden.Codigo</div></div>
                    <div class="readonly-item"><div class="field-label">Nombre</div><div class="field-value">@_provIden.Nombre</div></div>
                    <div class="readonly-item"><div class="field-label">Versión</div><div class="field-value">@(!string.IsNullOrEmpty(_provIden.Version) ? _provIden.Version : "—")</div></div>
                    <div class="readonly-item"><div class="field-label">Protocolo</div><div class="field-value"><MudChip T="string" Size="Size.Small" Color="Color.Primary">OAuth</MudChip></div></div>
                </div>

                <div class="dialogo-seccion">Endpoints</div>
                <div class="readonly-grid">
                    <div class="readonly-item"><div class="field-label">Autorización</div><div class="field-value mono small-text">@(!string.IsNullOrEmpty(_provIden.EndpointAutorizacion) ? _provIden.EndpointAutorizacion : "—")</div></div>
                    <div class="readonly-item"><div class="field-label">Token</div><div class="field-value mono small-text">@(!string.IsNullOrEmpty(_provIden.EndpointToken) ? _provIden.EndpointToken : "—")</div></div>
                    <div class="readonly-item"><div class="field-label">UserInfo</div><div class="field-value mono small-text">@(!string.IsNullOrEmpty(_provIden.EndpointUserInfo) ? _provIden.EndpointUserInfo : "—")</div></div>
                    <div class="readonly-item"><div class="field-label">Revocación</div><div class="field-value mono small-text">@(!string.IsNullOrEmpty(_provIden.EndpointRevocacion) ? _provIden.EndpointRevocacion : "—")</div></div>
                </div>

                <div class="dialogo-seccion">Capacidades</div>
                <div class="readonly-grid">
                    <div class="readonly-item"><div class="field-label">PKCE</div><div class="field-value"><MudIcon Icon="@(_provIden.SoportaPKCE ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" Size="Size.Small" Color="@(_provIden.SoportaPKCE ? Color.Success : Color.Error)" /></div></div>
                    <div class="readonly-item"><div class="field-label">Refresh Token</div><div class="field-value"><MudIcon Icon="@(_provIden.SoportaRefreshToken ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" Size="Size.Small" Color="@(_provIden.SoportaRefreshToken ? Color.Success : Color.Error)" /></div></div>
                    <div class="readonly-item"><div class="field-label">MFA</div><div class="field-value"><MudIcon Icon="@(_provIden.SoportaMFA ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" Size="Size.Small" Color="@(_provIden.SoportaMFA ? Color.Success : Color.Error)" /></div></div>
                    <div class="readonly-item"><div class="field-label">Icono</div><div class="field-value">@(!string.IsNullOrEmpty(_provIden.Icono) ? _provIden.Icono : "—")</div></div>
                    <div class="readonly-item"><div class="field-label">Orden</div><div class="field-value">@_provIden.Orden</div></div>
                    <div class="readonly-item"><div class="field-label">Activo</div><div class="field-value"><MudChip T="string" Size="Size.Small" Color="@(_provIden.Activo ? Color.Success : Color.Error)">@(_provIden.Activo ? "Sí" : "No")</MudChip></div></div>
                    <div class="readonly-item"><div class="field-label">Creado</div><div class="field-value">@(_provIden.FecCrea?.ToString("dd MMM yyyy HH:mm") ?? "—")</div></div>
                </div>

                @if (!string.IsNullOrEmpty(_provIden.Metadata))
                {
                    <div class="dialogo-seccion">Metadata</div>
                    <pre class="metadata-json">@_provIden.Metadata</pre>
                }
            </div>
        }
        else
        {
            <MudSkeleton Width="100%" Height="300px" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Cancel())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ProvIdenDto ProvIden { get; set; } = null!;

    private ProvIdenDto _provIden = null!;
    private bool _cargado;

    protected override void OnInitialized()
    {
        _provIden = ProvIden;
        _cargado = _provIden is not null;
    }
}
