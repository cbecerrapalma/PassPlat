@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.PersonAdd" Texto="Agregar Miembro a Grupo" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudText Typo="Typo.caption" Class="text-secondary d-block">
                Agrega un usuario al grupo <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">@Grupo?.Nombre</MudChip>
            </MudText>

            <MudTextField @bind-Value="_busqueda" Label="Buscar usuario..." Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                Immediate="true" Clearable="true" />

            <MudSelect T="UsuarioDto" Label="Usuario" @bind-Value="_usuarioSeleccionado" Required="true"
                Variant="Variant.Outlined" ToStringFunc="@(u => u?.NomUsuario ?? string.Empty)"
                RequiredError="Selecciona un usuario"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
                @foreach (var u in _usuariosFiltrados)
                {
                    <MudSelectItem Value="u">
                        <div class="d-flex align-center" style="gap:8px;">
                            <MudAvatar Size="Size.Small" Color="Color.Info">
                                <MudText Typo="Typo.caption">@(u.Nombre[..Math.Min(2, u.Nombre.Length)])</MudText>
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@u.Nombre @u.Apellido</MudText>
                                <MudText Typo="Typo.caption" Class="text-secondary">@u.NomUsuario · @u.Email</MudText>
                            </div>
                        </div>
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Agregar" TextoGuardando="Agregando…" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public GrupoDto? Grupo { get; set; }

    private List<UsuarioDto> _usuarios = [];
    private UsuarioDto? _usuarioSeleccionado;
    private string _busqueda = "";
    private bool _saving;
    private MudForm _form = null!;

    private List<UsuarioDto> _usuariosFiltrados =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? _usuarios
            : _usuarios.Where(u =>
                u.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Apellido.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.NomUsuario.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                (u.Email?.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // S93 · D3 — los miembros activos del tenant del grupo (UsuarioTenant), el mismo criterio que valida AgregarMiembroAsync; un no-sistema queda en su tenant.
            var pagina = await Api.GetAsync<PagedResponse<UsuarioDto>>($"api/usuarios/page?pageNumber=1&pageSize=100&miembroDe={Grupo!.IdTenant}");
            _usuarios = pagina?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error al cargar usuarios: {ex.Message}";
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _usuarioSeleccionado is null) return;

        _saving = true;
        try
        {
            var dto = new CrearGrupoUsuarioDto
            {
                IdGrupo = Grupo!.Id,
                IdUsuario = _usuarioSeleccionado.Id
            };
            var result = await Api.PostAsync<GrupoUsuarioDto>("api/GruposUsuarios", dto);
            if (result is not null)
            {
                Snackbar.Add($"Miembro {_usuarioSeleccionado.NomUsuario} agregado al grupo", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al agregar miembro";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
