@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
            </MudAvatar>
            <MudText Typo="Typo.h6">Agregar Miembro a Grupo</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="text-secondary mb-2 d-block">
            Agregue un usuario al grupo <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">@Grupo?.Nombre</MudChip>
        </MudText>

        <MudTextField @bind-Value="_busqueda" Label="Buscar usuario..." Variant="Variant.Outlined" Class="mb-3"
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
            Immediate="true" Clearable="true" />

        <MudSelect T="UsuarioDto" Label="Usuario" @bind-Value="_usuarioSeleccionado" Required="true"
            Variant="Variant.Outlined" Class="mb-3" ToStringFunc="@(u => u?.NomUsuario ?? string.Empty)"
            Error="@(_submitted && _usuarioSeleccionado is null)" ErrorText="Seleccione un usuario"
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
            @foreach (var u in _usuariosFiltrados)
            {
                <MudSelectItem Value="u">
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudAvatar Size="Size.Small" Color="Color.Info">
                            <MudText Typo="Typo.caption">@(u.Nombre[..Math.Min(2, u.Nombre.Length)])</MudText>
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@u.Nombre @u.Apellido</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@u.NomUsuario · @u.Email</MudText>
                        </div>
                    </div>
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@(_usuarioSeleccionado is null || _saving)">
            @(_saving ? "Agregando..." : "Agregar Miembro")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private DialogOptions _dialogOptions = new() { FullWidth = true, CloseButton = true };

    [Parameter] public GrupoDto? Grupo { get; set; }

    private List<UsuarioDto> _usuarios = [];
    private UsuarioDto? _usuarioSeleccionado;
    private string _busqueda = "";
    private bool _saving;
    private bool _submitted;

    private List<UsuarioDto> _usuariosFiltrados =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? _usuarios
            : _usuarios.Where(u =>
                u.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Apellido.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.NomUsuario.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _usuarios = await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar usuarios: {ex.Message}", Severity.Error);
        }
    }

    private async Task Save()
    {
        _submitted = true;
        if (_usuarioSeleccionado is null) return;

        _saving = true;
        try
        {
            var dto = new CrearGrupoUsuarioDto
            {
                IdGrupo = Grupo!.Id,
                IdUsuario = _usuarioSeleccionado.Id
            };
            var result = await Api.PostAsync<GrupoUsuarioDto>("api/GruposUsuarios", dto);
            if (result is not null)
            {
                Snackbar.Add($"Miembro {_usuarioSeleccionado.NomUsuario} agregado al grupo", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al agregar miembro", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
