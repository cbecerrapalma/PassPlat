@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Group)" Texto="@(IsEdit ? "Editar Grupo" : "Nuevo Grupo")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Required="true"
                Disabled="IsEdit"
                RequiredError="El código es requerido"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Code"
                HelperText="Identificador único del grupo" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" Required="true"
                RequiredError="El nombre es requerido"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                HelperText="Nombre descriptivo del grupo" />
            <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description"
                HelperText="Opcional - propósito del grupo" />
            @if (IsEdit)
            {
                <MudSwitch @bind-Value="_activo" Label="Grupo activo" Color="Color.Primary" />
            }
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public GrupoDto? Grupo { get; set; }

    private string _codigo = "";
    private string _nombre = "";
    private string _descripcion = "";
    private bool _activo = true;
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        if (IsEdit && Grupo is not null)
        {
            _codigo = Grupo.Codigo;
            _nombre = Grupo.Nombre;
            _descripcion = Grupo.Descripcion ?? "";
            _activo = Grupo.Activo;
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit && Grupo is not null)
            {
                var dto = new ActualizarGrupoDto { Nombre = _nombre, Descripcion = _descripcion, Activo = _activo };
                var result = await Api.PutAsync<GrupoDto>($"api/grupos/{Grupo.Id}", dto);
                if (result is not null) { Snackbar.Add("Grupo actualizado", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
                else _errorServidor = Api.LastError ?? "Error al actualizar grupo";
            }
            else
            {
                var dto = new CrearGrupoDto { Codigo = _codigo, Nombre = _nombre, Descripcion = _descripcion };
                var result = await Api.PostAsync<GrupoDto>("api/grupos", dto);
                if (result is not null) { Snackbar.Add("Grupo creado", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
                else _errorServidor = Api.LastError ?? "Error al crear grupo";
            }
        }
        catch (Exception ex) { _errorServidor = Api.LastError ?? $"Error: {ex.Message}"; }
        finally { _saving = false; }
    }
}
