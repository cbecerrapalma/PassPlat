@page "/historial-pwd"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("HISTORIALPWD_VER"))
{
    <SinPermiso PermisoRequerido="HISTORIALPWD_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Historial de Contraseñas</h1>
                <p class="page-subtitle">Contraseñas anteriores de cada usuario y cambios forzados.</p>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCountStr" Label="Total" Subtexto="Registros en sistema" Icon="@Icons.Material.Filled.History" ColorClass="primary" />
        <IamKpiCard Valor="@_actualesStr" Label="Actuales" Subtexto="Passwords vigentes" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_forzadosStr" Label="Forzados" Subtexto="Cambio obligatorio" Icon="@Icons.Material.Filled.Warning" ColorClass="warning" />
        <IamKpiCard Valor="@_usuariosStr" Label="Usuarios" Subtexto="Con historial registrado" Icon="@Icons.Material.Filled.People" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true" SearchLabel="Buscar usuario..."
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@Refrescar" ShowCreate="false">
                <Filtros>
                    <MudSelect T="bool?" Value="_actualFiltro" ValueChanged="@OnActualChanged" Label="Actual"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Actuales</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Anteriores</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="bool?" Value="_forzadoFiltro" ValueChanged="@OnForzadoChanged" Label="Forzado"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Forzados</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">No forzados</MudSelectItem>
                    </MudSelect>
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
    <MudTable T="HistorialPwdDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm">
        <ColGroup>
            <col style="width: 80px;" /><col /><col /><col style="width: 100px;" /><col style="width: 100px;" /><col style="width: 160px;" /><col style="width: 160px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh><MudTh>Usuario</MudTh><MudTh>Algoritmo</MudTh><MudTh>Es Actual</MudTh><MudTh>Es Forzado</MudTh><MudTh>Fec. Registro</MudTh><MudTh>Fec. Expira</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Usuario">@context.UsuarioNombre</MudTd>
            <MudTd DataLabel="Algoritmo">@context.Algoritmo</MudTd>
            <MudTd DataLabel="Es Actual">
                <MudChip T="string" Size="Size.Small" Color="@(context.EsActual ? Color.Success : Color.Default)">
                    @(context.EsActual ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Es Forzado">
                <MudChip T="string" Size="Size.Small" Color="@(context.EsForzado ? Color.Warning : Color.Default)">
                    @(context.EsForzado ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Fec. Registro">@context.FecRegistro?.ToString("g")</MudTd>
            <MudTd DataLabel="Fec. Expira">@context.FecExpira?.ToString("g")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<HistorialPwdDto> _items = [];
    private bool _loading;
    private int _totalCount;
    private string _totalCountStr = "0";
    private string _actualesStr = "0";
    private string _forzadosStr = "0";
    private string _usuariosStr = "0";
    private string _searchString = "";
    private bool? _actualFiltro;
    private bool? _forzadoFiltro;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("HISTORIALPWD_VER")) return;
        await LoadKpis();
    }

    // S85 · D4 — buscador, actual y forzado se aplican en memoria sobre la lista cargada
    private List<HistorialPwdDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                filtrados = filtrados.Where(h =>
                    (h.UsuarioNombre ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (_actualFiltro is bool actual)
                filtrados = filtrados.Where(h => h.EsActual == actual).ToList();
            if (_forzadoFiltro is bool forzado)
                filtrados = filtrados.Where(h => h.EsForzado == forzado).ToList();
            return filtrados;
        }
    }

    private void OnSearchChanged(string value)
    {
        _searchString = value;
        StateHasChanged();
    }

    private void OnActualChanged(bool? actual)
    {
        _actualFiltro = actual;
        StateHasChanged();
    }

    private void OnForzadoChanged(bool? forzado)
    {
        _forzadoFiltro = forzado;
        StateHasChanged();
    }

    private async Task LoadKpis()
    {
        _loading = true;
        try
        {
            var data = await Api.GetAsync<List<HistorialPwdDto>>("api/historialpwd");
            if (data is not null)
            {
                _items = data;
                _totalCount = data.Count;
                _totalCountStr = _totalCount.ToString();
                _actualesStr = data.Count(h => h.EsActual).ToString();
                _forzadosStr = data.Count(h => h.EsForzado).ToString();
                _usuariosStr = data.Select(h => h.IdUsuario).Distinct().Count().ToString();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar KPIs: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task Refrescar()
    {
        await LoadKpis();
    }
}
