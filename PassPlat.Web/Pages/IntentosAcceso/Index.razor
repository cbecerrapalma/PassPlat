@page "/intentos-acceso"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("INTENTOSACCESO_VER"))
{
    <SinPermiso PermisoRequerido="INTENTOSACCESO_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Intentos de Acceso</h1>
                <p class="page-subtitle">Intentos de inicio de sesión exitosos y fallidos por usuario.</p>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <div>
            <IamKpiCard Label="Total Intentos" Valor="@KpiTotal" Icon="@Icons.Material.Filled.Login" ColorClass="info" />
        </div>
        <div>
            <IamKpiCard Label="Exitosos" Valor="@KpiExitosos" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        </div>
        <div>
            <IamKpiCard Label="Fallidos" Valor="@KpiFallidos" Icon="@Icons.Material.Filled.Cancel" ColorClass="error" />
        </div>
        <div>
            <IamKpiCard Label="Usuarios" Valor="@KpiUsuarios" Icon="@Icons.Material.Filled.Person" ColorClass="primary" />
        </div>
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <MudTextField @bind-Value="_search" Class="lista-filtro" Label="Buscar usuario..." Variant="Variant.Outlined" Immediate="true" Clearable="true" />
                <MudSelect T="string" @bind-Value="_filterResultado" Class="lista-filtro" Label="Resultado" Variant="Variant.Outlined" Dense="true" Clearable="true">
                    <MudSelectItem Value="@("Exitoso")">Exitoso</MudSelectItem>
                    <MudSelectItem Value="@("Fallido")">Fallido</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@LoadData">Buscar</MudButton>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium" OnClick="@LoadData" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudDataGrid T="IntentoAccesoDto" Items="@_filteredItems" Hover="true" Dense="false"
        Filterable="false" SortMode="SortMode.None" Groupable="false" MultiSelection="false"
        ShowColumnOptions="false">
        <Columns>
            <HierarchyColumn T="IntentoAccesoDto" />
            <TemplateColumn T="IntentoAccesoDto" Title="Id" HeaderStyle="width:80px;">
                <CellTemplate>@context.Item.Id</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="Usuario">
                <CellTemplate>@context.Item.NomUsuarioIntentado</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="Resultado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.Exitoso ? Color.Success : Color.Error)">
                        @context.Item.ResultadoNombre
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="IP">
                <CellTemplate>@context.Item.IPDireccion</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="Detalle">
                <CellTemplate>@context.Item.DetResultado</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="Respuesta" HeaderStyle="width:100px;">
                <CellTemplate>@(context.Item.TpoRespuesta.HasValue ? $"{context.Item.TpoRespuesta}ms" : "-")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="IntentoAccesoDto" Title="Fecha" HeaderStyle="width:160px;">
                <CellTemplate>@context.Item.FecIntento.ToString("g")</CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <div class="pa-4">
                @foreach (var (prop, valor) in _detalleTecnico(context.Item))
                {
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width:140px;">@prop:</MudText>
                        <MudText Typo="Typo.body2">@valor</MudText>
                    </div>
                }
            </div>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<IntentoAccesoDto> _items = [];
    private List<IntentoAccesoDto> _filteredItems
    {
        get
        {
            var q = _items.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(i => i.NomUsuarioIntentado.Contains(_search, StringComparison.OrdinalIgnoreCase) || (i.IPDireccion?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));
            if (_filterResultado == "Exitoso") q = q.Where(i => i.Exitoso);
            if (_filterResultado == "Fallido") q = q.Where(i => !i.Exitoso);
            return q.ToList();
        }
    }
    private bool _loading;
    private string _search = "";
    private string? _filterResultado;

    private string KpiTotal => _items.Count.ToString();
    private string KpiExitosos => _items.Count(i => i.Exitoso).ToString();
    private string KpiFallidos => _items.Count(i => !i.Exitoso).ToString();
    private string KpiUsuarios => _items.Select(i => i.NomUsuarioIntentado).Distinct().Count().ToString();

    private List<(string, string)> _detalleTecnico(IntentoAccesoDto item) =>
    [
        ("Exitoso", item.Exitoso ? "Sí" : "No"),
        ("Tpo. Respuesta", item.TpoRespuesta.HasValue ? $"{item.TpoRespuesta}ms" : "-"),
        ("Código Respuesta", item.CodRespuesta?.ToString() ?? "-"),
        ("Id Dispositivo", item.IdDisp?.ToString() ?? "-"),
        ("Id Agente", item.IdAgente?.ToString() ?? "-"),
        ("Id IP", item.IdIP?.ToString() ?? "-"),
        ("Id App", item.IdApp?.ToString() ?? "-")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("INTENTOSACCESO_VER")) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var idTenant = Auth.IdTenant ?? 0;
            var tenantSuffix = idTenant > 0 ? $"&idTenant={idTenant}" : "";
            var response = await Api.GetAsync<PagedResponse<IntentoAccesoDto>>($"api/intentosacceso/page?pageNumber=1&pageSize=500{tenantSuffix}");
            _items = response?.Items?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
