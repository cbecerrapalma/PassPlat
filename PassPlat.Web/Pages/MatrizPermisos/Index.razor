@page "/admin/matriz-permisos"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject AuthService Auth
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("MATRIZ_PERMISOS_VER"))
{
    <SinPermiso PermisoRequerido="MATRIZ_PERMISOS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Matriz de Permisos</h1>
                <p class="page-subtitle">Permisos por rol y modulo. Solo lectura: la asignacion se hace en «Roles y Permisos».</p>
            </div>
        </div>
    </div>

    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        Elija un rol para ver sus permisos. Los permisos heredados se muestran con borde discontinuo.
    </MudAlert>

    <div class="matrix-toolbar">
        <MudPaper Elevation="0" Outlined="true" Class="matrix-role-panel">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Rol</MudText>
            @if (_roles.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No hay roles para mostrar.</MudText>
            }
            else
            {
                <div class="matrix-role-list">
                    @foreach (var grupo in _rolesAgrupados)
                    {
                        <div class="matrix-role-group" @key="@($"g-{grupo.Titulo}")">
                            <div class="matrix-role-group-title">@grupo.Titulo</div>
                            @foreach (var r in grupo.Roles)
                            {
                                var seleccionado = r.Id == _idRolSeleccionado;
                                <button type="button" class="matrix-role-item @(seleccionado ? "is-selected" : "")"
                                    @key="@($"r-{r.Id}")"
                                    @onclick="@(() => OnRolElegido(r.Id))"
                                    aria-pressed="@(seleccionado ? "true" : "false")"
                                    title="@($"{r.Nombre} ({r.Codigo}) — {AmbitoDe(r)}")">
                                    <span class="matrix-role-name">@r.Nombre</span>
                                    <span class="matrix-role-code">@r.Codigo</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="matrix-filters">
            <div class="matrix-filters-row">
                <MudTextField T="string" Value="_busqueda" ValueChanged="@(v => { _busqueda = v; RecalcularVisibles(); })"
                    Immediate="true" Placeholder="Buscar permiso por nombre o codigo" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                    Margin="Margin.Dense" Clearable="true" aria-label="Buscar permiso por nombre o codigo" />

                <MudSwitch T="bool" Value="_soloAsignados" ValueChanged="@(v => { _soloAsignados = v; RecalcularVisibles(); })"
                    Color="Color.Primary" Label="Solo asignados" Disabled="@(_idRolSeleccionado <= 0)" />

                <MudSwitch T="bool" Value="_verTodos" ValueChanged="@(v => { _verTodos = v; RecalcularVisibles(); })"
                    Color="Color.Primary" Label="Ver todos los roles" />
            </div>

            <div class="matrix-legend" aria-label="Leyenda de estados">
                <span class="matrix-legend-item"><span class="matrix-cell matrix-cell-on" aria-hidden="true"></span> Directo</span>
                <span class="matrix-legend-item"><span class="matrix-cell matrix-cell-heredado" aria-hidden="true"></span> Heredado</span>
                <span class="matrix-legend-item"><span class="matrix-cell matrix-cell-off" aria-hidden="true"></span> Denegado</span>
                <span class="matrix-legend-item"><span class="matrix-cell matrix-cell-inactive" aria-hidden="true"></span> Inactivo</span>
            </div>
        </MudPaper>
    </div>

    @if (_cargando)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="400px" />
    }
    else if (_roles.Count > 0 && _modulos.Count > 0)
    {
        <div class="matrix-layout">
            <div class="matrix-wrap">
                <table class="matrix-table mud-table">
                    <thead>
                        <tr>
                            <th scope="col" class="matrix-col-permiso">Permiso</th>
                            @foreach (var r in _rolesVisibles)
                            {
                                var isSelected = r.Id == _idRolSeleccionado && _idRolSeleccionado > 0;
                                <th @key="@($"h-{r.Id}")" scope="col" class="@(isSelected ? "matrix-col-selected " : "")matrix-col-rol"
                                    title="@($"{r.Nombre} ({r.Codigo}) — {AmbitoDe(r)}")">
                                    <span class="matrix-role-head-name">@r.Nombre</span>
                                    <span class="matrix-role-head-code">@r.Codigo</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mod in _modulosVisibles)
                        {
                            var abierto = !_modulosColapsados.Contains(mod.IdModulo);
                            <tr @key="@($"m-{mod.IdModulo}")" class="matrix-group-header">
                                <td colspan="@(_rolesVisibles.Count + 1)" class="mud-table-cell">
                                    <button type="button" class="matrix-module-toggle" @onclick="@(() => AlternarModulo(mod.IdModulo))"
                                        aria-expanded="@(abierto ? "true" : "false")"
                                        aria-label="@(abierto ? "Contraer" : "Expandir") + $" el modulo {mod.NombreModulo}">
                                        <MudIcon Icon="@(abierto ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                        <span>@mod.NombreModulo</span>
                                        <span class="matrix-module-count">@mod.Permisos.Count</span>
                                    </button>
                                </td>
                            </tr>
                            @if (abierto)
                            {
                                @foreach (var perm in mod.Permisos)
                                {
                                    <tr @key="@($"p-{perm.IdPermiso}")">
                                        <td class="mud-table-cell matrix-col-permiso">
                                            <div class="matrix-row-label">
                                                <div>
                                                    <MudText Typo="Typo.body2">@perm.NombrePermiso</MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary matrix-perm-code">@perm.CodigoPermiso</MudText>
                                                </div>
                                            </div>
                                        </td>
                                        @foreach (var r in _rolesVisibles)
                                        {
                                            var celda = ObtenerCelda(perm.IdPermiso, r.Id);
                                            var isSelected = r.Id == _idRolSeleccionado && _idRolSeleccionado > 0;
                                            var tdClass = isSelected ? "matrix-col-selected mud-table-cell" : "mud-table-cell";
                                            <td @key="@($"c-{perm.IdPermiso}-{r.Id}")" class="@tdClass">
                                                @if (celda is not null && celda.EsHeredado)
                                                {
                                                    <span class="matrix-cell matrix-cell-heredado" role="img"
                                                        aria-label="@($"Permiso heredado en {r.Nombre}")"
                                                        title="@($"Heredado en {r.Nombre}")"></span>
                                                }
                                                else if (celda is not null && celda.Estado == "on")
                                                {
                                                    <span class="matrix-cell matrix-cell-on" role="img"
                                                        aria-label="@($"Permiso asignado directamente a {r.Nombre}")"
                                                        title="@($"Asignado en {r.Nombre}")"></span>
                                                }
                                                else if (celda is not null && celda.Estado == "off")
                                                {
                                                    <span class="matrix-cell matrix-cell-off" role="img"
                                                        aria-label="@($"Permiso denegado a {r.Nombre}")"
                                                        title="@($"Denegado en {r.Nombre}")"></span>
                                                }
                                                else
                                                {
                                                    <span class="matrix-cell matrix-cell-inactive" role="img"
                                                        aria-label="@($"Permiso inactivo en {r.Nombre}")"
                                                        title="@($"Inactivo en {r.Nombre}")"></span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="summary-section" style="margin-top:16px;">
            <div class="summary-layout">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">
                        @(_rolSeleccionado?.Nombre ?? "Ninguno") — Resumen de Permisos
                    </MudText>
                    @if (_rolSeleccionado is not null)
                    {
                        var res = ObtenerResumen(_rolSeleccionado.Id);
                        <div class="permission-counts">
                            <div class="perm-count-card"><div class="perm-count-val total">@res.Total</div><div class="perm-count-label">Totales</div></div>
                            <div class="perm-count-card"><div class="perm-count-val granted">@res.Concedidos</div><div class="perm-count-label">Concedidos</div></div>
                            <div class="perm-count-card"><div class="perm-count-val denied">@res.Denegados</div><div class="perm-count-label">Denegados</div></div>
                            <div class="perm-count-card"><div class="perm-count-val inherited">@res.Heredados</div><div class="perm-count-label">Heredados</div></div>
                            <div class="perm-count-card"><div class="perm-count-val total mud-text-disabled">@res.Inactivos</div><div class="perm-count-label">Inactivos</div></div>
                        </div>
                        <div class="matrix-summary-divider">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Permisos directos: <strong class="mud-text-primary">@res.Directos</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-4">
                                Por herencia: <strong class="mud-primary-text">@res.Heredados</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-4">
                                Inactivos: <strong class="mud-text-disabled">@res.Inactivos</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-4">
                                Cobertura: <strong class="mud-success-text">@res.Cobertura%</strong>
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">Seleccione un rol para ver el resumen</MudText>
                    }
                </MudPaper>
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Distribucion por Modulo</MudText>
                    <div id="module-distribution">
                        @if (_rolSeleccionado is not null)
                        {
                            var modStats = ObtenerModuloStats(_rolSeleccionado.Id);
                            foreach (var ms in modStats)
                            {
                                <div class="module-stat-row">
                                    <MudText Typo="Typo.caption" Class="module-stat-label">@ms.Nombre</MudText>
                                    <div class="module-stat-bar">
                                        <div class="module-stat-fill" style="width:@ms.Porcentaje%;background:@ms.Color;"></div>
                                    </div>
                                    <MudText Typo="Typo.caption" Class="module-stat-nums">@ms.Concedidos/@ms.Total</MudText>
                                </div>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">Seleccione un rol para ver la distribucion</MudText>
                        }
                    </div>
                </MudPaper>
            </div>
        </div>
    }
    else if (_cargado && _modulos.Count == 0)
    {
        <div class="table-panel" style="padding:40px;text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No se encontraron datos de matriz de permisos</MudText>
        </div>
    }
</div>
}

@code {
    private List<RolDto> _roles = [];
    private List<RolDto> _rolesVisibles = [];
    private List<MatrizPermisoRow> _items = [];
    private List<ModuloMatriz> _modulos = [];
    private List<ModuloMatriz> _modulosVisibles = [];
    private Dictionary<(int IdPermiso, int IdRol), CeldaMatriz> _celdas = [];
    private int _idRolSeleccionado;
    private bool _cargando;
    private bool _cargado;
    private string _busqueda = "";
    private bool _soloAsignados;
    private bool _verTodos;
    private readonly HashSet<int> _modulosColapsados = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("MATRIZ_PERMISOS_VER")) return;
        await CargarDatos();
    }

    /// <summary>
    /// S58.1 · D1 — una sola carga: se piden los roles y la matriz una vez y todo
    /// (agrupado, indice de celdas y filtros) se calcula en memoria.
    /// </summary>
    private async Task CargarDatos()
    {
        _cargando = true;
        _cargado = false;
        try
        {
            var tRoles = Api.GetAsync<List<RolDto>>("api/roles");
            var tMatriz = Api.GetAsync<List<MatrizPermisoRow>>("api/MatrizPermisos");
            await Task.WhenAll(tRoles, tMatriz);
            _roles = tRoles.Result ?? [];
            _items = tMatriz.Result ?? [];
            ConstruirIndice();
            _cargado = true;
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar datos: {ex.Message}", Severity.Error); }
        finally { _cargando = false; }
    }

    /// <summary>S58.1 · D1 — agrupa y indexa una sola vez (no en cada lectura).</summary>
    private void ConstruirIndice()
    {
        _celdas = new Dictionary<(int, int), CeldaMatriz>();
        foreach (var item in _items)
        {
            _celdas[(item.IdPermiso, item.IdRol)] = new CeldaMatriz
            {
                IdRol = item.IdRol,
                Estado = item.Estado,
                EsDirecto = item.EsDirecto,
                EsHeredado = item.EsHeredado
            };
        }

        _modulos = _items
            .GroupBy(i => new { i.IdModulo, i.NombreModulo, i.OrdenModulo })
            .OrderBy(g => g.Key.OrdenModulo)
            .Select(g => new ModuloMatriz
            {
                IdModulo = g.Key.IdModulo,
                NombreModulo = g.Key.NombreModulo,
                OrdenModulo = g.Key.OrdenModulo,
                Permisos = g
                    .GroupBy(p => new { p.IdPermiso, p.NombrePermiso, p.CodigoPermiso, p.OrdenPermiso })
                    .OrderBy(pg => pg.Key.OrdenPermiso)
                    .Select(pg => new PermisoMatriz
                    {
                        IdPermiso = pg.Key.IdPermiso,
                        NombrePermiso = pg.Key.NombrePermiso,
                        CodigoPermiso = pg.Key.CodigoPermiso,
                        OrdenPermiso = pg.Key.OrdenPermiso
                    }).ToList()
            }).ToList();

        // Modulos plegados por defecto salvo el primero.
        _modulosColapsados.Clear();
        foreach (var mod in _modulos.Skip(1))
            _modulosColapsados.Add(mod.IdModulo);

        RecalcularVisibles();
    }

    /// <summary>S58.1 · D1 — la vista visible se recalcula solo al cambiar un filtro.</summary>
    private void RecalcularVisibles()
    {
        var busqueda = (_busqueda ?? "").Trim();

        _rolesVisibles = _verTodos
            ? _roles
            : _roles.Where(r => r.Id == _idRolSeleccionado && _idRolSeleccionado > 0).ToList();

        _modulosVisibles = _modulos
            .Select(m => new ModuloMatriz
            {
                IdModulo = m.IdModulo,
                NombreModulo = m.NombreModulo,
                OrdenModulo = m.OrdenModulo,
                Permisos = m.Permisos.Where(p => CumpleFiltro(p, busqueda)).ToList()
            })
            .Where(m => m.Permisos.Count > 0)
            .ToList();
    }

    private bool CumpleFiltro(PermisoMatriz perm, string busqueda)
    {
        if (busqueda.Length > 0)
        {
            var coincide = perm.NombrePermiso.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                        || perm.CodigoPermiso.Contains(busqueda, StringComparison.OrdinalIgnoreCase);
            if (!coincide) return false;
        }

        if (_soloAsignados && _idRolSeleccionado > 0)
        {
            var celda = ObtenerCelda(perm.IdPermiso, _idRolSeleccionado);
            if (celda is null) return false;
            return celda.EsHeredado || celda.Estado == "on";
        }

        return true;
    }

    /// <summary>Roles agrupados por ambito: primero los globales, luego cada tenant.</summary>
    private List<(string Titulo, List<RolDto> Roles)> _rolesAgrupados
    {
        get
        {
            var grupos = new List<(string, List<RolDto>)>();
            var globales = _roles.Where(r => r.IdTenant is null).OrderBy(r => r.Nombre).ToList();
            if (globales.Count > 0) grupos.Add(("Global", globales));

            foreach (var g in _roles.Where(r => r.IdTenant is not null)
                                    .GroupBy(r => r.TenantNombre ?? $"Tenant {r.IdTenant}")
                                    .OrderBy(g => g.Key))
            {
                grupos.Add((g.Key, g.OrderBy(r => r.Nombre).ToList()));
            }

            return grupos;
        }
    }

    private static string AmbitoDe(RolDto rol) =>
        rol.IdTenant is null ? "Global" : (rol.TenantNombre ?? $"Tenant {rol.IdTenant}");

    private void AlternarModulo(int idModulo)
    {
        if (!_modulosColapsados.Add(idModulo)) _modulosColapsados.Remove(idModulo);
    }

    /// <summary>S58.1 · D1 — elegir un rol filtra en memoria: no vuelve a pedir la matriz.</summary>
    private void OnRolElegido(int idRol)
    {
        _idRolSeleccionado = idRol;
        RecalcularVisibles();
    }

    private CeldaMatriz? ObtenerCelda(int idPermiso, int idRol) =>
        _celdas.TryGetValue((idPermiso, idRol), out var celda) ? celda : null;

    private ResumenRol ObtenerResumen(int idRol)
    {
        var res = new ResumenRol();
        foreach (var mod in _modulos)
        {
            foreach (var perm in mod.Permisos)
            {
                var celda = ObtenerCelda(perm.IdPermiso, idRol);
                if (celda is null) continue;
                res.Total++;
                if (celda.EsHeredado) { res.Heredados++; res.Concedidos++; }
                else if (celda.Estado == "on") { res.Concedidos++; res.Directos++; }
                else if (celda.Estado == "off") res.Denegados++;
                else if (celda.Estado == "inactive") res.Inactivos++;
            }
        }
        res.Cobertura = res.Total > 0 ? (int)Math.Round((double)res.Concedidos / res.Total * 100) : 0;
        return res;
    }

    private List<ModuloStat> ObtenerModuloStats(int idRol)
    {
        var colores = new[] { "var(--dat-indigo)", "var(--dat-lila)", "var(--dat-azul-claro)", "var(--dat-verde-claro)", "var(--dat-naranja-claro)", "var(--dat-rosa-claro)", "var(--dat-esmeralda)", "var(--dat-naranja-vivo)" };
        var idx = 0;
        return _modulos.Select(mod =>
        {
            var concedidos = 0;
            var total = 0;
            foreach (var perm in mod.Permisos)
            {
                var celda = ObtenerCelda(perm.IdPermiso, idRol);
                if (celda is null) continue;
                total++;
                if (celda.Estado == "on" || celda.EsHeredado) concedidos++;
            }
            var pct = total > 0 ? (int)Math.Round((double)concedidos / total * 100) : 0;
            var color = colores[idx % colores.Length];
            idx++;
            return new ModuloStat { Nombre = mod.NombreModulo, Concedidos = concedidos, Total = total, Porcentaje = pct, Color = color };
        }).ToList();
    }

    private RolDto? _rolSeleccionado
    {
        get => _roles.FirstOrDefault(r => r.Id == _idRolSeleccionado);
    }

    public class MatrizPermisoRow
    {
        public int IdRol { get; set; }
        public string RolNombre { get; set; } = "";
        public string RolCodigo { get; set; } = "";
        public int IdPermiso { get; set; }
        public string CodigoPermiso { get; set; } = "";
        public string NombrePermiso { get; set; } = "";
        public byte OrdenPermiso { get; set; }
        public int IdModulo { get; set; }
        public string NombreModulo { get; set; } = "";
        public string CodigoModulo { get; set; } = "";
        public byte OrdenModulo { get; set; }
        public string Estado { get; set; } = "off";
        public bool EsDirecto { get; set; }
        public bool EsHeredado { get; set; }
    }

    public class ModuloMatriz
    {
        public int IdModulo { get; set; }
        public string NombreModulo { get; set; } = "";
        public byte OrdenModulo { get; set; }
        public List<PermisoMatriz> Permisos { get; set; } = [];
    }

    public class PermisoMatriz
    {
        public int IdPermiso { get; set; }
        public string NombrePermiso { get; set; } = "";
        public string CodigoPermiso { get; set; } = "";
        public byte OrdenPermiso { get; set; }
    }

    public class CeldaMatriz
    {
        public int IdRol { get; set; }
        public string Estado { get; set; } = "off";
        public bool EsDirecto { get; set; }
        public bool EsHeredado { get; set; }
    }

    public class ResumenRol
    {
        public int Total { get; set; }
        public int Concedidos { get; set; }
        public int Denegados { get; set; }
        public int Heredados { get; set; }
        public int Inactivos { get; set; }
        public int Directos { get; set; }
        public int Cobertura { get; set; }
    }

    public class ModuloStat
    {
        public string Nombre { get; set; } = "";
        public int Concedidos { get; set; }
        public int Total { get; set; }
        public int Porcentaje { get; set; }
        public string Color { get; set; } = "var(--dat-indigo)";
    }
}
