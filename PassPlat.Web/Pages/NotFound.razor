@page "/404"
<div class="notfound-wrapper">
    <div class="notfound-card">
        <div class="notfound-code">
            <span class="notfound-digit">4</span>
            <span class="notfound-zero">
                <MudIcon Icon="@Icons.Material.Filled.SentimentDissatisfied" Size="Size.Large" />
            </span>
            <span class="notfound-digit">4</span>
        </div>
        <MudText Typo="Typo.h5" Class="notfound-title">Página no encontrada</MudText>
        <MudText Typo="Typo.body2" Class="notfound-desc">
            La ruta solicitada no existe o ha sido movida.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="notfound-btn"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Volver al Dashboard
        </MudButton>
    </div>
</div>
