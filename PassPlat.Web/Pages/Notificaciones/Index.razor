@page "/notificaciones"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("NOTIFICACIONES_VER"))
{
    <SinPermiso PermisoRequerido="NOTIFICACIONES_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Notificaciones</h1>
                <p class="page-subtitle">Notificaciones enviadas a cada usuario.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog"
                    StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">
                    Nueva Notificación
                </MudButton>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_items.Count.ToString()" Label="Notificaciones" Subtexto="En página actual" Icon="@Icons.Material.Filled.Notifications" ColorClass="primary" />
        <IamKpiCard Valor="@_items.Count(n => n.Leida).ToString()" Label="Leídas" Subtexto="Vistas por usuario" Icon="@Icons.Material.Filled.MarkEmailRead" ColorClass="success" />
        <IamKpiCard Valor="@_items.Count(n => !n.Leida).ToString()" Label="No leídas" Subtexto="Pendientes" Icon="@Icons.Material.Filled.MarkEmailUnread" ColorClass="warning" />
        <IamKpiCard Valor="@_items.Select(n => n.IdUsuario).Distinct().Count().ToString()" Label="Usuarios" Subtexto="Destinatarios" Icon="@Icons.Material.Filled.People" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <SelectorCatalogo T="UsuarioDto" Class="lista-filtro" Items="_usuarios" @bind-Value="_usuarioSelected" @bind-Value:after="@LoadData"
                    SearchTextSelector="@(u => $"{u.NomUsuario} {u.Nombre} {u.Apellido}")"
                    ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
                    Label="Filtrar por Usuario" Variant="Variant.Outlined" Clearable="true" />
                <MudTextField @bind-Value="_search" Label="Buscar título o mensaje..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Class="lista-filtro" />
                <MudSelect T="string" Value="_tipoFiltro" ValueChanged="@OnTipoChanged" Label="Tipo" Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                    @foreach (var tipo in _tiposFiltro)
                    {
                        <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                    }
                </MudSelect>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium"
                    OnClick="@LoadData" Class="mr-2" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable T="NotificacionDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm">
        <ColGroup>
            <col style="width:100px;" /><col /><col /><col style="width:80px;" /><col style="width:160px;" /><col style="width:120px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh><MudTh>Título</MudTh><MudTh>Mensaje</MudTh><MudTh>Leída</MudTh><MudTh>Fecha</MudTh><MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Título">@context.Asunto</MudTd>
            <MudTd DataLabel="Mensaje">@context.Mensaje</MudTd>
            <MudTd DataLabel="Leída">
                <MudChip T="string" Size="Size.Small" Color="@(context.Leida ? Color.Default : Color.Warning)">
                    @(context.Leida ? "Sí" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Fecha">@context.FecCrea.ToString("g")</MudTd>
            <MudTd DataLabel="Acciones">
                @if (!context.Leida)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => MarcarLeida(context.Id))" aria-label="Marcar como leído" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<NotificacionDto> _items = [];
    private bool _loading;
    private int _idUsuario;
    private string? _search;
    private string? _tipoFiltro;
    private List<string> _tiposFiltro = [];
    private UsuarioDto? _usuarioSelected;
    private List<UsuarioDto> _usuarios = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("NOTIFICACIONES_VER")) return;
        _idUsuario = Auth.IdUsuario ?? 0;
        if (_idUsuario > 0) { _usuarios = await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? []; await LoadData(); }
    }

    // S85 · D4 — buscador (Asunto/Mensaje) y tipo se aplican en memoria sobre la lista cargada
    private List<NotificacionDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                filtrados = filtrados.Where(n =>
                    (n.Asunto ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (n.Mensaje ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (!string.IsNullOrWhiteSpace(_tipoFiltro))
                filtrados = filtrados.Where(n => n.TipoNotif == _tipoFiltro).ToList();
            return filtrados;
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _usuarios = await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? [];
            _idUsuario = _usuarioSelected?.Id ?? _idUsuario;
            var data = await Api.GetAsync<List<NotificacionDto>>($"api/notificaciones/no-leidas/{_idUsuario}");
            _items = data ?? [];

            // S85 · D4 — opciones del filtro Tipo a partir de la lista cargada
            _tiposFiltro = _items.Select(n => n.TipoNotif ?? string.Empty)
                .Where(n => n.Length > 0).Distinct().OrderBy(n => n).ToList();
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task MarcarLeida(long id)
    {
        var ok = await Api.PostVoidAsync($"api/notificaciones/{id}/marcar-leida");
        if (ok)
        {
            Snackbar.Add("Notificación marcada como leída", Severity.Success);
            await LoadData();
        }
        else
            Snackbar.Add(Api.LastError ?? "Error al marcar como leída", Severity.Error);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<NotificacionDialog>
        {
            { x => x.IdUsuario, _idUsuario }
        };
        var dialog = await Dialog.ShowAsync<NotificacionDialog>("Nueva Notificación", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }

    private void OnTipoChanged(string? tipo)
    {
        _tipoFiltro = tipo;
    }
}
