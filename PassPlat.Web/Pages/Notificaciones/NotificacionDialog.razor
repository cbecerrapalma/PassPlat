@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.Add" Texto="Nueva Notificación" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudTextField @bind-Value="_asunto" Label="Asunto" Variant="Variant.Outlined" Required="true" RequiredError="El asunto es requerido" MaxLength="200" />
            <MudTextField @bind-Value="_mensaje" Label="Mensaje" Variant="Variant.Outlined" Lines="3" MaxLength="4000" />
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Crear" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public int IdUsuario { get; set; }

    private int _idUsuario;
    private string _asunto = "";
    private string _mensaje = "";
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        _idUsuario = IdUsuario;
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            var result = await Api.PostAsync<NotificacionDto>("api/notificaciones",
                new { idUsuario = _idUsuario, asunto = _asunto, mensaje = _mensaje });
            if (result is not null)
            {
                Snackbar.Add("Notificación creada", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al crear notificación";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
