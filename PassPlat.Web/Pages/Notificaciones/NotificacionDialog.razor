@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Nueva Notificación</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_asunto" Label="Asunto" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_mensaje" Label="Mensaje" Variant="Variant.Outlined" Class="mb-3" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@_saving">Crear</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    [Parameter] public int IdUsuario { get; set; }

    private int _idUsuario;
    private string _asunto = "";
    private string _mensaje = "";
    private bool _saving;

    protected override void OnInitialized()
    {
        _idUsuario = IdUsuario;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var result = await Api.PostAsync<NotificacionDto>("api/notificaciones",
                new { idUsuario = _idUsuario, asunto = _asunto, mensaje = _mensaje });
            if (result is not null)
            {
                Snackbar.Add("Notificación creada", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al crear notificación", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
