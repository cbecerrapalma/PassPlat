@page "/admin/permisos"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@* S104 · D3 — catálogo de permisos en árbol App → Módulo (por IdModulo) → Permiso. El clic en un permiso navega a /permiso/{id}. *@
@if (!Auth.TienePermiso("PERMISOS_VER"))
{
    <SinPermiso PermisoRequerido="PERMISOS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Permisos</h1>
                <p class="page-subtitle">Catálogo de permisos por aplicación y módulo. Abre un permiso para ver sus roles y editarlo.</p>
            </div>
            @if (Auth.TienePermiso("PERMISOS_CREAR"))
            {
                <div style="display:flex;gap:8px;align-items:center;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirCrearPermiso" StartIcon="@Icons.Material.Filled.Add">
                        Nuevo Permiso
                    </MudButton>
                </div>
            }
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_todosPermisos.Count.ToString()" Label="Permisos" Subtexto="@(_inactivos > 0 ? $"{_inactivos} inactivos" : null)" Icon="@Icons.Material.Filled.VerifiedUser" ColorClass="primary" />
        <IamKpiCard Valor="@_apps.Count(a => a != SinApp).ToString()" Label="Aplicaciones" Icon="@Icons.Material.Filled.Apps" ColorClass="success" />
        <IamKpiCard Valor="@_modulosUnicos.ToString()" Label="Módulos" Icon="@Icons.Material.Filled.Category" ColorClass="info" />
        <IamKpiCard Valor="@(_matrizCargada ? _sinRol.ToString() : "—")" Label="Sin rol" Icon="@Icons.Material.Filled.GppMaybe" ColorClass="warning" />
    </div>

    @if (_cargando)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="400px" />
    }
    else
    {
        var visibles = Filtrados();
        var arbol = Arbol(visibles);

        <MudPaper Outlined="true" Class="permisos-barra-filtros pa-3 mb-3">
            <MudSelect T="string" Label="Aplicación" Variant="Variant.Outlined" Dense="true" @bind-Value="_appFiltro" Style="min-width:220px">
                <MudSelectItem T="string" Value="@TodasLasApps">Todas</MudSelectItem>
                @foreach (var a in _apps)
                {
                    <MudSelectItem @key="a" T="string" Value="@a">@a</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_busqueda" Label="Buscar…" Variant="Variant.Outlined" Margin="Margin.Dense"
                Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                Style="min-width:260px;flex:1 1 260px" />
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ExpandirTodo">Expandir todo</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ContraerTodo">Contraer todo</MudButton>
            <MudText Typo="Typo.caption" Class="permisos-contador mud-text-secondary">@visibles.Count @(visibles.Count == 1 ? "permiso" : "permisos")</MudText>
        </MudPaper>

        <div class="explorer-layout">
            <section class="tree-panel" style="width:100%;min-width:0;" aria-label="Catálogo de permisos">
                <div class="tree-scroll tree-scroll--pagina">
                    @if (arbol.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">No hay permisos que coincidan</MudText>
                    }
                    @foreach (var app in arbol)
                    {
                        <div @key="@("app-" + app.Nombre)" class="tree-node tree-app" @onclick="() => ToggleApp(app.Nombre)">
                            <svg class="tree-arrow @(AppAbierta(app.Nombre) ? "open" : "")" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 4 4 4-4 4"/></svg>
                            <svg class="tree-node-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M2 6.5h12"/></svg>
                            <span class="tree-node-label">@($"{app.Nombre} · {Cuenta(app.Total, "permiso", "permisos")} · {Cuenta(app.Modulos.Count, "módulo", "módulos")}")</span>
                        </div>
                        @if (AppAbierta(app.Nombre))
                        {
                            <div class="tree-children">
                                @foreach (var modulo in app.Modulos)
                                {
                                    <div @key="modulo.IdModulo" class="tree-node tree-modulo" data-modulo-id="@modulo.IdModulo" @onclick="() => ToggleModulo(modulo.IdModulo)">
                                        <svg class="tree-arrow @(ModuloAbierto(modulo.IdModulo) ? "open" : "")" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 4 4 4-4 4"/></svg>
                                        <svg class="tree-node-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/></svg>
                                        <span class="tree-node-label">@modulo.Nombre</span>
                                        <span class="tree-node-count">@modulo.Permisos.Count</span>
                                    </div>
                                    @if (ModuloAbierto(modulo.IdModulo))
                                    {
                                        <div class="tree-children">
                                            @foreach (var perm in modulo.Permisos)
                                            {
                                                <div @key="perm.Id" class="tree-node tree-permiso" data-permiso-id="@perm.Id" @onclick="() => VerDetalle(perm)">
                                                    <svg class="tree-node-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"/><path d="M1 8h14M8 1v14"/></svg>
                                                    <span class="tree-node-label">@perm.Nombre</span>
                                                    <span class="permiso-codigo">@perm.Codigo</span>
                                                    @if (_matrizCargada)
                                                    {
                                                        var roles = RolesDe(perm.Id);
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(roles == 0 ? Color.Warning : Color.Default)" Class="permiso-roles">@(roles == 0 ? "Sin rol" : Cuenta(roles, "rol", "roles"))</MudChip>
                                                    }
                                                    @if (!perm.Activo)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Class="permiso-inactivo">Inactivo</MudChip>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    }
</div>
}

@code {
    private const string TodasLasApps = "Todas";
    private const string SinApp = "Sin aplicación";

    private sealed record ModuloArbol(int IdModulo, string Nombre, List<PermisoDto> Permisos);
    private sealed record AppArbol(string Nombre, int Total, List<ModuloArbol> Modulos);

    private List<PermisoDto> _todosPermisos = [];
    // IdPermiso → n.º de roles distintos con el permiso («on» o «inherited») en el alcance de la sesión
    private Dictionary<int, int> _rolesPorPermiso = [];
    private bool _matrizCargada;
    private string _busqueda = "";
    private string _appFiltro = TodasLasApps;
    private bool _cargando;
    private readonly HashSet<int> _modulosAbiertos = [];
    private readonly HashSet<string> _appsCerradas = [];

    private int _inactivos => _todosPermisos.Count(p => !p.Activo);
    private int _modulosUnicos => _todosPermisos.Select(p => p.IdModulo).Distinct().Count();
    private int _sinRol => _todosPermisos.Count(p => p.Activo && RolesDe(p.Id) == 0);
    private List<string> _apps => [.. _todosPermisos.Select(NombreApp).Distinct().Order(StringComparer.CurrentCultureIgnoreCase)];

    /// <summary>Ruta de la matriz rol × permiso: el sistema ve todos los tenants; el resto, solo el suyo.</summary>
    public static string RutaMatriz(bool esSistema, int? idTenant) =>
        esSistema || idTenant is null ? "api/MatrizPermisos" : $"api/MatrizPermisos?idTenant={idTenant}";

    private static string NombreApp(PermisoDto p) => string.IsNullOrWhiteSpace(p.AppNombre) ? SinApp : p.AppNombre;

    private static string Cuenta(int n, string singular, string plural) => $"{n} {(n == 1 ? singular : plural)}";

    private int RolesDe(int idPermiso) => _rolesPorPermiso.GetValueOrDefault(idPermiso);

    private bool Buscando => !string.IsNullOrWhiteSpace(_busqueda);

    private List<PermisoDto> Filtrados()
    {
        var consulta = _todosPermisos.AsEnumerable();
        if (_appFiltro != TodasLasApps)
            consulta = consulta.Where(p => NombreApp(p) == _appFiltro);
        if (Buscando)
            consulta = consulta.Where(p =>
                p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                p.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                (p.Descripcion?.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ModuloNombre?.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ?? false));
        return [.. consulta];
    }

    // app → módulo (por IdModulo, sin fusionar homónimos) → permiso por Orden
    private static List<AppArbol> Arbol(List<PermisoDto> permisos) => [.. permisos
        .GroupBy(NombreApp)
        .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
        .Select(g => new AppArbol(g.Key, g.Count(), [.. g
            .GroupBy(p => p.IdModulo)
            .Select(m => new ModuloArbol(m.Key, m.First().ModuloNombre ?? "Sin módulo", [.. m.OrderBy(p => p.Orden).ThenBy(p => p.Nombre)]))
            .OrderBy(m => m.Nombre, StringComparer.CurrentCultureIgnoreCase).ThenBy(m => m.IdModulo)]))];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("PERMISOS_VER")) return;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _cargando = true;
        try
        {
            _todosPermisos = await Api.GetAsync<List<PermisoDto>>("api/permisos") ?? [];
            if (Api.LastError != null) { Snackbar.Add(Api.LastError, Severity.Error); return; }
            // si la matriz falla el árbol se muestra igual, sin contadores de roles
            var matriz = await Api.GetAsync<List<MatrizPermisoRole>>(RutaMatriz(Auth.EsSistema, Auth.IdTenant));
            if (Api.LastError != null || matriz is null)
            {
                _matrizCargada = false;
                _rolesPorPermiso = [];
                if (Api.LastError != null) Snackbar.Add(Api.LastError, Severity.Error);
                return;
            }
            _rolesPorPermiso = matriz
                .Where(r => r.Estado is "on" or "inherited")
                .GroupBy(r => r.IdPermiso)
                .ToDictionary(g => g.Key, g => g.Select(r => r.IdRol).Distinct().Count());
            _matrizCargada = true;
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar datos: {ex.Message}", Severity.Error); }
        finally { _cargando = false; }
    }

    private bool AppAbierta(string app) => Buscando || !_appsCerradas.Contains(app);

    private bool ModuloAbierto(int idModulo) => Buscando || _modulosAbiertos.Contains(idModulo);

    private void ToggleApp(string app)
    {
        if (!_appsCerradas.Remove(app)) _appsCerradas.Add(app);
    }

    private void ToggleModulo(int idModulo)
    {
        if (!_modulosAbiertos.Remove(idModulo)) _modulosAbiertos.Add(idModulo);
    }

    private void ExpandirTodo()
    {
        _appsCerradas.Clear();
        foreach (var id in _todosPermisos.Select(p => p.IdModulo)) _modulosAbiertos.Add(id);
    }

    private void ContraerTodo() => _modulosAbiertos.Clear();

    private void VerDetalle(PermisoDto permiso) => Navigation.NavigateTo($"/permiso/{permiso.Id}");

    private async Task AbrirCrearPermiso()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<PermisoDialog>("Nuevo Permiso", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await CargarDatos(); Snackbar.Add("Permiso creado", Severity.Success); }
    }

    public class MatrizPermisoRole
    {
        public int IdRol { get; set; }
        public string RolNombre { get; set; } = "";
        public string RolCodigo { get; set; } = "";
        public int IdPermiso { get; set; }
        public string CodigoPermiso { get; set; } = "";
        public string NombrePermiso { get; set; } = "";
        public byte OrdenPermiso { get; set; }
        public int IdModulo { get; set; }
        public string NombreModulo { get; set; } = "";
        public string CodigoModulo { get; set; } = "";
        public byte OrdenModulo { get; set; }
        public string Estado { get; set; } = "off";
        public bool EsDirecto { get; set; }
        public bool EsHeredado { get; set; }
    }
}
