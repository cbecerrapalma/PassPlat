@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@using PassPlat.Aplicacion.Dtos.Catalogos
@using PassPlat.Aplicacion.Dtos.Core

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Amplio)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(IsEdit ? "Editar Política de Contraseña" : "Nueva Política de Contraseña")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="General" Expanded="true">
                    <div class="dialogo-campos">
                        <div class="dialogo-fila">
                            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Disabled="@IsEdit" Required="true"
                                          RequiredError="El código es requerido" />
                            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" Required="true"
                                          RequiredError="El nombre es requerido" />
                        </div>
                        <SelectorCatalogo T="TenantDto" Items="_tenants" @bind-Value="_tenantSelected"
                            SearchTextSelector="@(t => $"{t.Nombre} {t.Codigo}")"
                            ToStringFunc="@(t => t is null ? "" : $"{t.Nombre} ({t.Codigo})")"
                            Label="Tenant (opcional)" Variant="Variant.Outlined" Clearable="true" />
                        <SelectorCatalogo T="AppDto" Items="_apps" @bind-Value="_appSelected"
                            SearchTextSelector="@(a => $"{a.Nombre} {a.Codigo}")"
                            ToStringFunc="@(a => a is null ? "" : $"{a.Nombre} ({a.Codigo})")"
                            Label="App (opcional)" Variant="Variant.Outlined" Clearable="true" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Longitud">
                    <div class="dialogo-fila">
                        <MudTextField @bind-Value="_longMinStr" Label="Long. Mínima" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_longMaxStr" Label="Long. Máxima" Variant="Variant.Outlined" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Requisitos de Caracteres">
                    <div class="dialogo-campos">
                        <div class="dialogo-fila">
                            <MudSwitch @bind-Value="_reqMayuscula" Label="Requiere mayúscula" Color="Color.Primary" />
                            <MudSwitch @bind-Value="_reqMinuscula" Label="Requiere minúscula" Color="Color.Primary" />
                            <MudSwitch @bind-Value="_reqNumero" Label="Requiere número" Color="Color.Primary" />
                            <MudSwitch @bind-Value="_reqEspecial" Label="Requiere carácter especial" Color="Color.Primary" />
                        </div>
                        <MudTextField @bind-Value="_caracteresEspeciales" Label="Caracteres especiales permitidos" Variant="Variant.Outlined" HelperText="Deja vacío para usar los predeterminados" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Prohibiciones">
                    <div class="dialogo-fila">
                        <MudSwitch @bind-Value="_prohSecuenciales" Label="Prohibir secuencias (123, abc)" Color="Color.Error" />
                        <MudSwitch @bind-Value="_prohRepetitivos" Label="Prohibir repetitivos (aaa, 111)" Color="Color.Error" />
                        <MudSwitch @bind-Value="_prohPatrones" Label="Prohibir patrones de teclado" Color="Color.Error" />
                        <MudSwitch @bind-Value="_prohPwdComun" Label="Prohibir contraseñas comunes" Color="Color.Error" />
                        <MudSwitch @bind-Value="_prohInfoUsuario" Label="Prohibir información del usuario" Color="Color.Error" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Seguridad">
                    <div class="dialogo-fila">
                        <MudSwitch @bind-Value="_verificarBrechas" Label="Verificar en brechas de datos" Color="Color.Warning" />
                        <MudSwitch @bind-Value="_permitirEspacios" Label="Permitir espacios" Color="Color.Warning" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Vigencia y Bloqueo">
                    <div class="dialogo-fila">
                        <MudTextField @bind-Value="_diasVigenciaStr" Label="Días de vigencia" Variant="Variant.Outlined" HelperText="0 = sin expiración" />
                        <MudTextField @bind-Value="_pwdRecordadasStr" Label="Contraseñas recordadas" Variant="Variant.Outlined" HelperText="0 = sin historial" />
                        <MudTextField @bind-Value="_maxIntentosStr" Label="Máx. intentos fallidos" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_durBloqueoMinStr" Label="Duración bloqueo (minutos)" Variant="Variant.Outlined" HelperText="0 = hasta desbloqueo manual" />
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Estado">
                    <MudSwitch @bind-Value="_activa" Label="Política activa" Color="Color.Success" />
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public PoliticaPwdDto? Politica { get; set; }

    private string _codigo = "";
    private string _nombre = "";
    private List<TenantDto> _tenants = [];
    private List<AppDto> _apps = [];
    private TenantDto? _tenantSelected;
    private AppDto? _appSelected;
    private string _longMinStr = "8";
    private string _longMaxStr = "64";
    private bool _reqMayuscula;
    private bool _reqMinuscula;
    private bool _reqNumero;
    private bool _reqEspecial;
    private string? _caracteresEspeciales;
    private bool _prohSecuenciales;
    private bool _prohRepetitivos;
    private bool _prohPatrones;
    private bool _prohPwdComun = true;
    private bool _prohInfoUsuario = true;
    private bool _verificarBrechas = true;
    private bool _permitirEspacios = true;
    private string _diasVigenciaStr = "0";
    private string _pwdRecordadasStr = "24";
    private string _maxIntentosStr = "5";
    private string _durBloqueoMinStr = "30";
    private bool _activa = true;
    private bool _saving;
    private MudForm _form = null!;

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        var tTenants = Api.GetAsync<List<TenantDto>>("api/tenants");
        var tApps = Api.GetAsync<List<AppDto>>("api/apps");
        await Task.WhenAll(tTenants, tApps);

        _tenants = tTenants.Result ?? [];
        _apps = tApps.Result ?? [];

        if (IsEdit && Politica is not null)
        {
            _codigo = Politica.Codigo;
            _nombre = Politica.Nombre;
            _longMinStr = Politica.LongMin.ToString();
            _longMaxStr = Politica.LongMax.ToString();
            _reqMayuscula = Politica.ReqMayuscula;
            _reqMinuscula = Politica.ReqMinuscula;
            _reqNumero = Politica.ReqNumero;
            _reqEspecial = Politica.ReqEspecial;
            _caracteresEspeciales = Politica.CaracteresEspeciales;
            _prohSecuenciales = Politica.ProhSecuenciales;
            _prohRepetitivos = Politica.ProhRepetitivos;
            _prohPatrones = Politica.ProhPatrones;
            _prohPwdComun = Politica.ProhPwdComun;
            _prohInfoUsuario = Politica.ProhInfoUsuario;
            _verificarBrechas = Politica.VerificarBrechas;
            _permitirEspacios = Politica.PermitirEspacios;
            _diasVigenciaStr = Politica.DiasVigencia.ToString();
            _pwdRecordadasStr = Politica.PwdRecordadas.ToString();
            _maxIntentosStr = Politica.MaxIntentos.ToString();
            _durBloqueoMinStr = Politica.DurBloqueoMin.ToString();
            _activa = Politica.Activa;
            _tenantSelected = _tenants.FirstOrDefault(t => t.Id == (Politica.IdTenant ?? Auth.IdTenant ?? 0));
            _appSelected = _apps.FirstOrDefault(a => a.Id == Politica.IdApp);
        }
        else
        {
            _tenantSelected = _tenants.FirstOrDefault(t => t.Id == (Auth.IdTenant ?? 0));
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            byte.TryParse(_longMinStr, out var longMin);
            byte.TryParse(_longMaxStr, out var longMax);
            short.TryParse(_diasVigenciaStr, out var diasVigencia);
            byte.TryParse(_pwdRecordadasStr, out var pwdRecordadas);
            byte.TryParse(_maxIntentosStr, out var maxIntentos);
            int.TryParse(_durBloqueoMinStr, out var durBloqueoMin);

            if (IsEdit)
            {
                var ok = await Api.PutVoidAsync($"api/politicaspwd/{Politica!.Id}",
                    new
                    {
                        id = Politica.Id,
                        nombre = _nombre,
                        longMin,
                        longMax,
                        reqMayuscula = _reqMayuscula,
                        reqMinuscula = _reqMinuscula,
                        reqNumero = _reqNumero,
                        reqEspecial = _reqEspecial,
                        caracteresEspeciales = _caracteresEspeciales,
                        prohSecuenciales = _prohSecuenciales,
                        prohRepetitivos = _prohRepetitivos,
                        prohPatrones = _prohPatrones,
                        prohPwdComun = _prohPwdComun,
                        prohInfoUsuario = _prohInfoUsuario,
                        verificarBrechas = _verificarBrechas,
                        permitirEspacios = _permitirEspacios,
                        diasVigencia,
                        pwdRecordadas,
                        maxIntentos,
                        durBloqueoMin
                    });
                if (ok)
                {
                    Snackbar.Add("Política actualizada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar";
            }
            else
            {
                var result = await Api.PostAsync<PoliticaPwdDto>("api/politicaspwd",
                    new
                    {
                        codigo = _codigo,
                        nombre = _nombre,
                        idTenant = _tenantSelected?.Id,
                        idApp = _appSelected?.Id,
                        longMin,
                        longMax,
                        reqMayuscula = _reqMayuscula,
                        reqMinuscula = _reqMinuscula,
                        reqNumero = _reqNumero,
                        reqEspecial = _reqEspecial,
                        caracteresEspeciales = _caracteresEspeciales,
                        prohSecuenciales = _prohSecuenciales,
                        prohRepetitivos = _prohRepetitivos,
                        prohPatrones = _prohPatrones,
                        prohPwdComun = _prohPwdComun,
                        prohInfoUsuario = _prohInfoUsuario,
                        verificarBrechas = _verificarBrechas,
                        permitirEspacios = _permitirEspacios,
                        diasVigencia,
                        pwdRecordadas,
                        maxIntentos,
                        durBloqueoMin
                    });
                if (result is not null)
                {
                    Snackbar.Add("Política creada", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}