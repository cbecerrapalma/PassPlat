@page "/reset-password"
@layout LoginLayout
@inject AuthService Auth
@inject NavigationManager Nav

@if (_showSkeleton)
{
    <div class="login-wrapper">
        <div class="login-skeleton">
            <div class="login-skeleton-circle" />
            <div class="login-skeleton-line w-50" />
            <div class="login-skeleton-line w-75" />
            <div class="login-skeleton-line w-100" />
            <div class="login-skeleton-line w-100" />
        </div>
    </div>
}
else
{
    <div class="login-wrapper">
        <MudPaper Elevation="0" Class="login-card px-8 py-10" Style="width: 100%; max-width: 420px; border-radius: 16px;">
            <div class="d-flex flex-column align-center mb-6">
                <div class="login-logo mb-3">
                    <div class="login-logo-ring" />
                    <div class="login-logo-inner">
                        <span class="login-logo-icon">&#x1F512;</span>
                    </div>
                </div>
                <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold text-white">Restablecer Contraseña</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray">@_subtitle</MudText>
            </div>

            @if (!_exito)
            {
                <MudForm @ref="_form">
                    <MudTextField @bind-Value="_nuevaPassword"
                                  Label="Nueva contraseña"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Margin="Margin.Dense"
                                  Class="mb-4"
                                  Disabled="_loading"
                                  Validation="@(new Func<string?, string?>(ValidarPassword))" />

                    <MudTextField @bind-Value="_confirmarPassword"
                                  Label="Confirmar contraseña"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Margin="Margin.Dense"
                                  Class="mb-4"
                                  Disabled="_loading"
                                  Validation="@(new Func<string?, string?>(v => v != _nuevaPassword ? "Las contraseñas no coinciden" : null))"
                                  OnKeyDown="@(args => { if (args.Key == "Enter") _ = DoReset(); })" />
                </MudForm>
            }

            @if (_showError)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                    @_errorMessage
                </MudAlert>
            }

            @if (_exito)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    Tu contraseña ha sido restablecida correctamente.
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="@IrAlLogin"
                           Size="Size.Large"
                           Class="mb-6">
                    Ir al inicio de sesión
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="@DoReset"
                           Disabled="_loading || string.IsNullOrWhiteSpace(_token)"
                           Size="Size.Large"
                           Class="mb-6">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Class="mr-2" Color="Color.Inherit" Indeterminate="true" />
                        <span>Restableciendo...</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.button">Restablecer contraseña</MudText>
                    }
                </MudButton>
            }

            <MudText Typo="Typo.caption" Align="Align.Center" Class="text-gray mt-4">
                Plataforma de Acceso &mdash; v1.0
            </MudText>
        </MudPaper>
    </div>
}

@code {
    private bool _showSkeleton = true;
    private bool _loading;
    private bool _showError;
    private bool _exito;
    private string _token = "";
    private string _nuevaPassword = "";
    private string _confirmarPassword = "";
    private string _errorMessage = "";
    private string _subtitle = "Ingresa tu nueva contraseña";
    private MudForm? _form;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = uri.Query.TrimStart('?').Split('&')
            .Select(s => s.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(p => Uri.UnescapeDataString(p[0]), p => Uri.UnescapeDataString(p[1]), StringComparer.OrdinalIgnoreCase);
        query.TryGetValue("token", out _token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(400);
            _showSkeleton = false;
            StateHasChanged();
        }

        if (firstRender && string.IsNullOrWhiteSpace(_token))
        {
            _showError = true;
            _errorMessage = "Token inválido o ausente. Usa el enlace que recibiste por correo.";
            StateHasChanged();
        }
    }

    private string? ValidarPassword(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "La contraseña es obligatoria";
        if (value.Length < 6)
            return "Debe tener al menos 6 caracteres";
        return null;
    }

    private async Task DoReset()
    {
        if (string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_nuevaPassword))
            return;

        _loading = true;
        _showError = false;

        try
        {
            var response = await Auth.RestablecerPasswordAsync(_token, _nuevaPassword);
            if (response.Success)
            {
                _exito = true;
                _subtitle = "Contraseña restablecida";
            }
            else
            {
                _errorMessage = response.ErrorMessage ?? "Error al restablecer la contraseña";
                _showError = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error de conexión: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void IrAlLogin()
    {
        Nav.NavigateTo("/login");
    }
}
