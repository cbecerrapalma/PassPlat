@page "/rol/{id:int}"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject AuthService Auth
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared
@using PassPlat.Web.Pages.Roles.Components

@if (!Auth.TienePermiso("ROLES_DETALLE_VER"))
{
    <SinPermiso PermisoRequerido="ROLES_DETALLE_VER" />
}
else
{
<div class="iam-page">
<MigasDePan Padre="/admin/roles" Actual="@(_rol?.Nombre ?? "Rol")" />

    @if (_cargando && _rol is null)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Style="border-radius:10px;" />
    }
    else if (_rol is null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">Rol no encontrado</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@VolverALista">Atrás</MudButton>
    }
    else
    {
        <div class="page-header">
            <div class="page-title-row">
                <div style="display:flex;gap:12px;align-items:center;">
                    <h1 class="page-title">@_rol.Nombre</h1>
                    <span class="badge @(_rol.Activo ? "badge-active" : "badge-inactive")">
                        <span class="badge-dot"></span>@(_rol.Activo ? "Activo" : "Inactivo")
                    </span>
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <MudButton Variant="Variant.Outlined" OnClick="@VolverALista" StartIcon="@Icons.Material.Filled.ArrowBack">Atrás</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => AbrirEditarRol(_rol))" StartIcon="@Icons.Material.Filled.Edit">Editar</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => ConfirmarEliminarRol(_rol))" Disabled="@_eliminandoRol" StartIcon="@Icons.Material.Filled.Block">@(_rol.Activo ? "Desactivar" : "Activar")</MudButton>
                </div>
            </div>
            <p class="page-subtitle">@_rol.Descripcion</p>
        </div>

        <MudTabs @bind-ActivePanelIndex="_tabIndex" KeepPanelsAlive="true" Class="detail-tabs" TabPanelsClass="pt-3">
            <MudTabPanel Text="Info" Icon="@Icons.Material.Filled.Info">
                <div class="detail-section">
                    <div class="detail-section-title">Detalles del Rol</div>
                    <div class="field-row"><div class="field-label">Rol</div><div class="field-value">@_rol.Nombre</div></div>
                    <div class="field-row"><div class="field-label">Descripcion</div><div class="field-value">@_rol.Descripcion</div></div>
                    <div class="field-row"><div class="field-label">Codigo</div><div class="field-value mono">@_rol.Codigo</div></div>
                    <div class="field-row"><div class="field-label">Tenant</div><div class="field-value" style="color:var(--text-muted);">@(_rol.TenantNombre ?? "-- (Global)")</div></div>
                    <div class="field-row"><div class="field-label">Estado</div><div class="field-value"><span class="badge @(_rol.Activo ? "badge-active" : "badge-inactive")"><span class="badge-dot"></span>@(_rol.Activo ? "Activo" : "Inactivo")</span></div></div>
                    <div class="field-row"><div class="field-label">Creado</div><div class="field-value" style="color:var(--text-muted);">@_rol.FecCrea.ToString("dd MMM yyyy")</div></div>
                    <div class="field-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div><div class="field-label">Usuarios</div><div class="field-value" style="font-weight:600;">@_usuariosDelRol.Count</div></div>
                        <div><div class="field-label">Permisos</div><div class="field-value" style="font-weight:600;">@_permisosAsignados</div></div>
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Permisos" Icon="@Icons.Material.Filled.Security">
                <div class="detail-section">
                    <div class="detail-section-title">Permisos</div>
                    <RolPermisos @key="_rol.Id" Rol="_rol" UsuariosConRol="@_usuariosDelRol.Count" CountChanged="@OnPermisosCount" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Herencia" Icon="@Icons.Material.Filled.AccountTree">
                <div class="detail-section">
                    <div class="detail-section-title">Roles Padre (hereda de)</div>
                    @if (_cargandoHerencia)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="80px" />
                    }
                    else
                    {
                        @if (_herenciasPadre.Count == 0)
                        {
                            <p style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">Sin roles padre</p>
                        }
                        else
                        {
                            <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px;">
                                @foreach (var item in _herenciasPadre)
                                {
                                    <span @key="item.Id" class="assign-chip">@item.RolNombre</span>
                                }
                            </div>
                        }
                        <div class="detail-section-title" style="margin-top:4px;">Roles Hijo (heredan de este)</div>
                        @if (_herenciasHijo.Count == 0)
                        {
                            <p style="font-size:12px;color:var(--text-muted);">Sin roles hijo</p>
                        }
                        else
                        {
                            <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                @foreach (var item in _herenciasHijo)
                                {
                                    <span @key="item.Id" class="assign-chip perm">@item.RolNombre</span>
                                }
                            </div>
                        }
                        @if (Auth.TienePermiso("ROLES_EDITAR"))
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => AbrirAgregarHerencia("Padre"))" StartIcon="@Icons.Material.Filled.AccountTree" Class="mt-2">Gestionar Herencia</MudButton>
                        }
                    }
                </div>
            </MudTabPanel>

            @if (Auth.TienePermiso("POLITICASPWD_VER"))
            {
                <MudTabPanel Text="Política" Icon="@Icons.Material.Filled.Lock">
                    <RolPoliticaPwd Rol="_rol" IsActive="@(_tabIndex == 3)" />
                </MudTabPanel>
            }

            <MudTabPanel Text="Usuarios" Icon="@Icons.Material.Filled.People">
                <div class="detail-section">
                    <div class="detail-section-title">Miembros del Rol</div>
                    @if (_cargandoUsuariosRol)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="120px" />
                    }
                    else if (_usuariosDelRol.Count == 0)
                    {
                        <p style="font-size:12px;color:var(--text-muted);">Sin usuarios asignados</p>
                    }
                    else
                    {
                        <table class="mini-table">
                            <thead><tr><th>Usuario</th><th>Nombre</th></tr></thead>
                            <tbody>
                                @foreach (var usr in _usuariosDelRol.Take(10))
                                {
                                    <tr @key="usr.Id">
                                        <td style="font-weight:500;color:var(--text-primary);">@usr.UsuarioNombre</td>
                                        <td style="font-family:'JetBrains Mono',monospace;font-size:10px;">@(usr.UsuarioNombre ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_usuariosDelRol.Count > 10)
                        {
                            <p style="font-size:10px;color:var(--text-muted);margin-top:6px;">... y @(_usuariosDelRol.Count - 10) mas</p>
                        }
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@AbrirAsignarUsuarioARol" StartIcon="@Icons.Material.Filled.PersonAdd" Class="mt-2">Agregar Miembro</MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Apps" Icon="@Icons.Material.Filled.Apps">
                <div class="detail-section">
                    <div class="detail-section-title">Aplicaciones</div>
                    <table class="mini-table">
                        <thead><tr><th>Aplicacion</th><th>Nota</th></tr></thead>
                        <tbody>
                            <tr>
                                <td style="font-weight:500;color:var(--text-primary);">@(_rol.TenantNombre ?? "-- (Global)")</td>
                                <td style="font-size:10px;color:var(--text-muted);">Asignado</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </MudTabPanel>
        </MudTabs>
    }

    @if (_cargando || _eliminandoRol)
    {
        <div class="modal-overlay" style="position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:100;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
        </div>
    }
</div>
}

@code {
    [Parameter] public int Id { get; set; }

    private List<RolDto> _roles = [];
    private RolDto? _rol;
    private int _tabIndex;

    private int _permisosAsignados;   // S106: lo informa RolPermisos (CountChanged)
    private bool _cargando = true;
    private bool _eliminandoRol;

    private List<AccesoDto> _usuariosDelRol = [];
    private bool _cargandoUsuariosRol;

    private List<RolesHerenciaView> _herenciasPadre = [];
    private List<RolesHerenciaView> _herenciasHijo = [];
    private bool _cargandoHerencia;

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.TienePermiso("ROLES_DETALLE_VER")) return;
        _cargando = true;
        try
        {
            await CargarRoles();
            _rol = await BuscarRolAsync();
            if (_rol is not null)
                await Task.WhenAll(CargarUsuariosDelRol(), CargarHerenciaDelRol());
        }
        finally { _cargando = false; }
    }

    private void VolverALista() => Navigation.NavigateTo("/admin/roles");

    private void OnPermisosCount(int total) => _permisosAsignados = total;

    private async Task CargarRoles()
    {
        try
        {
            var idTenant = Auth.IdTenant ?? 0;
            _roles = idTenant > 0
                ? await Api.GetAsync<List<RolDto>>($"api/roles/para-tenant/{idTenant}") ?? []
                : await Api.GetAsync<List<RolDto>>("api/roles") ?? [];
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar roles: {ex.Message}", Severity.Error); }
    }

    private async Task RecargarRol()
    {
        _cargando = true;
        try
        {
            await CargarRoles();
            _rol = await BuscarRolAsync();
        }
        finally { _cargando = false; }
    }

    // La lista del tenant solo trae roles activos: un rol desactivado se pide por id para poder activarlo de nuevo.
    private async Task<RolDto?> BuscarRolAsync()
    {
        var rol = _roles.FirstOrDefault(r => r.Id == Id);
        if (rol is not null) return rol;
        rol = await Api.GetAsync<RolDto>($"api/roles/{Id}");
        if (rol is not null && rol.TenantNombre is null && rol.IdTenant is not null && rol.IdTenant == Auth.IdTenant)
            rol.TenantNombre = Auth.NombreTenant;
        return rol;
    }

    private async Task CargarUsuariosDelRol()
    {
        if (_rol is null) return;
        _cargandoUsuariosRol = true;
        try { _usuariosDelRol = await Api.GetAsync<List<AccesoDto>>($"api/accesos/rol/{_rol.Id}") ?? []; }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar usuarios: {ex.Message}", Severity.Error); }
        finally { _cargandoUsuariosRol = false; }
    }

    private async Task CargarHerenciaDelRol()
    {
        if (_rol is null) return;
        _cargandoHerencia = true;
        try
        {
            var padres = await Api.GetAsync<List<RolesHerenciaDto>>($"api/RolesHerencia/padres/{_rol.Id}") ?? [];
            _herenciasPadre = padres.Select(rh => new RolesHerenciaView { Id = rh.Id, IdRol = rh.IdRolPadre, RolNombre = rh.RolPadreNombre ?? "?", Tipo = "Padre", RolCodigo = "" }).ToList();
            var hijos = await Api.GetAsync<List<RolesHerenciaDto>>($"api/RolesHerencia/hijos/{_rol.Id}") ?? [];
            _herenciasHijo = hijos.Select(rh => new RolesHerenciaView { Id = rh.Id, IdRol = rh.IdRolHijo, RolNombre = rh.RolHijoNombre ?? "?", Tipo = "Hijo", RolCodigo = "" }).ToList();
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar herencia: {ex.Message}", Severity.Error); }
        finally { _cargandoHerencia = false; }
    }

    private async Task AbrirAgregarHerencia(string tipo)
    {
        if (_rol is null) return;
        var parameters = new DialogParameters
        {
            ["IdTenant"] = Auth.IdTenant, ["IdRolActual"] = _rol.Id,
            ["RolActualNombre"] = _rol.Nombre,
            ["RolesDisponibles"] = _roles.Where(r => r.Activo && r.Id != _rol.Id).ToList(), ["Tipo"] = tipo
        };
        var dialog = await Dialog.ShowAsync<RolesHerenciaDialog>(
            tipo == "Padre" ? "Agregar Rol Padre" : "Agregar Rol Hijo", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await CargarHerenciaDelRol(); Snackbar.Add("Relacion de herencia creada", Severity.Success); }
    }

    private async Task AbrirEditarRol(RolDto rol)
    {
        var parameters = new DialogParameters { ["IsEdit"] = true, ["Rol"] = rol };
        var dialog = await Dialog.ShowAsync<RolDialog>("Editar Rol", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await RecargarRol(); Snackbar.Add("Rol actualizado", Severity.Success); }
    }

    private async Task ConfirmarEliminarRol(RolDto rol)
    {
        var msg = rol.Activo
            ? $"Desactivar rol '{rol.Nombre}'? Sus accesos dejaran de otorgar permisos."
            : $"Activar rol '{rol.Nombre}'?";
        var parameters = new DialogParameters { ["Title"] = "Confirmar", ["Message"] = msg, ["ConfirmText"] = "Si", ["CancelText"] = "Cancelar", ["ConfirmColor"] = Color.Error };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _eliminandoRol = true;
            try
            {
                // S116 · D5 — DELETE solo desactiva; activar es un PUT con Activo = true
                var ok = rol.Activo
                    ? await Api.DeleteAsync($"api/roles/{rol.Id}")
                    : await Api.PutAsync<RolDto>($"api/roles/{rol.Id}", new ActualizarRolDto { Nombre = rol.Nombre, Descripcion = rol.Descripcion, Activo = true }) is not null;
                if (ok)
                {
                    Snackbar.Add(rol.Activo ? "Rol desactivado" : "Rol activado", Severity.Success);
                    await RecargarRol();
                }
                else Snackbar.Add(Api.LastError ?? "Error al actualizar rol", Severity.Error);
            }
            catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error); }
            finally { _eliminandoRol = false; }
        }
    }

    private async Task AbrirAsignarUsuarioARol()
    {
        if (_rol is null) return;
        var parameters = new DialogParameters { ["RolPreSeleccionado"] = _rol };
        var dialog = await Dialog.ShowAsync<AsignarUsuarioRolDialog>("Asignar Usuario a Rol", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) await CargarUsuariosDelRol();
    }

    public class RolesHerenciaView
    {
        public int Id { get; set; }
        public int IdRol { get; set; }
        public string RolNombre { get; set; } = string.Empty;
        public string RolCodigo { get; set; } = string.Empty;
        public string Tipo { get; set; } = string.Empty;
    }
}
