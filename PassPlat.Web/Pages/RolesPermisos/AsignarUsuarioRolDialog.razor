@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.PersonAdd" Texto="Asignar Usuario a Rol" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudText Typo="Typo.caption" Class="text-secondary d-block">
                Asigna un usuario al rol <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">@RolPreSeleccionado?.Nombre</MudChip>
            </MudText>

            <MudTextField @bind-Value="_busqueda" Label="Buscar usuario..." Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                Immediate="true" Clearable="true" />

            <MudSelect T="UsuarioDto" Label="Usuario" @bind-Value="_usuarioSeleccionado" Required="true"
                Variant="Variant.Outlined" ToStringFunc="@(u => u?.NomUsuario ?? string.Empty)"
                RequiredError="Selecciona un usuario"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
                @foreach (var u in _usuariosFiltrados)
                {
                    <MudSelectItem @key="u.Id" Value="u">
                        <div class="d-flex align-center" style="gap:8px;">
                            <MudAvatar Size="Size.Small" Color="Color.Info">
                                <MudText Typo="Typo.caption">@(u.Nombre[..Math.Min(2, u.Nombre.Length)])</MudText>
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@u.Nombre @u.Apellido</MudText>
                                <MudText Typo="Typo.caption" Class="text-secondary">@u.NomUsuario · @u.Email</MudText>
                            </div>
                        </div>
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="AppDto" Label="Aplicación" @bind-Value="_appSeleccionada" Required="true"
                Variant="Variant.Outlined" ToStringFunc="@(a => a?.Nombre ?? string.Empty)"
                RequiredError="Selecciona una aplicación"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Launch">
                @foreach (var app in _apps)
                {
                    <MudSelectItem @key="app.Id" Value="app">@app.Nombre (@app.Codigo)</MudSelectItem>
                }
            </MudSelect>
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Asignar" TextoGuardando="Asignando…" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public RolDto? RolPreSeleccionado { get; set; }

    private List<UsuarioDto> _usuarios = [];
    private List<AppDto> _apps = [];
    private UsuarioDto? _usuarioSeleccionado;
    private AppDto? _appSeleccionada;
    private string _busqueda = "";
    private bool _saving;
    private MudForm _form = null!;

    private List<UsuarioDto> _usuariosFiltrados =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? _usuarios
            : _usuarios.Where(u =>
                u.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Apellido.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                u.NomUsuario.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                (u.Email?.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tUsuarios = Api.GetAsync<List<UsuarioDto>>("api/usuarios");
            // S113 · D4 — sin APPS_VER: las apps de los Accesos de quien asigna
            var tApps = AppsObjetivo.CatalogoOAccesosAsync(Api, Auth);
            await Task.WhenAll(tUsuarios, tApps);
            _usuarios = tUsuarios.Result ?? [];
            _apps = [.. tApps.Result.Where(a => a.Activa)];
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error al cargar datos: {ex.Message}";
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            var dto = new AsignarAccesoDto
            {
                IdUsuario = _usuarioSeleccionado!.Id,
                IdApp = _appSeleccionada!.Id,
                IdRol = RolPreSeleccionado!.Id
            };
            var result = await Api.PostAsync<AccesoDto>("api/accesos/asignar", dto);
            if (result is not null)
            {
                Snackbar.Add($"Acceso asignado a {_usuarioSeleccionado!.NomUsuario} en {_appSeleccionada!.Nombre}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
                _errorServidor = Api.LastError ?? "Error al asignar acceso";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
