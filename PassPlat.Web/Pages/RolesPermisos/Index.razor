    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("ROLES_VER")) return;
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        _cargando = true;
        try
        {
            var tasks = new List<Task>
            {
                CargarRoles(),
                CargarTodosPermisos(),
                CargarTodasPoliticas()
            };
            await Task.WhenAll(tasks);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarRoles()
    {
        try
        {
            var idTenant = Auth.IdTenant ?? 0;
            _roles = idTenant > 0
                ? await Api.GetAsync<List<RolDto>>($"api/roles/para-tenant/{idTenant}") ?? []
                : await Api.GetAsync<List<RolDto>>("api/roles") ?? [];
            await CargarUsuariosPorRol();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar roles: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarTodosPermisos()
    {
        try
        {
            _todosPermisos = await Api.GetAsync<List<PermisoDto>>("api/permisos/activos") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar permisos: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarTodasPoliticas()
    {
        try
        {
            _todasPoliticas = await Api.GetAsync<List<PoliticaPwdDto>>("api/politicaspwd") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar políticas: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarUsuariosPorRol()
    {
        _usuariosPorRol = [];
        foreach (var rol in _roles)
        {
            try
            {
                var accesos = await Api.GetAsync<List<AccesoDto>>($"api/accesos/rol/{rol.Id}") ?? [];
                _usuariosPorRol[rol.Id] = accesos.Count(a => a.Activo);
            }
            catch
            {
                _usuariosPorRol[rol.Id] = 0;
            }
        }
        StateHasChanged();
    }

    private async Task OnRolSeleccionado(RolDto? rol)
    {
        _rolSeleccionado = rol;
        _busquedaPermiso = "";
        if (rol is not null)
            await Task.WhenAll(CargarPermisosDelRol(), CargarPoliticaDelRol(), CargarUsuariosDelRol(), CargarHerenciaDelRol());
        else
        {
            _permisosAgrupados = [];
            _politicaAsignada = null;
            _politicaDetalle = null;
            _usuariosDelRol = [];
            _herenciasPadre = [];
            _herenciasHijo = [];
        }
    }

    private async Task CargarPermisosDelRol()
    {
        if (_rolSeleccionado is null) return;
        _cargandoPermisos = true;
        try
        {
            var permisosDelRol = await Api.GetAsync<List<RolPermisoDto>>($"api/permisos/rol/{_rolSeleccionado.Id}") ?? [];
            _permisosActuales = [.. permisosDelRol.Select(rp => rp.IdPermiso)];
            _permisosAgrupados = _todosPermisos
            .GroupBy(p => p.ModuloNombre ?? p.ModuloCodigo ?? "")
                .OrderBy(g => g.Key)
                .Select(g => new PermisoGrupo
                {
                    Modulo = g.Key,
                    Permisos = g.OrderBy(p => p.Orden).Select(p => new PermisoCheckItem
                    {
                        Id = p.Id, Codigo = p.Codigo, Nombre = p.Nombre,
                        Descripcion = p.Descripcion, Asignado = _permisosActuales.Contains(p.Id)
                    }).ToList()
                }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar permisos: {ex.Message}", Severity.Error);
        }
        finally { _cargandoPermisos = false; }
    }

    private async Task CargarPoliticaDelRol()
    {
        if (_rolSeleccionado is null) return;
        _cargandoPolitica = true;
        try
        {
            var politicasRol = await Api.GetAsync<List<RolPoliticaPwdDto>>($"api/rolespoliticaspwd/rol/{_rolSeleccionado.Id}") ?? [];
            _politicaAsignada = politicasRol.FirstOrDefault(rp => rp.Activo);
            _politicaDetalle = _politicaAsignada is not null
                ? _todasPoliticas.FirstOrDefault(p => p.Id == _politicaAsignada.IdPolitica)
                : null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar política: {ex.Message}", Severity.Error);
        }
        finally { _cargandoPolitica = false; }
    }

