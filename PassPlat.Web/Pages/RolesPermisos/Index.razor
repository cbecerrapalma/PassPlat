    private async Task TogglePermiso(PermisoCheckItem permiso, bool asignado)
    {
        if (_rolSeleccionado is null) return;
        permiso.Asignado = asignado;
        if (asignado) _permisosActuales.Add(permiso.Id);
        else _permisosActuales.Remove(permiso.Id);
        _guardandoPermiso = true;
        try
        {
            if (asignado)
            {
                var dto = new AsignarPermisoDto { IdRol = _rolSeleccionado.Id, IdPermiso = permiso.Id };
                var result = await Api.PostAsync<RolPermisoDto>("api/permisos/rol", dto);
                if (result is null) { permiso.Asignado = false; _permisosActuales.Remove(permiso.Id); Snackbar.Add(Api.LastError ?? "Error al asignar", Severity.Error); }
                else Snackbar.Add($"Permiso '{permiso.Nombre}' asignado", Severity.Success);
            }
            else
            {
                var ok = await Api.DeleteAsync($"api/permisos/rol/{_rolSeleccionado.Id}/{permiso.Id}");
                if (!ok) { permiso.Asignado = true; _permisosActuales.Add(permiso.Id); Snackbar.Add(Api.LastError ?? "Error al desasignar", Severity.Error); }
                else Snackbar.Add($"Permiso '{permiso.Nombre}' desasignado", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            permiso.Asignado = !asignado;
            if (asignado) _permisosActuales.Remove(permiso.Id);
            else _permisosActuales.Add(permiso.Id);
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally { _guardandoPermiso = false; await InvokeAsync(StateHasChanged); }
    }

    private void OnPermisoSwitchChanged(PermisoCheckItem permiso, bool asignado) => _ = TogglePermiso(permiso, asignado);

    private async Task ToggleAllPermisos(PermisoGrupo grupo, bool asignar)
