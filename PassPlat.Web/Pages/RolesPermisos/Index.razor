@page "/admin/roles-permisos"
@* S102 · D3 — página corta «Permisos directos»: elegir usuario → sus permisos directos.
   Roles, política y herencia viven en /admin/roles y /rol/{id}; los permisos en /admin/permisos. *@
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject AuthService Auth
@using PassPlat.Web.Pages.Usuarios.Components

@if (!Auth.TienePermiso("PERMISOS_VER"))
{
    <SinPermiso PermisoRequerido="PERMISOS_VER" />
}
else
{
<div class="iam-page">
    <MigasDePan Actual="Permisos directos" />

    <div class="page-header">
        <div class="page-title-row">
            <h1 class="page-title">Permisos directos</h1>
        </div>
        <p class="page-subtitle">Permisos concedidos o denegados a un usuario fuera de sus roles.</p>
    </div>

    <div class="filter-bar mb-4">
        <SelectorCatalogo T="UsuarioDto" Items="_usuarios" @bind-Value="_usuario"
            SearchTextSelector="@(u => $"{u.Nombre} {u.Apellido} {u.NomUsuario}")"
            ToStringFunc="@(u => u is null ? "" : $"{u.Nombre} {u.Apellido} ({u.NomUsuario})")"
            Label="Usuario" Variant="Variant.Outlined" Clearable="true" />
    </div>

    @if (_usuario is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Elija un usuario para ver y cambiar sus permisos.</MudText>
    }
    else
    {
        <UsuarioPermisos @key="_usuario.Id" UserId="_usuario.Id" UsuarioNombre="@($"{_usuario.Nombre} {_usuario.Apellido}")" IsActive="true" />
    }
</div>
}

@code {
    private List<UsuarioDto> _usuarios = [];
    private UsuarioDto? _usuario;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("PERMISOS_VER")) return;
        try
        {
            _usuarios = [.. (await Api.GetAsync<List<UsuarioDto>>("api/usuarios") ?? []).OrderBy(u => u.Nombre).ThenBy(u => u.Apellido)];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar usuarios: {ex.Message}", Severity.Error);
        }
    }
}
