@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Security)" Texto="@(IsEdit ? "Editar Permiso" : "Nuevo Permiso")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <div class="dialogo-seccion">Definición del permiso</div>
            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Code"
                HelperText="Identificador único del permiso"
                Required="true" RequiredError="El código es obligatorio" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Security"
                HelperText="Nombre descriptivo del permiso"
                Required="true" RequiredError="El nombre es obligatorio" />
            <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description"
                HelperText="Opcional - qué permite este permiso" />
            <div class="dialogo-fila">
                <MudSelect T="int" @bind-Value="_idModulo" Label="Módulo" Variant="Variant.Outlined"
                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Folder"
                    HelperText="Agrupación funcional"
                    Required="true" RequiredError="El módulo es obligatorio"
                    Validation="@(new Func<int, string?>(v => v <= 0 ? "El módulo es obligatorio" : null))"
                    AnchorOrigin="Origin.BottomCenter" PopoverClass="modulo-select-popover">
                    @foreach (var mod in _modulos)
                    {
                        <MudSelectItem @key="mod.Id" Value="@mod.Id">@mod.Nombre (@mod.Codigo)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_orden" Label="Orden" Variant="Variant.Outlined"
                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.DragHandle"
                    HelperText="Posición dentro del módulo" Min="0" Max="99" />
            </div>
            @if (IsEdit)
            {
                <div>
                    <MudSwitch @bind-Value="_activo" Label="Activo" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="text-secondary">Los permisos inactivos no se pueden asignar a roles</MudText>
                </div>
            }
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public PermisoDto? Permiso { get; set; }

    private List<ModuloDto> _modulos = [];
    private string _codigo = "";
    private string _nombre = "";
    private string _descripcion = "";
    private int _idModulo;
    private int _orden;
    private bool _activo = true;
    private bool _saving;
    private MudForm _form = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _modulos = await Api.GetAsync<List<ModuloDto>>("api/modulos") ?? [];
            _modulos = AplanarModulos(_modulos);
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error al cargar módulos: {ex.Message}";
        }

        if (IsEdit && Permiso is not null)
        {
            _codigo = Permiso.Codigo;
            _nombre = Permiso.Nombre;
            _descripcion = Permiso.Descripcion ?? "";
            _idModulo = Permiso.IdModulo;
            _orden = Permiso.Orden;
            _activo = Permiso.Activo;
        }
    }

    private static List<ModuloDto> AplanarModulos(List<ModuloDto> modulos)
    {
        var result = new List<ModuloDto>();
        foreach (var mod in modulos)
        {
            result.Add(mod);
            if (mod.SubModulos.Count > 0)
                result.AddRange(AplanarModulos(mod.SubModulos));
        }
        return result;
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit && Permiso is not null)
            {
                var dto = new ActualizarPermisoDto
                {
                    Codigo = _codigo,
                    Nombre = _nombre,
                    Descripcion = _descripcion,
                    IdModulo = _idModulo,
                    Orden = (byte)_orden
                };
                var result = await Api.PutAsync<PermisoDto>($"api/permisos/{Permiso.Id}", dto);
                if (result is not null)
                {
                    Snackbar.Add("Permiso actualizado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar permiso";
            }
            else
            {
                var dto = new CrearPermisoDto
                {
                    Codigo = _codigo,
                    Nombre = _nombre,
                    Descripcion = _descripcion,
                    IdModulo = _idModulo,
                    Orden = (byte)_orden
                };
                var result = await Api.PostAsync<PermisoDto>("api/permisos", dto);
                if (result is not null)
                {
                    Snackbar.Add("Permiso creado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear permiso";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
