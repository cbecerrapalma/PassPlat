@* S103 · D9 — confirmación de los cambios de permisos de un usuario: muestra qué se agrega y qué se quita
   y pide motivo y vigencia opcionales. No llama a la API: devuelve (Motivo, FecInicio, FecFin) a UsuarioPermisos. *@
<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.ManageAccounts" Texto="Confirmar cambios de permisos" />
    </TitleContent>
    <DialogContent>
        <div class="dialogo-campos">
            @if (Agregar.Count > 0)
            {
                <div class="cambios-agregar">
                    <MudText Typo="Typo.subtitle2" Color="Color.Success">Se agregarán @Agregar.Count permiso(s)</MudText>
                    @foreach (var nombre in Agregar.Take(MaxVisibles))
                    {
                        <MudText Typo="Typo.body2">+ @nombre</MudText>
                    }
                    @if (Agregar.Count > MaxVisibles)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">y @(Agregar.Count - MaxVisibles) más</MudText>
                    }
                </div>
            }
            @if (Quitar.Count > 0)
            {
                <div class="cambios-quitar">
                    <MudText Typo="Typo.subtitle2" Color="Color.Error">Se quitarán @Quitar.Count permiso(s)</MudText>
                    @foreach (var nombre in Quitar.Take(MaxVisibles))
                    {
                        <MudText Typo="Typo.body2">− @nombre</MudText>
                    }
                    @if (Quitar.Count > MaxVisibles)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">y @(Quitar.Count - MaxVisibles) más</MudText>
                    }
                </div>
            }

            <MudTextField @bind-Value="_motivo" Label="Motivo (opcional)" Variant="Variant.Outlined" />
            <div class="dialogo-fila">
                <MudDatePicker @bind-Date="_fecInicio" Label="Fecha inicio (opcional)" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="_fecFin" Label="Fecha fin (opcional)" Variant="Variant.Outlined" />
            </div>
            @if (_vigenciaInvalida)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">La fecha fin debe ser posterior a la fecha inicio.</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Aplicar cambios" Deshabilitado="@_vigenciaInvalida" OnClick="@Aceptar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Nombres de los permisos que se agregan.</summary>
    [Parameter] public List<string> Agregar { get; set; } = [];
    /// <summary>Nombres de los permisos que se quitan.</summary>
    [Parameter] public List<string> Quitar { get; set; } = [];

    private const int MaxVisibles = 10;

    private string? _motivo;
    private DateTime? _fecInicio;
    private DateTime? _fecFin;

    private bool _vigenciaInvalida => _fecInicio.HasValue && _fecFin.HasValue && _fecFin <= _fecInicio;

    private void Aceptar()
    {
        if (_vigenciaInvalida) return;
        var motivo = string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim();
        MudDialog.Close(DialogResult.Ok((motivo, _fecInicio, _fecFin)));
    }
}
