@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" />
            </MudAvatar>
            <MudText Typo="Typo.h6">Agregar Permiso Directo</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="text-secondary mb-3 d-block">
            Asigne un permiso directo al usuario <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">@UsuarioNombre</MudChip>
        </MudText>

        <MudTextField @bind-Value="_busqueda" Label="Buscar permiso..." Variant="Variant.Outlined" Class="mb-3"
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
            Immediate="true" Clearable="true" />

        <MudGrid Class="mb-3">
            <MudItem xs="12" md="6">
                <MudSelect T="byte" Label="Tipo de asignación"
                    @bind-Value="_idTipoAsig" Variant="Variant.Outlined" FullWidth="true" Required="true">
                    @foreach (var t in TiposAsignacion)
                    {
                        <MudSelectItem @key="t.Id" Value="t.Id">
                            <MudChip T="string" Size="Size.Small"
                                Color="@(t.Id == 1 ? Color.Success : Color.Error)"
                                Variant="Variant.Outlined">@t.Nombre</MudChip>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_motivo" Label="Motivo (opcional)" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_fecInicio" Label="Fecha inicio (opcional)" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_fecFin" Label="Fecha fin (opcional)" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="mb-3" />

        @if (_cargando)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" />
        }
        else if (_grupos.Count == 0)
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0">
                <MudAvatar Size="Size.Large" Color="Color.Secondary" Variant="Variant.Outlined" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Sin permisos disponibles</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">Cree permisos usando el botón "Nuevo Permiso"</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var grupo in _gruposFiltrados)
            {
                var seleccionadosGrupo = grupo.Permisos.Count(p => _seleccionados.Contains(p.Id));
                <MudPaper @key="grupo.Modulo" Class="mb-3" Elevation="0" Outlined="true">
                    <div class="pa-3 d-flex align-center" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold flex-grow-1">@grupo.Modulo</MudText>
                        <MudCheckBox T="bool"
                            Value="@(seleccionadosGrupo == grupo.Permisos.Count)"
                            ValueChanged="@((bool v) => ToggleGrupo(grupo, v))"
                            Color="Color.Primary"
                            Label="@($"{seleccionadosGrupo}/{grupo.Permisos.Count}")"
                            Dense="true" />
                    </div>
                    <div class="pa-2">
                        @foreach (var permiso in grupo.Permisos)
                        {
                            <div @key="permiso.Id" class="pa-2 d-flex align-center" style="cursor:pointer; @(permiso != grupo.Permisos.Last() ? "border-bottom:1px solid var(--mud-palette-lines-default);" : "")">
                                <MudCheckBox T="bool"
                                    Value="@(_seleccionados.Contains(permiso.Id))"
                                    ValueChanged="@((bool v) => TogglePermiso(permiso.Id, v))"
                                    Color="Color.Primary"
                                    Dense="true" />
                                <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Small"
                                    Color="@(_seleccionados.Contains(permiso.Id) ? Color.Primary : Color.Default)"
                                    Class="mr-2" />
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@permiso.Nombre</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary">@permiso.Codigo · @(permiso.ModuloNombre ?? permiso.ModuloCodigo ?? "")</MudText>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Guardar" Disabled="@(_guardando || _seleccionados.Count == 0)">
            @(_guardando ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private DialogOptions _dialogOptions = new() { FullWidth = true, CloseButton = true, MaxWidth = MaxWidth.Large };

    [Parameter] public int IdTenant { get; set; }
    [Parameter] public int IdUsuario { get; set; }
    [Parameter] public string UsuarioNombre { get; set; } = "";
    [Parameter] public List<TipAsigPermisoDto> TiposAsignacion { get; set; } = [];

    private List<PermisoDto> _todosPermisos = [];
    private HashSet<int> _seleccionados = [];
    private string _busqueda = "";
    private bool _cargando;
    private bool _guardando;
    private byte _idTipoAsig = 1;
    private string? _motivo;
    private DateTime? _fecInicio;
    private DateTime? _fecFin;

    private class PermisoGrupo
    {
        public string Modulo { get; set; } = string.Empty;
        public List<PermisoDto> Permisos { get; set; } = [];
    }

    private List<PermisoGrupo> _grupos => _todosPermisos
        .GroupBy(p => p.ModuloNombre ?? p.ModuloCodigo ?? "")
        .OrderBy(g => g.Key)
        .Select(g => new PermisoGrupo { Modulo = g.Key, Permisos = g.OrderBy(p => p.Orden).ToList() })
        .ToList();

    private List<PermisoGrupo> _gruposFiltrados =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? _grupos
            : _grupos.Select(g => new PermisoGrupo
            {
                Modulo = g.Modulo,
                Permisos = g.Permisos.Where(p =>
                    p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                    p.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                    (p.Descripcion?.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList()
            }).Where(g => g.Permisos.Count > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            _todosPermisos = await Api.GetAsync<List<PermisoDto>>("api/permisos/activos") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar permisos: {ex.Message}", Severity.Error);
        }
        finally { _cargando = false; }
    }

    private void TogglePermiso(int idPermiso, bool valor)
    {
        if (valor) _seleccionados.Add(idPermiso);
        else _seleccionados.Remove(idPermiso);
    }

    private void ToggleGrupo(PermisoGrupo grupo, bool valor)
    {
        foreach (var p in grupo.Permisos)
        {
            if (valor) _seleccionados.Add(p.Id);
            else _seleccionados.Remove(p.Id);
        }
    }

    private async Task Guardar()
    {
        _guardando = true;
        try
        {
            foreach (var idPermiso in _seleccionados)
            {
                var dto = new CrearUsuarioPermisoDto
                {
                    IdUsuario = IdUsuario,
                    IdPermiso = idPermiso,
                    IdTenant = IdTenant,
                    IdTipoAsig = _idTipoAsig,
                    Motivo = _motivo,
                    FecInicio = _fecInicio,
                    FecFin = _fecFin
                };
                var result = await Api.PostAsync<UsuarioPermisoDto>("api/UsuariosPermisos", dto);
                if (result is null)
                {
                    Snackbar.Add(Api.LastError ?? $"Error al asignar permiso {idPermiso}", Severity.Error);
                    return;
                }
            }

            Snackbar.Add($"{_seleccionados.Count} permiso(s) directo(s) asignado(s)", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally { _guardando = false; }
    }
}
