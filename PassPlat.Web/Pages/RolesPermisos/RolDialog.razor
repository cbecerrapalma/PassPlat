@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(IsEdit ? "Editar Rol" : "Nuevo Rol")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <div class="dialogo-seccion">Información básica del rol</div>
            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined"
                Disabled="IsEdit" Required="true"
                RequiredError="El código es requerido"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Code"
                HelperText="Identificador único del rol (no se puede cambiar)" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" Required="true"
                RequiredError="El nombre es requerido"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                HelperText="Nombre descriptivo del rol" />
            <MudTextField @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description"
                HelperText="Opcional - descripción del propósito del rol" />
            @if (IsEdit)
            {
                <div>
                    <MudSwitch @bind-Value="_activo" Label="Rol activo" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="text-secondary">Los roles inactivos no se pueden asignar a usuarios</MudText>
                </div>
            }
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public RolDto? Rol { get; set; }

    private string _codigo = "";
    private string _nombre = "";
    private string _descripcion = "";
    private bool _activo = true;
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        if (IsEdit && Rol is not null)
        {
            _codigo = Rol.Codigo;
            _nombre = Rol.Nombre;
            _descripcion = Rol.Descripcion ?? "";
            _activo = Rol.Activo;
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit && Rol is not null)
            {
                var dto = new ActualizarRolDto
                {
                    Nombre = _nombre,
                    Descripcion = _descripcion,
                    Activo = _activo
                };
                var ok = await Api.PutAsync<RolDto>($"api/roles/{Rol.Id}", dto);
                if (ok is not null)
                {
                    Snackbar.Add("Rol actualizado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar rol";
            }
            else
            {
                var dto = new CrearRolDto
                {
                    Codigo = _codigo,
                    Nombre = _nombre,
                    Descripcion = _descripcion
                };
                var result = await Api.PostAsync<RolDto>("api/roles", dto);
                if (result is not null)
                {
                    Snackbar.Add("Rol creado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear rol";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
