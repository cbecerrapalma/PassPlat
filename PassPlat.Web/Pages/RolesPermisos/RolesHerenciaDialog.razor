@inject ApiClient Api
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@Icons.Material.Filled.AccountTree" Texto="@(Tipo == "Padre" ? "Agregar Rol Padre" : "Agregar Rol Hijo")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudText Typo="Typo.body2">
                Selecciona un rol @(Tipo == "Padre" ? "del cual" : "que") <strong>@RolActualNombre</strong>
                @(Tipo == "Padre" ? " herede permisos" : " herede sus permisos").
            </MudText>
            <MudSelect T="RolDto" Label="@(Tipo == "Padre" ? "Rol Padre" : "Rol Hijo")"
                Variant="Variant.Outlined" FullWidth="true" AnchorOrigin="Origin.BottomCenter"
                @bind-Value="_rolSeleccionado" Required="true" ErrorId="@("rol-select")"
                ToStringFunc="@(r => r?.Nombre ?? "")">
                @foreach (var rol in RolesDisponibles)
                {
                    <MudSelectItem @key="rol.Id" Value="rol" Disabled="@EstaDeshabilitado(rol)">
                        <div class="d-flex align-center" style="gap:8px;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @rol.Codigo
                            </MudChip>
                            <MudText Typo="Typo.body2">@rol.Nombre</MudText>
                        </div>
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="@_guardando">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="Agregar" Guardando="@_guardando" OnClick="Guardar" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;
    [Parameter] public int IdTenant { get; set; }
    [Parameter] public int IdRolActual { get; set; }
    [Parameter] public string RolActualNombre { get; set; } = string.Empty;
    [Parameter] public List<RolDto> RolesDisponibles { get; set; } = [];
    [Parameter] public string Tipo { get; set; } = "Padre";

    private RolDto? _rolSeleccionado;
    private bool _guardando;
    private MudForm _form = null!;

    private bool EstaDeshabilitado(RolDto rol) => false;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _rolSeleccionado is null) return;
        _guardando = true;
        try
        {
            var dto = new CrearRolesHerenciaDto
            {
                IdRolPadre = Tipo == "Padre" ? _rolSeleccionado.Id : IdRolActual,
                IdRolHijo = Tipo == "Hijo" ? _rolSeleccionado.Id : IdRolActual,
                IdTenant = IdTenant
            };
            var result = await Api.PostAsync<RolesHerenciaDto>("api/RolesHerencia", dto);
            if (result is not null)
                MudDialog.Close(DialogResult.Ok(true));
            else
                _errorServidor = Api.LastError ?? "Error al crear herencia";
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally { _guardando = false; }
    }

    public async ValueTask DisposeAsync() => await Task.CompletedTask;
}
