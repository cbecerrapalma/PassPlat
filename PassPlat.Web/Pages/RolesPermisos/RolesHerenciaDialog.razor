@inject ApiClient Api
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-1" Color="Color.Primary" />
            @(Tipo == "Padre" ? "Agregar Rol Padre" : "Agregar Rol Hijo")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Seleccione un rol @(Tipo == "Padre" ? "del cual" : "que") <strong>@RolActualNombre</strong>
            @(Tipo == "Padre" ? " herede permisos" : " herede sus permisos").
        </MudText>
        <MudSelect T="RolDto?" Label="@(Tipo == "Padre" ? "Rol Padre" : "Rol Hijo")"
            Variant="Variant.Outlined" FullWidth="true" AnchorOrigin="Origin.BottomCenter"
            @bind-Value="_rolSeleccionado" Required="true" ErrorId="@("rol-select")"
            ResetValueOnEmptyText="true" ToStringFunc="@(r => r?.Nombre ?? "")">
            @foreach (var rol in RolesDisponibles)
            {
                <MudSelectItem @key="rol.Id" Value="rol" Disabled="@EstaDeshabilitado(rol)">
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @rol.Codigo
                        </MudChip>
                        <MudText Typo="Typo.body2">@rol.Nombre</MudText>
                    </div>
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancelar" Disabled="@_guardando">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="Guardar" Disabled="@(_rolSeleccionado is null || _guardando)"
            StartIcon="@Icons.Material.Filled.Save">
            @(_guardando ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int IdTenant { get; set; }
    [Parameter] public int IdRolActual { get; set; }
    [Parameter] public string RolActualNombre { get; set; } = string.Empty;
    [Parameter] public List<RolDto> RolesDisponibles { get; set; } = [];
    [Parameter] public string Tipo { get; set; } = "Padre";

    private RolDto? _rolSeleccionado;
    private bool _guardando;

    private bool EstaDeshabilitado(RolDto rol) => false;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        if (_rolSeleccionado is null) return;
        _guardando = true;
        try
        {
            var dto = new CrearRolesHerenciaDto
            {
                IdRolPadre = Tipo == "Padre" ? _rolSeleccionado.Id : IdRolActual,
                IdRolHijo = Tipo == "Hijo" ? _rolSeleccionado.Id : IdRolActual,
                IdTenant = IdTenant
            };
            var result = await Api.PostAsync<RolesHerenciaDto>("api/RolesHerencia", dto);
            if (result is not null)
                MudDialog.Close(DialogResult.Ok(true));
            else
                Snackbar.Add(Api.LastError ?? "Error al crear herencia", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally { _guardando = false; }
    }

    public async ValueTask DisposeAsync() => await Task.CompletedTask;
}
