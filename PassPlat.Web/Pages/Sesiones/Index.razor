@page "/sesiones"
@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("SESIONES_VER"))
{
    <SinPermiso PermisoRequerido="SESIONES_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Sesiones</h1>
                <p class="page-subtitle">Sesiones activas por usuario.</p>
            </div>
            <div class="page-actions">
                <MudButton StartIcon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error" Variant="Variant.Outlined"
                    OnClick="@RevocarTodas" Disabled="@(_items.Count == 0)">
                    Cerrar todas
                </MudButton>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_items.Count.ToString()" Label="Sesiones" Subtexto="En página actual" Icon="@Icons.Material.Filled.LockClock" ColorClass="primary" />
        <IamKpiCard Valor="@_items.Count(s => s.EsActiva).ToString()" Label="Activas" Subtexto="Vigentes" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_items.Count(s => !s.EsActiva).ToString()" Label="Inactivas" Subtexto="Cerradas/Expiradas" Icon="@Icons.Material.Filled.Cancel" ColorClass="warning" />
        <IamKpiCard Valor="@_items.Select(s => s.IdUsuario).Distinct().Count().ToString()" Label="Usuarios" Subtexto="Con sesión abierta" Icon="@Icons.Material.Filled.People" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <div class="table-toolbar filter-row">
                <SelectorCatalogo T="UsuarioDto" Class="lista-filtro" Items="_usuarios" @bind-Value="_usuarioSelected" @bind-Value:after="@LoadData"
                    SearchTextSelector="@(u => $"{u.NomUsuario} {u.Nombre} {u.Apellido} {u.Email}")"
                    ToStringFunc="@(u => u is null ? "" : $"{u.NomUsuario} ({u.Nombre} {u.Apellido})")"
                    Label="Filtrar por Usuario" Variant="Variant.Outlined" Clearable="true" />
                <SelectorCatalogo T="TenantDto" Class="lista-filtro" Items="_tenants" @bind-Value="_tenantSelected" @bind-Value:after="@LoadData"
                    SearchTextSelector="@(t => $"{t.Nombre} {t.Codigo}")"
                    ToStringFunc="@(t => t is null ? "" : $"{t.Nombre} ({t.Codigo})")"
                    Label="Filtrar por Tenant" Variant="Variant.Outlined" Clearable="true" />
                <MudSelect T="string" Value="_appFiltro" ValueChanged="@OnAppFiltroChanged" Label="App"
                           Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                    @foreach (var app in _appsFiltro)
                    {
                        <MudSelectItem Value="@app">@app</MudSelectItem>
                    }
                </MudSelect>
                <div class="toolbar-spacer"></div>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Medium"
                    OnClick="@LoadData" aria-label="Refrescar" />
            </div>
            <div class="table-wrap">
    <MudTable T="SesionDto" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm">
        <ColGroup>
            <col style="width:120px;" /><col style="width:100px;" /><col /><col /><col style="width:120px;" /><col style="width:160px;" /><col style="width:120px;" /><col style="width:160px;" /><col style="width:90px;" /><col style="width:90px;" /><col style="width:140px;" /><col style="width:120px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh>Id</MudTh><MudTh>Usuario</MudTh><MudTh>Dispositivo</MudTh><MudTh>IP / País</MudTh><MudTh>Proveedor</MudTh><MudTh>Creada</MudTh><MudTh>Expira</MudTh><MudTh>Últ. actividad</MudTh><MudTh>Navegador</MudTh><MudTh>SO</MudTh><MudTh>App</MudTh><MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id.ToString()[..8]</MudTd>
            <MudTd DataLabel="Usuario">@context.UsuarioNombre</MudTd>
            <MudTd DataLabel="Dispositivo">@(context.DispModelo ?? "-")</MudTd>
            <MudTd DataLabel="IP / País">@context.IPDireccion<br /><MudText Typo="Typo.caption">@context.Pais</MudText></MudTd>
            <MudTd DataLabel="Proveedor">@(context.ProveedorAuth ?? "Local")</MudTd>
            <MudTd DataLabel="Creada">@context.FecInicio.ToString("g")</MudTd>
            <MudTd DataLabel="Expira">@context.FecExpira.ToString("g")</MudTd>
            <MudTd DataLabel="Últ. actividad">@context.UltActividad.ToString("g")</MudTd>
            <MudTd DataLabel="Navegador">@context.Navegador</MudTd>
            <MudTd DataLabel="SO">@context.SO</MudTd>
            <MudTd DataLabel="App">@(context.AppNombre ?? "-")</MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Color="Color.Warning"
                               OnClick="@(() => Revocar(context.Id))" aria-label="Cerrar sesión" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-6">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" />
                No hay registros
            </MudText>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

    <MudOverlay Visible="@_loading" />
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="mt-4" />
    }
</div>
}

@code {
    private List<SesionDto> _items = [];
    private bool _loading;
    private int _idUsuario;
    private int _idTenant;
    private List<UsuarioDto> _usuarios = [];
    private List<TenantDto> _tenants = [];
    private List<string> _appsFiltro = [];
    private UsuarioDto? _usuarioSelected;
    private TenantDto? _tenantSelected;
    private string? _appFiltro;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("SESIONES_VER")) return;
        var tUsuarios = Api.GetAsync<List<UsuarioDto>>("api/usuarios");
        var tTenants = TenantsObjetivo.CargarAsync(Api, Auth); // S113 · D4
        await Task.WhenAll(tUsuarios, tTenants);
        _usuarios = tUsuarios.Result ?? [];
        _tenants = tTenants.Result ?? [];

        _idUsuario = Auth.IdUsuario ?? 0;
        _idTenant = Auth.IdTenant ?? 0;
        _usuarioSelected = _usuarios.FirstOrDefault(u => u.Id == _idUsuario);
        _tenantSelected = _tenants.FirstOrDefault(t => t.Id == _idTenant);
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _idUsuario = _usuarioSelected?.Id ?? 0;
            _idTenant = _tenantSelected?.Id ?? 0;
            // ETAPA 5: cargar todas las sesiones activas del tenant (administración)
            var data = await Api.GetAsync<List<SesionDto>>("api/sesiones/activas-tenant");
            _items = data ?? [];
            // Filtrar en cliente por usuario/tenant seleccionado (opcional)
            if (_idUsuario > 0)
                _items = _items.Where(s => s.IdUsuario == _idUsuario).ToList();
            if (_idTenant > 0)
                _items = _items.Where(s => s.IdTenant == _idTenant).ToList();
            if (!string.IsNullOrWhiteSpace(_appFiltro))
                _items = _items.Where(s => s.AppNombre == _appFiltro).ToList();

            // S85 · D4 — opciones del filtro App a partir de la lista cargada
            _appsFiltro = _items
                .Select(s => s.AppNombre ?? string.Empty)
                .Where(n => n.Length > 0)
                .Distinct()
                .OrderBy(n => n)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private void OnAppFiltroChanged(string? app)
    {
        _appFiltro = app;
        StateHasChanged();
    }

    private async Task Revocar(Guid idSesion)
    {
        var ok = await Api.PostVoidAsync($"api/sesiones/{idSesion}/revocar");
        if (ok)
        {
            Snackbar.Add("Sesión revocada", Severity.Success);
            await LoadData();
        }
        else
            Snackbar.Add(Api.LastError ?? "Error al revocar sesión", Severity.Error);
    }

    // ETAPA 5: cerrar todas las sesiones del tenant (auditoría implícita vía SP)
    private async Task RevocarTodas()
    {
        var ok = await Api.PostVoidAsync("api/sesiones/revocar-todas-tenant");
        if (ok)
        {
            Snackbar.Add("Todas las sesiones del tenant han sido cerradas", Severity.Success);
            await LoadData();
        }
        else
            Snackbar.Add(Api.LastError ?? "Error al cerrar las sesiones", Severity.Error);
    }
}
