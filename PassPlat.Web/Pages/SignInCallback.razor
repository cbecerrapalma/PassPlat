@page "/signin-callback"
@layout LoginLayout
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-wrapper">
    <MudPaper Elevation="0" Class="login-card px-8 py-10" Style="width: 100%; max-width: 420px; border-radius: 16px;">
        <div class="d-flex flex-column align-center mb-6">
            <div class="login-logo mb-3">
                <div class="login-logo-ring" />
                <div class="login-logo-inner">
                    <span class="login-logo-icon">&#x1F512;</span>
                </div>
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold text-white">AccessPlat</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray">@_mensaje</MudText>
        </div>
        <div class="d-flex justify-center mb-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        </div>
        @if (_showError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_mensaje</MudAlert>
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="@VolverLogin" Size="Size.Large">
                Volver al inicio de sesión
            </MudButton>
        }
    </MudPaper>
</div>

@code {
    private bool _showError;
    private string _mensaje = "Procesando inicio de sesión...";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // S125 · D5 — la API devuelve un código de un solo uso en la query; los tokens ya no viajan en la URL.
            var uri = Nav.ToAbsoluteUri(Nav.Uri);

            // S128 · D5 — un error del callback se muestra en /login, como antes de que volviera aquí.
            var error = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("error");
            if (!string.IsNullOrEmpty(error))
            {
                Nav.NavigateTo($"/login?error={Uri.EscapeDataString(error)}", replace: true);
                return;
            }

            var codigo = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("codigo");

            if (string.IsNullOrEmpty(codigo))
            {
                _mensaje = "No se recibió el código del proveedor.";
                _showError = true;
                StateHasChanged();
                return;
            }

            var result = await Auth.CanjearCodigoExternoAsync(codigo);
            if (!result.Success)
            {
                _mensaje = result.ErrorMessage ?? "No se pudo completar el inicio de sesión.";
                _showError = true;
                StateHasChanged();
                return;
            }

            Nav.NavigateTo(Auth.ReqCambioPwd ? "/cambiar-password" : "/");
        }
        catch (Exception ex)
        {
            _mensaje = $"Error al procesar la autenticación: {ex.Message}";
            _showError = true;
            StateHasChanged();
        }
    }

    private void VolverLogin()
    {
        Nav.NavigateTo("/login");
    }
}
