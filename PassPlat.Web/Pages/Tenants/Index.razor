@page "/tenants"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared

@if (!Auth.TienePermiso("TENANTS_VER"))
{
    <SinPermiso PermisoRequerido="TENANTS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Tenants</h1>
                <p class="page-subtitle">Organizaciones registradas en la plataforma y sus dominios.</p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                    Nuevo Tenant
                </MudButton>
            </div>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCount" Label="Total Tenants" Subtexto="Registrados en sistema" Icon="@Icons.Material.Filled.Business" ColorClass="primary" />
        <IamKpiCard Valor="@_activosCount" Label="Activos" Subtexto="Vigentes" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        @{
            var inactivosCount = (int.TryParse(_totalCount, out var t) && int.TryParse(_activosCount, out var a)) ? (t - a).ToString() : "—";
        }
        <IamKpiCard Valor="@inactivosCount" Label="Inactivos" Subtexto="Deshabilitados" Icon="@Icons.Material.Filled.Cancel" ColorClass="warning" />
        <IamKpiCard Valor="@_dominiosCount" Label="Dominios" Subtexto="Asociados" Icon="@Icons.Material.Filled.Language" ColorClass="info" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true" SearchLabel="Buscar por código o nombre..."
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@Refrescar" ShowCreate="false">
                <Filtros>
                    <MudSelect T="bool?" Value="_estadoFiltro" ValueChanged="@OnEstadoChanged" Label="Estado"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="lista-filtro">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Activos</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Inactivos</MudSelectItem>
                    </MudSelect>
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
    <MudTable T="TenantDto" Items="@_itemsFiltrados" Hover="true" Breakpoint="Breakpoint.Sm"
        RowStyle="cursor: pointer;" OnRowClick="@((TableRowClickEventArgs<TenantDto> e) => VerDetalle(e.Item))">
        <ColGroup>
            <col style="width: 50px;" /><col /><col /><col style="width: 90px;" /><col style="width: 100px;" /><col style="width: 60px;" />
        </ColGroup>
        <HeaderContent>
            <MudTh></MudTh><MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Tipo</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudAvatar Size="Size.Small" Color="@GetAvatarColor(context.Nombre)" Class="row-avatar">
                    <MudText Typo="Typo.caption">@context.Nombre[..Math.Min(2, context.Nombre.Length)]</MudText>
                </MudAvatar>
            </MudTd>
            <MudTd DataLabel="Código">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Codigo</MudText>
            </MudTd>
            <MudTd DataLabel="Nombre">
                <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Nombre</MudText>
            </MudTd>
            <MudTd DataLabel="Tipo">
                @if (context.EsSistema)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Security">Sistema</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Normal</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                    @(context.Activo ? "Activo" : "Inactivo")
                </MudChip>
            </MudTd>
            <MudTd>
                <div @onclick:stopPropagation="true" class="table-actions">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Acciones de {context.Nombre}")">
                        <MudMenuItem OnClick="@(() => VerDetalle(context))">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Class="mr-2" Color="Color.Info" />
                            Ver detalle
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => OpenEditDialog(context))">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />
                            Editar
                        </MudMenuItem>
                        @if (!context.EsSistema)
                        {
                            <MudMenuItem OnClick="@(() => ConfirmDelete(context))">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" Color="Color.Error" />
                                Desactivar
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
        <NoRecordsContent>
            <div class="d-flex flex-column align-center py-8">
                <MudAvatar Size="Size.Large" Color="Color.Default" Variant="Variant.Outlined" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Sin tenants</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary mb-4">No se encontraron tenants en el sistema</MudText>
                @if (Auth.TienePermiso("TENANTS_CREAR"))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OpenCreateDialog"
                        StartIcon="@Icons.Material.Filled.Add">
                        Crear primer tenant
                    </MudButton>
                }
            </div>
        </NoRecordsContent>
    </MudTable>
            </div>
        </div>
    </div>

</div>
}

@code {
    private List<TenantDto> _items = [];
    private string _searchString = "";
    private bool? _estadoFiltro;
    private string _totalCount = "0";
    private string _activosCount = "0";
    private string _dominiosCount = "0";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("TENANTS_VER")) return;
        await CargarTenants();
        await LoadKpis();
    }

    // S85 · D4 — la lista completa se filtra en memoria (buscador y estado)
    private List<TenantDto> _itemsFiltrados
    {
        get
        {
            var filtrados = _items;
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                filtrados = filtrados.Where(t =>
                    t.Codigo.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    t.Nombre.Contains(s, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            if (_estadoFiltro is bool estado)
                filtrados = filtrados.Where(t => t.Activo == estado).ToList();
            return filtrados;
        }
    }

    private async Task CargarTenants()
    {
        try
        {
            // S85 · D4 (decisión del dueño en ejecución) — la lista sale de /page con el tope de 100 y se filtra en memoria
            var respuesta = await Api.GetAsync<PagedResponse<TenantDto>>("api/tenants/page?pageNumber=1&pageSize=100");
            _items = respuesta?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _searchString = value;
        StateHasChanged();
    }

    private void OnEstadoChanged(bool? estado)
    {
        _estadoFiltro = estado;
        StateHasChanged();
    }

    private async Task LoadKpis()
    {
        try
        {
            var totalTask = Api.GetAsync<object>("api/tenants/count");
            var activosTask = Api.GetAsync<object>("api/tenants/activos/count");
            var dominiosTask = Api.GetAsync<object>("api/dominiosTenant/count");
            await Task.WhenAll(totalTask, activosTask, dominiosTask);
            _totalCount = totalTask.Result?.ToString() ?? "0";
            _activosCount = activosTask.Result?.ToString() ?? "0";
            _dominiosCount = dominiosTask.Result?.ToString() ?? "0";
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar KPIs: {ex.Message}", Severity.Error);
        }
    }

    private async Task Refrescar()
    {
        await CargarTenants();
        await LoadKpis();
    }

    private void VerDetalle(TenantDto? tenant)
    {
        if (tenant is not null) Navigation.NavigateTo($"/tenant/{tenant.Id}");
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["IsEdit"] = false };
        var dialog = await Dialog.ShowAsync<TenantDialog>("Nuevo Tenant", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Refrescar();
    }

    private async Task OpenEditDialog(TenantDto tenant)
    {
        var parameters = new DialogParameters { ["IsEdit"] = true, ["Tenant"] = tenant };
        var dialog = await Dialog.ShowAsync<TenantDialog>("Editar Tenant", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Refrescar();
    }

    private async Task ConfirmDelete(TenantDto tenant)
    {
        if (tenant.EsSistema)
        {
            Snackbar.Add("No se puede desactivar el tenant del sistema", Severity.Warning);
            return;
        }
        var parameters = new DialogParameters
        {
            ["Title"] = "Desactivar Tenant",
            ["Message"] = $"¿Está seguro que desea desactivar el tenant \"{tenant.Nombre}\" ({tenant.Codigo})? Esta acción deshabilitará el acceso de todos los usuarios asociados.",
            ["ConfirmText"] = "Sí, desactivar",
            ["CancelText"] = "Cancelar"
        };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.PostAsync<object>($"api/tenants/{tenant.Id}/desactivar");
            if (ok is not null)
            {
                Snackbar.Add($"Tenant \"{tenant.Nombre}\" desactivado", Severity.Success);
                await Refrescar();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al desactivar", Severity.Error);
        }
    }

    private static Color GetAvatarColor(string nombre) => nombre.Length switch
    {
        >= 3 when nombre.StartsWith("P") => Color.Primary,
        >= 3 when nombre.StartsWith("A") => Color.Secondary,
        >= 3 when nombre.StartsWith("S") => Color.Info,
        _ => Color.Default
    };
}
