@page "/tenant/{id:int}"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Pages.DominiosTenant

@if (!Auth.TienePermiso("TENANTS_VER"))
{
    <SinPermiso PermisoRequerido="TENANTS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan Padre="/tenants" Actual="@(_tenant?.Nombre ?? "Detalle")" />

    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Style="border-radius:10px;" />
    }
    else if (_tenant is null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">Tenant no encontrado</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/tenants">Atrás</MudButton>
    }
    else
    {
        <div class="page-header">
            <div class="page-title-row">
                <div style="display:flex;gap:12px;align-items:center;">
                    <h1 class="page-title">@_tenant.Nombre</h1>
                    @if (_tenant.Codigo == "SISTEMA")
                    {
                        <span class="badge badge-default"><span class="badge-dot"></span>SISTEMA</span>
                    }
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/tenants">Atrás</MudButton>
                </div>
            </div>
        </div>

        <MudTabs Class="detail-tabs" TabPanelsClass="pt-3">
            <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Info">
                <div class="detail-section">
                    <div class="detail-section-title">Datos del tenant</div>
                    <div class="readonly-grid">
                        <div class="readonly-item"><div class="field-label">Código</div><div class="field-value">@_tenant.Codigo</div></div>
                        <div class="readonly-item"><div class="field-label">Creado</div><div class="field-value">@_tenant.FecCrea.ToString("dd/MM/yyyy HH:mm")</div></div>
                    </div>
                    <div class="form-grid mt-3">
                        <MudTextField @bind-Value="_tenant.Nombre" Label="Nombre" Variant="Variant.Outlined" />
                        <div class="form-field-check">
                            <MudSwitch @bind-Value="_tenant.Activo" Label="Activo" Color="Color.Primary" />
                        </div>
                    </div>
                    <div class="form-savebar">
                        <BotonGuardarDialogo Texto="Guardar" Guardando="@_saving" OnClick="@GuardarTenant" />
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Dominios" Icon="@Icons.Material.Filled.Language">
                <div class="detail-section">
                    <div class="d-flex align-center mb-2">
                        <div class="detail-section-title flex-grow-1">Dominios</div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirDialogDominio">
                            Agregar Dominio
                        </MudButton>
                    </div>
                    <MudTable T="DominioTenantDto" Items="@_dominios" Hover="true" Breakpoint="Breakpoint.Sm">
                        <ColGroup>
                            <col style="width: 80px;" />
                            <col />
                            <col style="width: 100px;" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>Id</MudTh>
                            <MudTh>Dominio</MudTh>
                            <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Id">@context.Id</MudTd>
                            <MudTd DataLabel="Dominio">@context.Dominio</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                    OnClick="@(() => EditarDominio(context))" / aria-label="Editar" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                    OnClick="@(() => EliminarDominio(context))" / aria-label="Eliminar" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Align="Align.Center" Class="py-8">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Class="mb-2" />
                                <br />No hay dominios registrados
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Config" Icon="@Icons.Material.Filled.Settings">
                <div class="detail-section">
                    <div class="detail-section-title">Configuración</div>
                    @if (_config is null)
                    {
                        <MudAlert Severity="Severity.Warning">No hay configuración para este tenant</MudAlert>
                    }
                    else
                    {
                        <div class="readonly-grid">
                            <div class="readonly-item"><div class="field-label">Timeout sesión (min)</div><div class="field-value">@_config.TimeoutSesionMin</div></div>
                            <div class="readonly-item"><div class="field-label">Máx. sesiones concurrentes</div><div class="field-value">@_config.MaxSesionesConc</div></div>
                            <div class="readonly-item"><div class="field-label">Días retención auditoría</div><div class="field-value">@_config.DiasRetAuditoria</div></div>
                            <div class="readonly-item"><div class="field-label">MFA obligatorio</div><div class="field-value">@(_config.ReqMFA ? "Sí" : "No")</div></div>
                            <div class="readonly-item"><div class="field-label">Versión de pepper</div><div class="field-value">@_config.PepperVersionActual</div></div>
                        </div>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    }
</div>
}

@code {
    [Parameter] public int Id { get; set; }

    private TenantDto? _tenant;
    private List<DominioTenantDto> _dominios = [];
    private ConfigTenantDto? _config;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("TENANTS_VER")) return;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _loading = true;
        try
        {
            var tenantTask = Api.GetAsync<TenantDto>($"api/tenants/{Id}");
            var dominiosTask = Api.GetAsync<List<DominioTenantDto>>($"api/DominiosTenant/tenant/{Id}");
            var configTask = Api.GetAsync<ConfigTenantDto>($"api/configtenants/tenant/{Id}");

            await Task.WhenAll(tenantTask, dominiosTask, configTask);

            if (tenantTask.Result is not null)
                _tenant = tenantTask.Result;
            _dominios = dominiosTask.Result ?? [];
            _config = configTask.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GuardarTenant()
    {
        if (_tenant is null) return;
        _saving = true;
        try
        {
            var ok = await Api.PutAsync<TenantDto>($"api/tenants/{_tenant.Id}",
                new { nombre = _tenant.Nombre, activo = _tenant.Activo });
            if (ok is not null)
                Snackbar.Add("Tenant actualizado", Severity.Success);
            else
                Snackbar.Add(Api.LastError ?? "Error al actualizar", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AbrirDialogDominio()
    {
        if (_tenant is null) return;
        // S101 · D5 — diálogo único: tenant fijo, el diálogo guarda y aquí solo se recarga
        var parameters = new DialogParameters { ["IdTenant"] = Id };
        var dialog = await Dialog.ShowAsync<DominioTenantDialog>("Agregar Dominio", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        if (await dialog.Result is { Canceled: false })
            await CargarDatos();
    }

    private async Task EditarDominio(DominioTenantDto dominio)
    {
        var parameters = new DialogParameters { ["IdTenant"] = Id, ["Dominio"] = dominio };
        var dialog = await Dialog.ShowAsync<DominioTenantDialog>("Editar Dominio", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Compacto));
        if (await dialog.Result is { Canceled: false })
            await CargarDatos();
    }

    private async Task EliminarDominio(DominioTenantDto dominio)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Eliminar Dominio",
            ["Message"] = $"¿Está seguro de eliminar el dominio \"{dominio.Dominio}\"?",
            ["ConfirmText"] = "Eliminar",
            ["ConfirmColor"] = Color.Error
        };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("Confirmar", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await EliminarDominioConfirmadoAsync(dominio.Id);
        }
    }

    private async Task EliminarDominioConfirmadoAsync(int id)
    {
        try
        {
            var ok = await Api.DeleteAsync($"api/DominiosTenant/{id}");
            if (ok)
            {
                Snackbar.Add("Dominio eliminado", Severity.Success);
                await CargarDatos();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al eliminar dominio", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
    }
}
