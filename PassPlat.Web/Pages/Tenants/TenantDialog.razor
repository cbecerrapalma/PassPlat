@inject ApiClient Api
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Compacto)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Texto="@(IsEdit ? "Editar Tenant" : "Nuevo Tenant")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="dialogo-campos">
            <MudTextField @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Disabled="@IsEdit" Required="true"
                          RequiredError="El código es requerido" />
            <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" Required="true"
                          RequiredError="El nombre es requerido" />
            <MudSwitch @bind-Value="_activo" Label="Activo" Color="Color.Primary" />
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public TenantDto? Tenant { get; set; }

    private string _codigo = "";
    private string _nombre = "";
    private bool _activo = true;
    private bool _saving;
    private MudForm _form = null!;

    protected override void OnInitialized()
    {
        if (IsEdit && Tenant is not null)
        {
            _codigo = Tenant.Codigo;
            _nombre = Tenant.Nombre;
            _activo = Tenant.Activo;
        }
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await Api.PutAsync<TenantDto>($"api/tenants/{Tenant!.Id}",
                    new { id = Tenant.Id, codigo = _codigo, nombre = _nombre, activo = _activo });
                if (ok is not null)
                {
                    Snackbar.Add("Tenant actualizado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar";
            }
            else
            {
                var result = await Api.PostAsync<TenantDto>("api/tenants",
                    new { codigo = _codigo, nombre = _nombre });
                if (result is not null)
                {
                    Snackbar.Add("Tenant creado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = Api.LastError ?? $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
