@using PassPlat.Aplicacion.Dtos.Core
@inject ApiClient Api
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton Width="100%" Height="200px" />
}
else if (_items.Count == 0)
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Bloqueos aplicados a la cuenta.
        </MudText>
        <MudText Align="Align.Center" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.Block" Class="mb-2" /><br />Sin bloqueos
        </MudText>
    </MudContainer>
}
else
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Bloqueos aplicados a la cuenta.
        </MudText>
        <MudTable T="BloqueoDto" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col style="width:80px;" /><col /><col /><col /><col style="width:80px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Id</MudTh><MudTh>Tipo</MudTh><MudTh>Inicio</MudTh><MudTh>Fin</MudTh><MudTh>Activo</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Tipo">@context.TipoBloqueoNombre</MudTd>
                <MudTd DataLabel="Inicio">@context.FecInicio.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Fin">@context.FecFin?.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Activo">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Warning : Color.Default)">
                        @(context.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Class="mb-2" /><br />Sin bloqueos
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudContainer>
}

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<int> CountChanged { get; set; }

    private List<BloqueoDto> _items = [];
    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsActive && !_loaded)
        {
            _loaded = true;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _items = await Api.GetAsync<List<BloqueoDto>>($"api/bloqueos/usuario/{UserId}") ?? [];
            await CountChanged.InvokeAsync(_items.Count);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
