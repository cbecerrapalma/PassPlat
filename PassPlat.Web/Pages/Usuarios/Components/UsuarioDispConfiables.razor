@using PassPlat.Aplicacion.Dtos.Core
@inject ApiClient Api
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton Width="100%" Height="200px" />
}
else if (_items.Count == 0)
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Dispositivos marcados como confiables.
        </MudText>
        <MudText Align="Align.Center" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="mb-2" /><br />Sin dispositivos
        </MudText>
    </MudContainer>
}
else
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Dispositivos marcados como confiables.
        </MudText>
        <MudTable T="DispConfiableDto" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col style="width:80px;" /><col /><col /><col /><col style="width:100px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Id</MudTh><MudTh>Dispositivo</MudTh><MudTh>Nombre</MudTh><MudTh>Alta</MudTh><MudTh>Confiable</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Dispositivo">@context.DispModelo</MudTd>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Alta">@context.FecAlta.ToLocalTime().ToShortDateString()</MudTd>
                <MudTd DataLabel="Confiable">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Confiable ? Color.Success : Color.Error)">
                        @(context.Confiable ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="mb-2" /><br />Sin dispositivos
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudContainer>
}

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<int> CountChanged { get; set; }

    private List<DispConfiableDto> _items = [];
    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsActive && !_loaded)
        {
            _loaded = true;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _items = await Api.GetAsync<List<DispConfiableDto>>($"api/DispConfiables/usuario/{UserId}") ?? [];
            await CountChanged.InvokeAsync(_items.Count);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
