@inject ApiClient Api
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton Width="100%" Height="300px" />
}
else if (_usuario is null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">No se pudo cargar la información del usuario</MudAlert>
}
else
{
    <div class="detail-tab-body">
        @* ── Datos de solo lectura (pares etiqueta/valor) ── *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Datos de la cuenta</MudText>
            <div class="readonly-grid">
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Usuario</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@_usuario.NomUsuario</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@(_usuario.Email ?? "Sin email")</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Requiere cambio de contraseña</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@(_usuario.ReqCambioPwd ? "Sí" : "No")</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Email verificado</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@(_usuario.EmailVerificado ? "Sí" : "No")</MudText>
                </div>
            </div>
        </MudPaper>

        @* ── Formulario editable: 2 columnas desde 960 px ── *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Editar usuario</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Los campos marcados con * son editables.</MudText>
            <div class="form-grid">
                <div class="form-field">
                    <MudTextField T="string" Value="_editarEmail" ValueChanged="@(v => _editarEmail = v ?? "")"
                        Label="Email (opcional)" Variant="Variant.Outlined" />
                </div>
                <div class="form-field">
                    <MudTextField T="string" Value="_editarNombre" ValueChanged="@(v => _editarNombre = v ?? "")"
                        Label="Nombre *" Variant="Variant.Outlined" />
                </div>
                <div class="form-field">
                    <MudTextField T="string" Value="_editarApellido" ValueChanged="@(v => _editarApellido = v ?? "")"
                        Label="Apellido *" Variant="Variant.Outlined" />
                </div>
                <div class="form-field form-field-check">
                    <MudSwitch T="bool" Value="@(_usuario.EmailVerificado)" ValueChanged="@(v => _usuario!.EmailVerificado = v)"
                        Label="Email verificado" Color="Color.Primary" />
                </div>
            </div>
            <div class="form-savebar">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-grow-1">
                    Los cambios se aplican al guardar.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@GuardarUsuario" Disabled="@_saving"
                    StartIcon="@Icons.Material.Filled.Save">
                    Guardar cambios
                </MudButton>
            </div>
        </MudPaper>

        @* ── Fechas del registro ── *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Fechas del registro</MudText>
            <div class="readonly-grid readonly-grid-4">
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Creado</MudText>
                    <MudText Typo="Typo.body2">@(_usuario.FecCrea?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Última modificación</MudText>
                    <MudText Typo="Typo.body2">@(_usuario.FecMod?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Último cambio de contraseña</MudText>
                    <MudText Typo="Typo.body2">@(_usuario.FecUltCambioPwd?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudText>
                </div>
                <div class="readonly-item">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Último intento fallido</MudText>
                    <MudText Typo="Typo.body2">@(_usuario.FecUltIntentoFallido?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudText>
                </div>
            </div>
        </MudPaper>
    </div>
}

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    // S58 · D4 — la pagina ya carga el usuario: la ficha no lo vuelve a pedir.
    [Parameter] public UsuarioDto? Usuario { get; set; }

    private UsuarioDto? _usuario;
    private string _editarNombre = "";
    private string _editarApellido = "";
    private string _editarEmail = "";
    private bool _loading = true;
    private bool _saving;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsActive && !_loaded)
        {
            _loaded = true;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _usuario = Usuario ?? await Api.GetAsync<UsuarioDto>($"api/usuarios/{UserId}");
            if (_usuario is not null)
            {
                _editarNombre = _usuario.Nombre;
                _editarApellido = _usuario.Apellido;
                _editarEmail = _usuario.Email ?? "";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GuardarUsuario()
    {
        if (_usuario is null) return;
        _saving = true;
        try
        {
            var ok = await Api.PutVoidAsync("api/usuarios",
                new { id = _usuario.Id, nombre = _editarNombre, apellido = _editarApellido, email = string.IsNullOrWhiteSpace(_editarEmail) ? null : _editarEmail });
            if (ok)
            {
                _usuario.Nombre = _editarNombre;
                _usuario.Apellido = _editarApellido;
                _usuario.Email = string.IsNullOrWhiteSpace(_editarEmail) ? null : _editarEmail;
                Snackbar.Add("Usuario actualizado", Severity.Success);
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al actualizar", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
