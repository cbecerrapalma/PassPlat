@using PassPlat.Aplicacion.Dtos.Core
@inject ApiClient Api
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton Width="100%" Height="200px" />
}
else if (_items.Count == 0)
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Métodos de autenticación multifactor configurados.
        </MudText>
        <MudText Align="Align.Center" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Class="mb-2" /><br />Sin métodos MFA
        </MudText>
    </MudContainer>
}
else
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Métodos de autenticación multifactor configurados.
        </MudText>
        <MudTable T="MFADto" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col style="width:80px;" /><col /><col /><col /><col style="width:80px;" /><col style="width:140px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Id</MudTh><MudTh>Tipo</MudTh><MudTh>Identificador</MudTh><MudTh>Estado</MudTh><MudTh>Principal</MudTh><MudTh>Alta</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Tipo">@context.TipoMFANombre</MudTd>
                <MudTd DataLabel="Identificador">@context.IdMFA</MudTd>
                <MudTd DataLabel="Estado">@context.EstadoMFANombre</MudTd>
                <MudTd DataLabel="Principal">
                    <MudChip T="string" Size="Size.Small" Color="@(context.EsPrincipal ? Color.Success : Color.Default)">
                        @(context.EsPrincipal ? "Sí" : "No")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Alta">@context.FecAlta.ToLocalTime().ToString("g")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Class="mb-2" /><br />Sin métodos MFA
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudContainer>
}

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<int> CountChanged { get; set; }

    private List<MFADto> _items = [];
    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsActive && !_loaded)
        {
            _loaded = true;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _items = await Api.GetAsync<List<MFADto>>($"api/mfa/metodos/{UserId}") ?? [];
            await CountChanged.InvokeAsync(_items.Count);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
