@using PassPlat.Aplicacion.Dtos.Core
@inject ApiClient Api
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudSkeleton Width="100%" Height="200px" />
}
else if (_items.Count == 0)
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Notificaciones enviadas al usuario.
        </MudText>
        <MudText Align="Align.Center" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="mb-2" /><br />Sin notificaciones
        </MudText>
    </MudContainer>
}
else
{
    <MudContainer Class="mt-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            Notificaciones enviadas al usuario.
        </MudText>
        <MudTable T="NotificacionDto" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col style="width:80px;" /><col /><col /><col /><col />
            </ColGroup>
            <HeaderContent>
                <MudTh>Id</MudTh><MudTh>Asunto</MudTh><MudTh>Mensaje</MudTh><MudTh>Leída</MudTh><MudTh>Fecha</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Asunto">@context.Asunto</MudTd>
                <MudTd DataLabel="Mensaje">@context.Mensaje</MudTd>
                <MudTd DataLabel="Leída">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Leida ? Color.Default : Color.Warning)">
                        @(context.Leida ? "Sí" : "No")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Fecha">@context.FecCrea.ToLocalTime().ToString("g")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="mb-2" /><br />Sin notificaciones
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudContainer>
}

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<int> CountChanged { get; set; }

    private List<NotificacionDto> _items = [];
    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsActive && !_loaded)
        {
            _loaded = true;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _items = await Api.GetAsync<List<NotificacionDto>>($"api/notificaciones/no-leidas/{UserId}") ?? [];
            await CountChanged.InvokeAsync(_items.Count);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
