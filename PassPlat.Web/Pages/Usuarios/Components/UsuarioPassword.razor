@using PassPlat.Aplicacion.Dtos.Core
@using PassPlat.Web.Models
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject AuthService Auth

<MudContainer Class="mt-2">
    @* Password info card *@
    @if (UserInfo is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                Información de contraseña
            </MudText>
            <MudGrid>
                <MudItem xs6 sm3>
                    <MudText Typo="Typo.caption">Último cambio</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                        @(UserInfo.FecUltCambioPwd?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                    </MudText>
                </MudItem>
                <MudItem xs6 sm3>
                    <MudText Typo="Typo.caption">Requiere cambio</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                        @(UserInfo.ReqCambioPwd ? "Sí" : "No")
                    </MudText>
                </MudItem>
                <MudItem xs6 sm3>
                    <MudText Typo="Typo.caption">Intentos fallidos</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@UserInfo.IntentosFallidos</MudText>
                </MudItem>
                <MudItem xs6 sm3>
                    <MudText Typo="Typo.caption">Email verificado</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@(UserInfo.EmailVerificado ? "Sí" : "No")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @* Admin password change form *@
    @if (Auth.EsSistema)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Small" Class="mr-1" />
                Cambiar contraseña
            </MudText>
            <MudGrid>
                <MudItem xs12 md6>
                    <div class="d-flex align-center gap-2 flex-grow-1">
                        @if (_showPassword)
                        {
                            <MudTextField @bind-Value="_newPassword" Label="Nueva contraseña"
                                          Variant="Variant.Outlined" Class="flex-grow-1 mb-0"
                                          InputType="InputType.Text" Immediate="true" Autocomplete="new-password" />
                        }
                        else
                        {
                            <MudTextField @bind-Value="_newPassword" Label="Nueva contraseña"
                                          Variant="Variant.Outlined" Class="flex-grow-1 mb-0"
                                          InputType="InputType.Password" Immediate="true" Autocomplete="new-password" />
                        }
                        <MudIconButton Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       Color="Color.Default" OnClick="@(() => _showPassword = !_showPassword)"
                                       Size="Size.Small" />
                    </div>
                </MudItem>
                <MudItem xs12 md6>
                    <div class="d-flex align-center gap-2">
                        @if (_showPassword)
                        {
                            <MudTextField @bind-Value="_confirmPassword"
                                          Label="Confirmar contraseña"
                                          Variant="Variant.Outlined"
                                          Class="flex-grow-1"
                                          InputType="InputType.Text"
                                          Autocomplete="new-password"
                                          Error="@(!string.IsNullOrEmpty(_confirmPassword) && _newPassword != _confirmPassword)"
                                          ErrorText="Las contraseñas no coinciden" />
                        }
                        else
                        {
                            <MudTextField @bind-Value="_confirmPassword"
                                          Label="Confirmar contraseña"
                                          Variant="Variant.Outlined"
                                          Class="flex-grow-1"
                                          InputType="InputType.Password"
                                          Autocomplete="new-password"
                                          Error="@(!string.IsNullOrEmpty(_confirmPassword) && _newPassword != _confirmPassword)"
                                          ErrorText="Las contraseñas no coinciden" />
                        }
                        <MudTooltip Text="Generar contraseña segura">
                            <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary"
                                           Disabled="@_generating"
                                           OnClick="@GenerarPassword" Size="Size.Small"
                                           Style="margin-top: -4px;" />
                        </MudTooltip>
                    </div>
                </MudItem>
                <MudItem xs12>
                    <PasswordStrength Password="@_newPassword" NomUsuario="@(UserInfo?.NomUsuario)" Email="@(UserInfo?.Email)"
                                      OnStrengthChanged="@OnStrengthChanged" />
                </MudItem>
                <MudItem xs12>
                    <div class="d-flex align-center gap-2 pt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="@CambiarPassword"
                                   Disabled="@(!CanSavePassword())">
                            @(_saving ? "Cambiando…" : "Cambiar contraseña")
                        </MudButton>
                        @if (_strengthResult != null && !_strengthResult.IsValid)
                        {
                            <MudText Typo="Typo.caption" Class="error-text">La contraseña no cumple los requisitos</MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @* Password history *@
    <UsuarioHistorialPwd UserId="UserId" IsActive="IsActive" Version="@HistoryVersion" CountChanged="@CountChanged" />
</MudContainer>

@code {
    [Parameter] public UsuarioDto? UserInfo { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<int> CountChanged { get; set; }
    [Parameter] public EventCallback HistoryChanged { get; set; }
    [Parameter] public int HistoryVersion { get; set; }

    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _saving;
    private bool _generating;
    private bool _showPassword;
    private PoliticaPwdDto? _policy;
    private PasswordStrengthInfoDto? _strengthResult;

    protected override async Task OnInitializedAsync()
    {
        _policy = await Api.GetAsync<PoliticaPwdDto>("api/usuarios/password-policy");
    }

    private bool CanSavePassword() => 
        !_saving 
        && !string.IsNullOrWhiteSpace(_newPassword) 
        && _newPassword == _confirmPassword;

    private void OnStrengthChanged(PasswordStrengthInfoDto? result)
    {
        _strengthResult = result;
        StateHasChanged();
    }

    private async Task GenerarPassword()
    {
        if (_generating) return;
        _generating = true;
        try
        {
            var result = await Api.PostAsync<PasswordGenerationResultDto>("api/password/seguridad/generar",
                new { politicaId = _policy?.Id });
            if (result?.Success == true && !string.IsNullOrEmpty(result.Password))
            {
                _newPassword = result.Password;
                _confirmPassword = result.Password;
                _showPassword = true;
                Snackbar.Add("Contraseña generada", Severity.Success);
            }
            else
            {
                var err = result?.Errors?.FirstOrDefault() ?? "Error desconocido";
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task CambiarPassword()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("La nueva contraseña es obligatoria", Severity.Warning);
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Las contraseñas no coinciden", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var ok = await Api.PostVoidAsync($"api/usuarios/{UserId}/cambiar-password-admin", new
            {
                nuevaPassword = _newPassword
            });
            if (ok)
            {
                Snackbar.Add("Contraseña cambiada exitosamente", Severity.Success);
                _newPassword = "";
                _confirmPassword = "";
                _showPassword = false;
                _strengthResult = null;
                await HistoryChanged.InvokeAsync();
            }
            else
                Snackbar.Add(Api.LastError ?? "Error al cambiar la contraseña", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Api.LastError ?? $"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
