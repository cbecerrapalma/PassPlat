@page "/usuarios"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Navigation
@inject AuthService Auth
@using PassPlat.Web.Models
@using PassPlat.Web.Shared
@using PassPlat.Web.Pages.Usuarios.Components

@if (!Auth.TienePermiso("USUARIOS_VER"))
{
    <SinPermiso PermisoRequerido="USUARIOS_VER" />
}
else
{
<div class="iam-page">
<MigasDePan />

    <div class="page-header">
        <div class="page-title-row">
            <div>
                <h1 class="page-title">Usuarios</h1>
                <p class="page-subtitle">Gestión de identidades, accesos, roles y grupos de la plataforma.</p>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                Nuevo Usuario
            </MudButton>
        </div>
    </div>

    <div class="kpi-row mb-4">
        <IamKpiCard Valor="@_totalCount.ToString()" Label="Usuarios Totales" Icon="@Icons.Material.Filled.People" ColorClass="primary" />
        <IamKpiCard Valor="@_estados.Activos.ToString()" Label="Activos" Icon="@Icons.Material.Filled.CheckCircle" ColorClass="success" />
        <IamKpiCard Valor="@_estados.ConMFA.ToString()" Label="Con MFA" Subtexto="Autenticación de dos factores" Icon="@Icons.Material.Filled.Security" ColorClass="info" />
        <IamKpiCard Valor="@_estados.Bloqueados.ToString()" Label="Bloqueados" Icon="@Icons.Material.Filled.Block" ColorClass="warning" />
        <IamKpiCard Valor="@_estados.Pendientes.ToString()" Label="Sin Verificar" Icon="@Icons.Material.Filled.PendingActions" ColorClass="error" />
    </div>

    <div class="content-body">
        <div class="table-panel">
            <CrudToolbar ShowSearch="true"
                SearchString="@_searchString" SearchStringChanged="@OnSearchChanged"
                OnRefresh="@RefrescarTodo" ShowCreate="false">
                <Filtros>
                    @if (Auth.EsSistema)
                    {
                        <SelectorCatalogo T="TenantDto" Items="_tenants" Value="_tenantSel" ValueChanged="@OnTenantChanged"
                            SearchTextSelector="@(t => $"{t.Nombre} {t.Codigo}")"
                            ToStringFunc="@(t => t is null ? "" : $"{t.Nombre} ({t.Codigo})")"
                            Label="Tenant" Variant="Variant.Outlined" Class="lista-filtro" />
                    }
                    @if (_apps.Count > 0)
                    {
                        <SelectorCatalogo T="AppDto" Items="_apps" Value="_appSel" ValueChanged="@OnAppChanged"
                            SearchTextSelector="@(a => $"{a.Nombre} {a.Codigo}")"
                            ToStringFunc="@(a => a is null ? "" : $"{a.Nombre} ({a.Codigo})")"
                            Label="App" Variant="Variant.Outlined" Class="lista-filtro" />
                    }
                </Filtros>
            </CrudToolbar>
            <div class="table-wrap">
                <MudTable @ref="_table" T="UsuarioDto" ServerData="@_serverReload" Items="@_items" Hover="true" Breakpoint="Breakpoint.Sm"
                    RowStyle="cursor: pointer;" OnRowClick="@((TableRowClickEventArgs<UsuarioDto> e) => VerDetalle(e.Item))">
                    <ColGroup>
                        <col style="width: 60px;" /><col /><col /><col /><col /><col /><col /><col style="width: 100px;" /><col style="width: 60px;" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh></MudTh><MudTh>Usuario</MudTh><MudTh>Email</MudTh><MudTh>Tenant</MudTh><MudTh>Apps</MudTh><MudTh>Nombre</MudTh><MudTh>Apellido</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="row-avatar">
                                <MudText Typo="Typo.caption">@context.Nombre[..Math.Min(2, context.Nombre.Length)]</MudText>
                            </MudAvatar>
                        </MudTd>
                        <MudTd DataLabel="Usuario">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.NomUsuario</MudText>
                        </MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Tenant">@(string.IsNullOrWhiteSpace(context.TenantNombre) ? "—" : context.TenantNombre)</MudTd>
                        <MudTd DataLabel="Apps">
                            @if (context.Apps is { Count: > 0 })
                            {
                                @foreach (var codigo in context.Apps)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-1 mb-1">@codigo</MudChip>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                        <MudTd DataLabel="Apellido">@context.Apellido</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="badge @(!context.Eliminado ? "badge-active" : "badge-inactive")">
                                <span class="badge-dot"></span>@(!context.Eliminado ? "Activo" : "Eliminado")
                            </span>
                        </MudTd>
                        <MudTd>
                            <div @onclick:stopPropagation="true" class="table-actions">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Acciones de {context.NomUsuario}")">
                                    <MudMenuItem OnClick="@(() => VerDetalle(context))">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Class="mr-2" Color="Color.Info" />
                                        Ver detalle
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => OpenEditDialog(context))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />
                                        Editar
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ConfirmDelete(context))">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" Color="Color.Error" />
                                        Eliminar
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <div class="d-flex flex-column align-center py-6">
                            <MudAvatar Size="Size.Large" Color="Color.Default" Variant="Variant.Outlined" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" />
                            </MudAvatar>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Sin usuarios</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">No se encontraron usuarios en el sistema</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>
</div>
}

@code {
    private MudTable<UsuarioDto>? _table;
    private IEnumerable<UsuarioDto> _items = [];
    private string _searchString = "";
    private string _totalCount = "0";
    private UsuarioEstados _estados = new();
    private List<TenantDto> _tenants = [];
    private List<AppDto> _apps = [];
    private TenantDto? _tenantSel;
    private AppDto? _appSel;

    private async Task<TableData<UsuarioDto>> _serverReload(TableState state, CancellationToken ct)
    {
        try
        {
            var searchParam = string.IsNullOrEmpty(_searchString) ? "" : _searchString;
            var tenantParam = _tenantSel is null ? "" : $"&idTenant={_tenantSel.Id}";
            var appParam = _appSel is null ? "" : $"&idApp={_appSel.Id}";
            var response = await Api.GetAsync<PagedResponse<UsuarioDto>>(
                $"api/usuarios/page?pageNumber={state.Page + 1}&pageSize={state.PageSize}&search={Uri.EscapeDataString(searchParam)}{tenantParam}{appParam}");
            if (response != null)
            {
                _items = response.Items;
                return new TableData<UsuarioDto> { Items = response.Items, TotalItems = response.TotalCount };
            }
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar: {ex.Message}", Severity.Error); }
        return new TableData<UsuarioDto> { Items = [], TotalItems = 0 };
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.TienePermiso("USUARIOS_VER")) return;
        await CargarCatalogos();
        await CargarEstados();
    }

    // S90 · D1 — el selector de tenant solo existe para el usuario de sistema (claim is_system), como en la API.
    private async Task CargarCatalogos()
    {
        try
        {
            if (Auth.EsSistema)
                _tenants = await Api.GetAsync<List<TenantDto>>("api/tenants") ?? [];
            // S112 · D1 — sistema: catálogo de apps; admin de tenant: solo las apps de sus Accesos en su tenant.
            _apps = await AppsObjetivo.CargarAsync(Api, Auth);
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar catálogos: {ex.Message}", Severity.Error); }
    }

    private async Task OnTenantChanged(TenantDto? tenant)
    {
        _tenantSel = tenant;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task OnAppChanged(AppDto? app)
    {
        _appSel = app;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        // S58.1 · D2 — el buscador dispara su evento al inicializarse: si el valor
        // no cambia, no se recarga la tabla (evita pedir dos veces la misma página).
        if (value == _searchString) return;
        _searchString = value;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task RefrescarTodo()
    {
        if (_table is not null) await _table.ReloadServerData();
        await CargarEstados();
    }

    private async Task CargarEstados()
    {
        try
        {
            // S55 · U5 — el KPI y la tabla usan el mismo conjunto: la misma consulta paginada
            // que usa la tabla (antes el KPI contaba los usuarios del tenant y la tabla todos).
            var respuesta = await Api.GetAsync<PagedResponse<UsuarioDto>>("api/usuarios/page?pageNumber=1&pageSize=100");
            var todos = respuesta?.Items ?? [];
            _totalCount = (respuesta?.TotalCount ?? todos.Count).ToString();
            _estados = new UsuarioEstados
            {
                Activos = todos.Count(u => !u.Eliminado).ToString(),
                // S55 · U4 — la API no expone el estado de MFA por usuario: se muestra "—"
                // en lugar de un total que no corresponde (no se toca la API).
                ConMFA = "—",
                Bloqueados = todos.Count(u => u.EstadoNombre == "Bloqueado").ToString(),
                Pendientes = todos.Count(u => u.EstadoNombre == "Pendiente").ToString()
            };
        }
        catch (Exception ex) { Snackbar.Add(Api.LastError ?? $"Error al cargar conteos: {ex.Message}", Severity.Error); }
    }

    private void VerDetalle(UsuarioDto? usuario)
    {
        if (usuario is not null)
            Navigation.NavigateTo($"/usuario/{usuario.Id}");
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await Dialog.ShowAsync<UsuarioDialog>("Nuevo Usuario", OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false } && _table != null) { await _table.ReloadServerData(); await CargarEstados(); }
    }

    private async Task OpenEditDialog(UsuarioDto usuario)
    {
        var parameters = new DialogParameters { ["Usuario"] = usuario };
        var dialog = await Dialog.ShowAsync<UsuarioDialog>("Editar Usuario", parameters, OpcionesDialogo.Dialogo(TamanoDialogo.Estandar));
        var result = await dialog.Result;
        if (result is { Canceled: false } && _table != null) { await _table.ReloadServerData(); await CargarEstados(); }
    }

    private async Task ConfirmDelete(UsuarioDto usuario)
    {
        var parameters = new DialogParameters { ["Title"] = "Confirmar", ["Message"] = $"Eliminar usuario {usuario.NomUsuario}?", ["ConfirmText"] = "Si", ["CancelText"] = "Cancelar" };
        var dialog = await Dialog.ShowAsync<ConfirmDialog>("", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var ok = await Api.DeleteAsync($"api/usuarios/{usuario.Id}");
            if (ok) { Snackbar.Add("Usuario eliminado", Severity.Success); if (_table != null) await _table.ReloadServerData(); await CargarEstados(); }
            else Snackbar.Add(Api.LastError ?? "Error al eliminar", Severity.Error);
        }
    }

    private class UsuarioEstados
    {
        public string Activos { get; set; } = "0";
        public string ConMFA { get; set; } = "0";
        public string Bloqueados { get; set; } = "0";
        public string Pendientes { get; set; } = "0";
    }
}
