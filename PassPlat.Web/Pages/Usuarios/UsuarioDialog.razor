@inject ApiClient Api
@inject AuthService Auth
@inject ISnackbar Snackbar
@using PassPlat.Web.Models

<MudDialog Options="@OpcionesDialogo.Dialogo(TamanoDialogo.Estandar)" Class="dialogo-formulario">
    <TitleContent>
        <TituloDialogo Icono="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Texto="@(IsEdit ? "Editar Usuario" : "Nuevo Usuario")" />
    </TitleContent>
    <DialogContent>
        <AlertaErrorDialogo Mensaje="@_errorServidor" />
        <MudForm @ref="_form">
        <div class="usuario-dialog-columns">
            <div class="usuario-dialog-left dialogo-campos">
                <div class="dialogo-seccion">Detalle del usuario</div>
                <MudTextField @bind-Value="_nomUsuario" Label="Usuario" Variant="Variant.Outlined"
                              Disabled="@IsEdit" autocomplete="off" Required="true"
                              RequiredError="El usuario es requerido" />
                <MudTextField @bind-Value="_email" Label="Email (opcional)" Variant="Variant.Outlined" autocomplete="off"
                              Validation="@(new Func<string, string?>(v => !string.IsNullOrWhiteSpace(v) && !IsValidEmail(v) ? "Formato de email inválido" : null))" />
                <div class="dialogo-fila">
                    <MudTextField @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" autocomplete="off" Required="true"
                                  RequiredError="El nombre es requerido" />
                    <MudTextField @bind-Value="_apellido" Label="Apellido" Variant="Variant.Outlined" autocomplete="off" Required="true"
                                  RequiredError="El apellido es requerido" />
                </div>
                @if (!IsEdit)
                {
                    <div class="dialogo-seccion">Contraseña</div>
                    <div class="d-flex align-center gap-2">
                        <div class="d-flex align-center gap-2 flex-grow-1">
                            @if (_showPassword)
                            {
                                <MudTextField @bind-Value="_password" Label="Nueva contraseña" Variant="Variant.Outlined" Class="flex-grow-1"
                                              InputType="InputType.Text" Immediate="true" autocomplete="new-password"
                                              Error="@(!string.IsNullOrEmpty(_password) && _strengthResult != null && !_strengthResult.IsValid)"
                                              Validation="@(new Func<string, string?>(ValidarFortaleza))"
                                              OnKeyDown="@HandleKeyDown" />
                            }
                            else
                            {
                                <MudTextField @bind-Value="_password" Label="Nueva contraseña" Variant="Variant.Outlined" Class="flex-grow-1"
                                              InputType="InputType.Password" Immediate="true" autocomplete="new-password"
                                              Error="@(!string.IsNullOrEmpty(_password) && _strengthResult != null && !_strengthResult.IsValid)"
                                              Validation="@(new Func<string, string?>(ValidarFortaleza))"
                                              OnKeyDown="@HandleKeyDown" />
                            }
                            <MudIconButton Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Color="Color.Default" OnClick="@(() => _showPassword = !_showPassword)"
                                           Size="Size.Small" aria-label="Mostrar u ocultar contraseña" />
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary"
                                       title="Generar contraseña segura (Ctrl+G)" Disabled="@_generating"
                                       OnClick="@GenerarPassword" Size="Size.Small" aria-label="Generar" />
                    </div>
                    @if (_showPassword)
                    {
                        <MudTextField @bind-Value="_confirmPassword" Label="Confirmar contraseña" Variant="Variant.Outlined"
                                      InputType="InputType.Text" Immediate="true" autocomplete="new-password"
                                      Validation="@(new Func<string, string?>(ValidarConfirmacion))"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@GetConfirmIcon()"
                                      AdornmentColor="@GetConfirmColor()" />
                    }
                    else
                    {
                        <MudTextField @bind-Value="_confirmPassword" Label="Confirmar contraseña" Variant="Variant.Outlined"
                                      InputType="InputType.Password" Immediate="true" autocomplete="new-password"
                                      Validation="@(new Func<string, string?>(ValidarConfirmacion))"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@GetConfirmIcon()"
                                      AdornmentColor="@GetConfirmColor()" />
                    }
                }
            </div>
            @if (!IsEdit)
            {
                <div class="usuario-dialog-right dialogo-campos">
                    <div class="dialogo-seccion">Seguridad de contraseña</div>
                    @if (_policy != null)
                    {
                        <MudText Typo="Typo.caption" Class="font-weight-bold">Requisitos</MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @if (_policy.LongMin > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Mín. @_policy.LongMin car.</MudChip>
                            }
                            @if (_policy.ReqMayuscula)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Mayúscula</MudChip>
                            }
                            @if (_policy.ReqMinuscula)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Minúscula</MudChip>
                            }
                            @if (_policy.ReqNumero)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Número</MudChip>
                            }
                            @if (_policy.ReqEspecial)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Car. especial</MudChip>
                            }
                        </div>
                    }
                    <PasswordStrength Password="@_password" NomUsuario="@_nomUsuario" Email="@_email"
                                      OnStrengthChanged="@OnStrengthChanged" />
                </div>
            }
        </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <BotonGuardarDialogo Texto="@(IsEdit ? "Guardar" : "Crear")" Guardando="@_saving" OnClick="@Save" />
    </DialogActions>
</MudDialog>

<style>
    .usuario-dialog-columns {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }
    .usuario-dialog-left {
        flex: 7 1 300px;
        min-width: 0;
    }
    .usuario-dialog-right {
        flex: 5 1 260px;
        min-width: 0;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _errorServidor;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public UsuarioDto? Usuario { get; set; }

    private string _nomUsuario = "";
    private string _email = "";
    private string _nombre = "";
    private string _apellido = "";
    private string _password = "";
    private string _confirmPassword = "";
    private bool _saving;
    private bool _showPassword;
    private bool _generating;
    private MudForm _form = null!;
    private PoliticaPwdDto? _policy;
    private PasswordStrengthInfoDto? _strengthResult;

    protected override async Task OnInitializedAsync()
    {
        if (Usuario is not null)
        {
            _nomUsuario = Usuario.NomUsuario;
            _email = Usuario.Email ?? "";
            _nombre = Usuario.Nombre;
            _apellido = Usuario.Apellido;
        }
        _policy = await Api.GetAsync<PoliticaPwdDto>("api/usuarios/password-policy");
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "g" && args.CtrlKey)
            _ = GenerarPassword();
    }

    private async Task GenerarPassword()
    {
        if (_generating) return;
        _generating = true;
        try
        {
            var result = await Api.PostAsync<PasswordGenerationResultDto>("api/password/seguridad/generar",
                new { politicaId = _policy?.Id });
            if (result?.Success == true && !string.IsNullOrEmpty(result.Password))
            {
                _password = result.Password;
                _confirmPassword = result.Password;
                _showPassword = true;
                _errorServidor = null;
                Snackbar.Add("Contraseña generada", Severity.Success);
            }
            else
            {
                var err = result?.Errors?.FirstOrDefault() ?? "Error desconocido";
                _errorServidor = $"Error: {err}";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = $"Error: {ex.Message}";
        }
        finally
        {
            _generating = false;
        }
    }

    private void OnStrengthChanged(PasswordStrengthInfoDto? result)
    {
        _strengthResult = result;
        StateHasChanged();
    }

    private string? ValidarFortaleza(string valor) =>
        !string.IsNullOrEmpty(valor) && _strengthResult != null && !_strengthResult.IsValid
            ? "La contraseña no cumple los requisitos de seguridad"
            : null;

    private string? ValidarConfirmacion(string valor) =>
        _password != (valor ?? "") ? "Las contraseñas no coinciden" : null;

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return true;
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email && addr.Host.Contains('.');
        }
        catch
        {
            return false;
        }
    }

    private string GetConfirmIcon()
    {
        if (string.IsNullOrEmpty(_confirmPassword)) return Icons.Material.Filled.Lock;
        return _password == _confirmPassword
            ? Icons.Material.Filled.CheckCircle
            : Icons.Material.Filled.Cancel;
    }

    private Color GetConfirmColor()
    {
        if (string.IsNullOrEmpty(_confirmPassword)) return Color.Default;
        return _password == _confirmPassword ? Color.Success : Color.Error;
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        _saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await Api.PutVoidAsync("api/usuarios",
                    new { id = Usuario!.Id, nombre = _nombre, apellido = _apellido, email = string.IsNullOrWhiteSpace(_email) ? "" : _email });
                if (ok)
                {
                    Snackbar.Add("Usuario actualizado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al actualizar";
            }
            else
            {
                var result = await Api.PostAsync<UsuarioDto>("api/usuarios",
                    new { idTenant = Auth.IdTenant ?? 0, idEstado = 1, nomUsuario = _nomUsuario, email = string.IsNullOrWhiteSpace(_email) ? null : _email, nombre = _nombre, apellido = _apellido, password = string.IsNullOrWhiteSpace(_password) ? null : _password });
                if (result is not null)
                {
                    Snackbar.Add("Usuario creado", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                    _errorServidor = Api.LastError ?? "Error al crear";
            }
        }
        catch (Exception ex)
        {
            _errorServidor = $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
