@* S55 · D4 — tarjeta KPI compartida.
   - Sin subtexto redundante: el subtexto solo se pinta si el llamador lo usa con información útil.
   - Compacta: altura reducida y separación por la rejilla .kpi-row.
   S55.1 · K2 (D2) — la tarjeta no emite clases col-*: el contenedor .kpi-row es una
   rejilla CSS unica (2 columnas por debajo de 600 px, auto-fit a partir de 600 px) y es
   el unico que decide las columnas.
   S59 · K3 (D5) — se eliminan Xs/Sm/Md/Lg: notaban efecto y se pasaban en 41 sitios.
   S58 · K5 (D6) — con Href la tarjeta es un enlace real a su lista. *@
@if (string.IsNullOrEmpty(Href))
{
    <div style="@Style" @onclick="OnClick" role="button">
        @Tarjeta
    </div>
}
else
{
    <a href="@Href" class="iam-kpi-link" style="@Style">
        @Tarjeta
    </a>
}

@code {
    private RenderFragment Tarjeta => @<MudPaper Class="pa-3 pa-md-4 d-flex align-center gap-3 iam-kpi-card" Elevation="0" Outlined="true">
        <MudAvatar Color="@_avatarColor" Variant="Variant.Filled" Size="Size.Medium">
            <MudIcon Icon="@Icon" Size="Size.Small" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">@Valor</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Label</MudText>
            @if (!string.IsNullOrEmpty(Subtexto))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtexto</MudText>
            }
        </div>
    </MudPaper>;

    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Subtexto { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Circle;
    [Parameter] public string ColorClass { get; set; } = "primary";
    // S59 · K3 (D5) — sin Xs/Sm/Md/Lg: el ancho lo decide la rejilla .kpi-row.
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    // S58 · K5 (D6) — enlace a la lista de la tarjeta.
    [Parameter] public string? Href { get; set; }

    private Color _avatarColor => ColorClass switch
    {
        "primary" => Color.Primary,
        "success" => Color.Success,
        "secondary" => Color.Secondary,
        "warning" => Color.Warning,
        "info" => Color.Info,
        "error" => Color.Error,
        _ => Color.Primary
    };
}
