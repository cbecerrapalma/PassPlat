<div Class="@($"col-xs-{Xs} col-sm-{Sm} col-md-{Md} {(Lg.HasValue ? $"col-lg-{Lg}" : "")}")" style="@Style" @onclick="OnClick" role="button">
    <MudPaper Class="pa-4 d-flex align-center" Elevation="0" Outlined="true" style="gap:12px;">
        <MudAvatar Color="@_avatarColor" Variant="Variant.Filled" Size="Size.Medium">
            <MudIcon Icon="@Icon" Size="Size.Small" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">@Valor</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Label</MudText>
            @if (!string.IsNullOrEmpty(Subtexto))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtexto</MudText>
            }
        </div>
    </MudPaper>
</div>

@code {
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Subtexto { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Circle;
    [Parameter] public string ColorClass { get; set; } = "primary";
    [Parameter] public int Xs { get; set; } = 12;
    [Parameter] public int Sm { get; set; } = 6;
    [Parameter] public int Md { get; set; } = 4;
    [Parameter] public int? Lg { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    private Color _avatarColor => ColorClass switch
    {
        "primary" => Color.Primary,
        "success" => Color.Success,
        "secondary" => Color.Secondary,
        "warning" => Color.Warning,
        "info" => Color.Info,
        "error" => Color.Error,
        _ => Color.Primary
    };
}
