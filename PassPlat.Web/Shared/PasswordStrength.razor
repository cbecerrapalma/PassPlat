@inject ApiClient Api

@if (_policy is null)
{
    <MudSkeleton Width="100%" Height="20px" />
}
else if (!string.IsNullOrEmpty(Password))
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3" Style="border-radius: 8px;">
        @* Strength bar *@
        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.caption" Class="flex-grow-1">Fortaleza</MudText>
            @if (_isLoading)
            {
                <MudText Typo="Typo.caption" Class="text-secondary d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="spin" />
                    Analizando...
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="@GetLevelClass()">
                    <MudIcon Icon="@GetLevelIcon()" Size="Size.Small" Class="mr-1" />
                    @_strength?.Level
                </MudText>
            }
        </div>

        <MudProgressLinear Value="@(_strength?.Score ?? 0)" Max="100"
                           Color="@GetBarColor()" Size="Size.Small" Class="mb-3" />

        @* Requirements checklist grouped *@
        @if (_requirements.Length > 0)
        {
            <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Requisitos</MudText>
            <div class="requirement-grid mb-2">
                @foreach (var req in _requirements)
                {
                    <div class="requirement-item @(req.Met ? "met" : "unmet")">
                        <MudIcon Icon="@(req.Met ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                 Size="Size.Small" Class="req-icon" />
                        @req.Label
                    </div>
                }
            </div>
        }

        @* Character breakdown *@
        @if (_strength is not null)
        {
            <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Composición</MudText>
            <div class="d-flex gap-3 mb-2 flex-wrap">
                <MudChip T="string" Size="Size.Small" Color="@(_strength.HasUppercase ? Color.Primary : Color.Default)"
                         Variant="@(_strength.HasUppercase ? Variant.Filled : Variant.Outlined)">
                    @("A-Z (" + CountUpper(Password) + ")")
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="@(_strength.HasLowercase ? Color.Primary : Color.Default)"
                         Variant="@(_strength.HasLowercase ? Variant.Filled : Variant.Outlined)">
                    @("a-z (" + CountLower(Password) + ")")
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="@(_strength.HasNumbers ? Color.Primary : Color.Default)"
                         Variant="@(_strength.HasNumbers ? Variant.Filled : Variant.Outlined)">
                    @("0-9 (" + CountDigits(Password) + ")")
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="@(_strength.HasSpecialCharacters ? Color.Primary : Color.Default)"
                         Variant="@(_strength.HasSpecialCharacters ? Variant.Filled : Variant.Outlined)">
                    @("!@@# (" + CountSpecial(Password) + ")")
                </MudChip>
            </div>

            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.caption">Longitud:</MudText>
                <MudText Typo="Typo.caption" Class="font-weight-bold">@Password.Length</MudText>
                @if (_policy?.LongMax > 0 && Password.Length > _policy.LongMax)
                {
                    <MudText Typo="Typo.caption" Class="error-text">
                        (máx. @_policy.LongMax)
                    </MudText>
                }
            </div>
        }

        @* Warnings *@
        @if (_strength?.Warnings?.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1" Variant="Variant.Outlined">
                @foreach (var w in _strength.Warnings)
                {
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
                        @w
                    </div>
                }
            </MudAlert>
        }

        @* Errors *@
        @if (_strength?.Errors?.Count > 0 && !_strength.IsValid)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="my-1" Variant="Variant.Outlined">
                @foreach (var e in _strength.Errors)
                {
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" />
                        @e
                    </div>
                }
            </MudAlert>
        }
    </MudPaper>
}

<style>
    .requirement-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 16px;
    }
    .requirement-item {
        font-size: 0.75rem;
        line-height: 1.6;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .requirement-item.met {
        color: var(--mud-palette-success, #4caf50);
    }
    .requirement-item.unmet {
        color: var(--mud-palette-text-disabled, #9e9e9e);
    }
    .requirement-item .req-icon {
        font-size: 14px;
    }
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .spin {
        animation: spin 1s linear infinite;
    }
</style>

@code {
    private PoliticaPwdDto? _policy;
    private PasswordStrengthInfoDto? _strength;
    private string _previousPassword = "";
    private CancellationTokenSource? _debounceCts;
    private bool _isLoading;

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string? NomUsuario { get; set; }
    [Parameter] public string? Email { get; set; }
    [Parameter] public EventCallback<PasswordStrengthInfoDto?> OnStrengthChanged { get; set; }

    private record Requirement(string Label, bool Met);

    private Requirement[] _requirements = [];

    protected override async Task OnInitializedAsync()
    {
        _policy = await Api.GetAsync<PoliticaPwdDto>("api/usuarios/password-policy");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Password == _previousPassword) return;
        _previousPassword = Password;

        _debounceCts?.Cancel();
        if (string.IsNullOrEmpty(Password))
        {
            _strength = null;
            _requirements = [];
            await OnStrengthChanged.InvokeAsync(null);
            return;
        }

        _isLoading = true;
        UpdateRequirementsLocal();
        _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, _debounceCts.Token);
            await ValidateAsync(_debounceCts.Token);
        }
        catch (TaskCanceledException) { }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ValidateAsync(CancellationToken ct)
    {
        var result = await Api.PostAsync<PasswordStrengthInfoDto>("api/usuarios/validar-password",
            new ValidarPasswordRequestDto
            {
                Password = Password,
                NomUsuario = NomUsuario,
                Email = Email
            });

        if (!ct.IsCancellationRequested)
        {
            _strength = result;
            BuildRequirements();
            StateHasChanged();
            await OnStrengthChanged.InvokeAsync(result);
        }
    }

    private void UpdateRequirementsLocal()
    {
        if (_policy is null) { _requirements = []; return; }
        var list = new List<Requirement>();
        if (_policy.LongMin > 0)
            list.Add(new($"Mín. {_policy.LongMin} car.", Password.Length >= _policy.LongMin));
        if (_policy.ReqMayuscula)
            list.Add(new("Mayúscula", Password.Any(char.IsUpper)));
        if (_policy.ReqMinuscula)
            list.Add(new("Minúscula", Password.Any(char.IsLower)));
        if (_policy.ReqNumero)
            list.Add(new("Número", Password.Any(char.IsDigit)));
        if (_policy.ReqEspecial)
            list.Add(new("Car. especial", Password.Any(c => !char.IsLetterOrDigit(c))));
        if (_policy.ProhPwdComun)
            list.Add(new("No común", false));
        if (_policy.ProhSecuenciales)
            list.Add(new("Sin secuencias", false));
        if (_policy.ProhRepetitivos)
            list.Add(new("Sin repeticiones", false));
        if (_policy.ProhInfoUsuario)
            list.Add(new("Sin datos personales", false));
        _requirements = list.ToArray();
    }

    private void BuildRequirements()
    {
        if (_policy is null || _strength is null) { _requirements = []; return; }
        var list = new List<Requirement>();
        if (_policy.LongMin > 0)
            list.Add(new($"Mín. {_policy.LongMin} car.", Password.Length >= _policy.LongMin));
        if (_policy.ReqMayuscula)
            list.Add(new("Mayúscula", _strength.HasUppercase));
        if (_policy.ReqMinuscula)
            list.Add(new("Minúscula", _strength.HasLowercase));
        if (_policy.ReqNumero)
            list.Add(new("Número", _strength.HasNumbers));
        if (_policy.ReqEspecial)
            list.Add(new("Car. especial", _strength.HasSpecialCharacters));
        if (_policy.ProhPwdComun)
            list.Add(new("No común", !_strength.IsCommon));
        if (_policy.ProhSecuenciales)
            list.Add(new("Sin secuencias", !_strength.HasSequentialChars));
        if (_policy.ProhRepetitivos)
            list.Add(new("Sin repeticiones", !_strength.HasRepeatingChars));
        if (_policy.ProhInfoUsuario)
            list.Add(new("Sin datos personales", !_strength.ContainsUserInfo));
        _requirements = list.ToArray();
    }

    private static int CountUpper(string s) => s.Count(char.IsUpper);
    private static int CountLower(string s) => s.Count(char.IsLower);
    private static int CountDigits(string s) => s.Count(char.IsDigit);
    private static int CountSpecial(string s) => s.Count(c => !char.IsLetterOrDigit(c));

    private Color GetBarColor() => (_strength?.Score) switch
    {
        < 20 => Color.Error,
        < 40 => Color.Warning,
        < 60 => Color.Info,
        < 80 => Color.Primary,
        _ => Color.Success
    };

    private string GetLevelClass() => (_strength?.Score) switch
    {
        < 20 => "error-text",
        < 40 => "warning-text",
        < 60 => "info-text",
        < 80 => "primary-text",
        _ => "success-text"
    };

    private string GetLevelIcon() => (_strength?.Score) switch
    {
        < 20 => Icons.Material.Filled.Dangerous,
        < 40 => Icons.Material.Filled.ErrorOutline,
        < 60 => Icons.Material.Filled.Info,
        < 80 => Icons.Material.Filled.CheckCircleOutline,
        _ => Icons.Material.Filled.CheckCircle
    };
}