{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/passplat-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId" ]
  },
"Cbp": {
    "Logging": {
      "EnrichWithHttpContext": true,
      "IncludeHeaders": false,
      "IncludeClaims": false,
      "SqlSlowQueryThresholdMs": 250,
      "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
    }
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "PassPlat",
    "Audience": "PassPlat",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationMinutes": 1440
  },
  "Encryption": {
    "Key": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PassPlatDb": ""
  },
  "PasswordExpiration": {
    "Enabled": true,
    "CheckIntervalHours": 24,
    "WarningDays": [15, 7, 3, 1]
  },
  "Mfa": {
    "TiempoValidezCodigoMFA": 5,
    "LongitudCodigoMFA": 6
  },
  "Outbox": {
    "PollIntervalSeconds": 15,
    "BatchSize": 100,
    "MaxRetries": 3,
    "RetryDelayMinutes": [1, 5, 15],
    "ProcessingTimeoutSeconds": 300
  }
}

