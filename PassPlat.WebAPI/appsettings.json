{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/passplat-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ]
  },
  "Cbp": {
    "Logging": {
      "EnrichWithHttpContext": true,
      "IncludeHeaders": false,
      "IncludeClaims": false,
      "SqlSlowQueryThresholdMs": 250,
      "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
    }
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "PassPlat",
    "Audience": "PassPlat",
    "AudienceInventa": "InventaNet",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationMinutes": 1440
  },
  "Encryption": {
    "Key": ""
  },
  "RateLimiting": {
    "ClientesConfiables": [],
    "Politicas": {
      "LoginPolicy": {
        "Particion": "ip",
        "Tipo": "fija",
        "PermitLimit": 10,
        "PermitLimitConfiable": 120,
        "WindowSeconds": 60,
        "TopeGlobal": 600
      },
      "AuthReadPolicy": {
        "Particion": "usuario",
        "Tipo": "fija",
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "RefreshPolicy": {
        "Particion": "ip",
        "Tipo": "deslizante",
        "PermitLimit": 30,
        "PermitLimitConfiable": 300,
        "WindowSeconds": 60,
        "Segments": 6
      },
      "PasswordPolicy": {
        "Particion": "usuario",
        "Tipo": "fija",
        "PermitLimit": 5,
        "WindowSeconds": 300
      },
      "MFAPolicy": {
        "Particion": "usuario",
        "Tipo": "fija",
        "PermitLimit": 10,
        "PermitLimitAnonimo": 5,
        "WindowSeconds": 60,
        "TopeGlobal": 100
      },
      "TokenPolicy": {
        "Particion": "usuario",
        "Tipo": "fija",
        "PermitLimit": 10,
        "WindowSeconds": 900,
        "TopeGlobal": 200
      },
      "PurgePolicy": {
        "Particion": "global",
        "Tipo": "fija",
        "PermitLimit": 1,
        "WindowSeconds": 3600
      },
      "EmailApiPolicy": {
        "Particion": "usuario",
        "Tipo": "deslizante",
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "Segments": 6
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PassPlatDb": ""
  },
  "PasswordExpiration": {
    "Enabled": true,
    "CheckIntervalHours": 24,
    "WarningDays": [
      15,
      7,
      3,
      1
    ]
  },
  "Mfa": {
    "TiempoValidezCodigoMFA": 5,
    "LongitudCodigoMFA": 6
  },
  "Outbox": {
    "PollIntervalSeconds": 15,
    "BatchSize": 100,
    "MaxRetries": 3,
    "RetryDelayMinutes": [
      1,
      5,
      15
    ],
    "ProcessingTimeoutSeconds": 300
  }
}
