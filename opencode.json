        "DOTNET_SOLUTION_PATH": "D:\\CODIGOS\\PassPlat\\PassPlat.slnx"
      },
      "timeout": 30000
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "D:\\CODIGOS\\PassPlat", "D:\\CODIGOS\\BBDD", "D:\\CODIGOS\\CBP"],
